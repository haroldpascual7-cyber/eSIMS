<!--
    Fluent type ramp — Windows 11 published sizes (effective pixels).
    Semibold replaces Bold everywhere; italic is not part of the ramp; sentence
    case only (no ALL-CAPS labels, no Title Case headings).
    Apply a style instead of setting FontSize inline: inline sizes were the main
    source of the pre-refactor inconsistency (25 distinct values from 7.5 to 46).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="TextDisplay" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyDisplay}"/>
        <Setter Property="FontSize" Value="{DynamicResource TypeDisplay}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="{DynamicResource LineTitleLarge}"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="TextTitleLarge" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyDisplay}"/>
        <Setter Property="FontSize" Value="{DynamicResource TypeTitleLarge}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="{DynamicResource LineTitleLarge}"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    </Style>

    <Style x:Key="TextTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyDisplay}"/>
        <Setter Property="FontSize" Value="{DynamicResource TypeTitle}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="{DynamicResource LineTitle}"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="TextSubtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyDisplay}"/>
        <Setter Property="FontSize" Value="{DynamicResource TypeSubtitle}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="{DynamicResource LineSubtitle}"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    </Style>

    <Style x:Key="TextBodyLargeStrong" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyText}"/>
        <Setter Property="FontSize" Value="{DynamicResource TypeBodyLarge}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    </Style>

    <Style x:Key="TextBodyLarge" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyText}"/>
        <Setter Property="FontSize" Value="{DynamicResource TypeBodyLarge}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    </Style>

    <Style x:Key="TextBodyStrong" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyText}"/>
        <Setter Property="FontSize" Value="{DynamicResource TypeBody}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="{DynamicResource LineBody}"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    </Style>

    <Style x:Key="TextBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyText}"/>
        <Setter Property="FontSize" Value="{DynamicResource TypeBody}"/>
        <Setter Property="LineHeight" Value="{DynamicResource LineBody}"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    </Style>

    <Style x:Key="TextSecondary" TargetType="TextBlock" BasedOn="{StaticResource TextBody}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
    </Style>

    <Style x:Key="TextCaption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyText}"/>
        <Setter Property="FontSize" Value="{DynamicResource TypeCaption}"/>
        <Setter Property="LineHeight" Value="{DynamicResource LineCaption}"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
    </Style>

    <Style x:Key="TextCaptionStrong" TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    </Style>

    <!-- Metric / KPI numerals: tabular figures so columns line up. -->
    <Style x:Key="TextMetric" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyNumeric}"/>
        <Setter Property="FontSize" Value="{DynamicResource TypeTitle}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="{DynamicResource LineTitle}"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        <Setter Property="TextTrimming" Value="None"/>
    </Style>

    <Style x:Key="TextMetricSm" TargetType="TextBlock" BasedOn="{StaticResource TextMetric}">
        <Setter Property="FontSize" Value="{DynamicResource TypeSubtitle}"/>
        <Setter Property="LineHeight" Value="{DynamicResource LineSubtitle}"/>
    </Style>

    <Style x:Key="TextMetricMd" TargetType="TextBlock" BasedOn="{StaticResource TextMetric}">
        <Setter Property="FontSize" Value="{DynamicResource TypeTitle}"/>
        <Setter Property="LineHeight" Value="{DynamicResource LineTitle}"/>
    </Style>

    <Style x:Key="TextMono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}"/>
        <Setter Property="FontSize" Value="{DynamicResource TypeCaption}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
    </Style>

    <Style x:Key="TextFieldLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyText}"/>
        <Setter Property="FontSize" Value="{DynamicResource TypeCaption}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <!-- Form-section / card header label: 14 semibold, no description paragraph. -->
    <Style x:Key="TextCardHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyText}"/>
        <Setter Property="FontSize" Value="{DynamicResource TypeBody}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="TextLink" TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
        <Setter Property="TextDecorations" Value="{x:Null}"/>
    </Style>

</ResourceDictionary>
