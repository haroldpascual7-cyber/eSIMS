    <!-- ===================== icon presentation styles ====================== -->
    <Style x:Key="IconStyle" TargetType="Path">
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Fill" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="IconSmStyle" TargetType="Path" BasedOn="{StaticResource IconStyle}">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
    </Style>

    <Style x:Key="IconLgStyle" TargetType="Path" BasedOn="{StaticResource IconStyle}">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
    </Style>

    <Style x:Key="IconSecondaryStyle" TargetType="Path" BasedOn="{StaticResource IconStyle}">
        <Setter Property="Fill" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
    </Style>

    <Style x:Key="IconAccentStyle" TargetType="Path" BasedOn="{StaticResource IconStyle}">
        <Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
    </Style>

</ResourceDictionary>
