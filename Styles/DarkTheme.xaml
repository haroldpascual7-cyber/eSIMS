    <SolidColorBrush x:Key="SeverityCriticalBrush" Color="#FF99A4"/>
    <SolidColorBrush x:Key="SeverityHighBrush" Color="#FFC38A"/>
    <SolidColorBrush x:Key="SeverityMediumBrush" Color="#FCE100"/>
    <SolidColorBrush x:Key="SeverityLowBrush" Color="#6CCB5F"/>
