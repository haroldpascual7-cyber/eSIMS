<!--
    CoreStyles — aggregate entry point merged by App.xaml.

    Structure:
      1. Fluent token consumers: icons, type ramp, controls, surfaces.
      2. Converters.
      3. Legacy compatibility layer: every pre-refactor key name still resolves,
         re-pointed at the Fluent equivalents so untouched views adopt the new
         visual language without editing them individually.

    Edit the Fluent* dictionaries, not this file, when changing the design system.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:SmartSchoolIncidentManagementSystem.Converters">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="FluentIcons.xaml"/>
        <ResourceDictionary Source="FluentType.xaml"/>
        <ResourceDictionary Source="FluentControls.xaml"/>
        <ResourceDictionary Source="FluentSurfaces.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ============================== BASE ================================= -->
    <FontFamily x:Key="MainFont">Segoe UI Variable Text, Segoe UI, Tahoma, sans-serif</FontFamily>

    <!-- ============================ CONVERTERS ============================= -->
    <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    <conv:BoolToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
    <conv:BoolToGreenRedConverter x:Key="BoolToGreenRed"/>
    <conv:RoleVisibilityConverter x:Key="RoleToVis"/>

    <!-- ======================= LEGACY TEXT STYLES ========================== -->
    <Style x:Key="CellText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyText}"/>
        <Setter Property="FontSize" Value="{DynamicResource TypeBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- ======================= LEGACY BUTTON STYLES ======================== -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}"/>
    <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource StandardButtonStyle}"/>
    <Style x:Key="SidebarActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}"/>
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}"/>

    <!-- ===================== LEGACY SIDEBAR NAV (RadioButton) ============== -->
    <Style x:Key="NavButtonStyle" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyText}"/>
        <Setter Property="FontSize" Value="{DynamicResource TypeBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="GroupName" Value="SidebarNavGroup"/>
        <Setter Property="Height" Value="{DynamicResource NavItemHeight}"/>
        <Setter Property="Margin" Value="4,1"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FluentFocusVisualStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource CornerRadiusControl}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <Border x:Name="Indicator" Width="3" HorizontalAlignment="Left" Margin="0,6" CornerRadius="2"
                                Background="Transparent"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSubtleFillBrush}"/>
                            <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================= LEGACY INPUT STYLES ========================= -->
    <Style x:Key="ModernTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource FluentTextBoxStyle}"/>
    <Style x:Key="ModernComboBoxItemStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource FluentComboBoxItemStyle}"/>
    <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource FluentComboBoxStyle}"/>
    <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{DynamicResource CornerRadiusControl}" SnapsToDevicePixels="True">
            <Path x:Name="Chevron" Data="{DynamicResource Icon.ChevronDown}" Stretch="Uniform"
                  Width="10" Height="10" Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                  Fill="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- ========================== DATE PICKER ============================== -->
    <Style TargetType="DatePickerTextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ModernDatePickerStyle" TargetType="DatePicker">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyText}"/>
        <Setter Property="FontSize" Value="{DynamicResource TypeBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="{DynamicResource ControlHeightDefault}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FluentFocusVisualStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource CornerRadiusControl}" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="32"/>
                            </Grid.ColumnDefinitions>
                            <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0" Margin="2,0,0,0"
                                               HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                                               Focusable="{TemplateBinding Focusable}"/>
                            <Button x:Name="PART_Button" Grid.Column="1" Focusable="False"
                                    Style="{StaticResource SubtleButtonStyle}" Width="28" Height="28" Padding="0" Margin="2,0,2,0">
                                <Path Data="{StaticResource Icon.Calendar}" Style="{StaticResource IconStyle}" Width="14" Height="14"
                                      Fill="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </Button>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" StaysOpen="False">
                                <Border Background="{DynamicResource FlyoutBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        CornerRadius="{DynamicResource CornerRadiusSurface}" Margin="0,4,0,0" Padding="4">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="{DynamicResource ShadowOpacityFlyout}" BlurRadius="16" ShadowDepth="3" Direction="270"/>
                                    </Border.Effect>
                                    <Calendar x:Name="PART_Calendar" Background="Transparent" BorderThickness="0"
                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlFillColorDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="DatePicker" BasedOn="{StaticResource ModernDatePickerStyle}"/>

    <Style TargetType="Calendar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyText}"/>
        <Setter Property="FontSize" Value="{DynamicResource TypeCaption}"/>
    </Style>
    <Style TargetType="CalendarItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style TargetType="CalendarDayButton">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="{DynamicResource TypeCaption}"/>
        <Setter Property="MinWidth" Value="30"/>
        <Setter Property="MinHeight" Value="30"/>
    </Style>
    <Style TargetType="CalendarButton">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- ======================= LEGACY CARD STYLES ========================== -->
    <Style x:Key="CardBorderStyle" TargetType="Border" BasedOn="{StaticResource CardSolidStyle}"/>
    <Style x:Key="RecordCardStyle" TargetType="Border" BasedOn="{StaticResource CardInteractiveStyle}"/>

    <!-- ==================== LEGACY MISC CONTROL STYLES ===================== -->
    <Style x:Key="ModernGroupBoxStyle" TargetType="GroupBox">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource TypeCaption}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/>
        <Setter Property="ShowsPreview" Value="True"/>
    </Style>

</ResourceDictionary>
