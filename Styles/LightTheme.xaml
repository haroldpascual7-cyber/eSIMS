<!--
    eSIMS Design Tokens — Windows 11 Fluent (Light)
    ===========================================================================
    Translation of the iOS 27 Liquid Glass system to the Windows target:
    glass is NOT reproduced per-element on desktop. The window backdrop carries
    Mica/Acrylic (see Services/BackdropService.cs); every surface above it uses
    WinUI layer-fill / card-fill tokens. Radii 4/8, 32px control height, Segoe UI
    Variable ramp, Fluent motion curves.

    Token names mirror WinUI 3 theme resources where a WinUI equivalent exists.
    Legacy key names (PrimaryBrush, CardBackgroundBrush, ...) are kept as aliases
    at the bottom of this file so existing views keep resolving.

    Type ramp, radii and motion values: Windows 11 published values (Microsoft
    Learn). Accent values are the WinUI fallback; the live user accent is
    injected at runtime by Services/SystemAccentProvider.cs.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============================= TYPOGRAPHY ============================= -->
    <FontFamily x:Key="FontFamilyText">Segoe UI Variable Text, Segoe UI, Tahoma, sans-serif</FontFamily>
    <FontFamily x:Key="FontFamilyDisplay">Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI, Tahoma</FontFamily>
    <FontFamily x:Key="FontFamilyNumeric">Segoe UI Variable Text, Segoe UI, Tahoma, sans-serif</FontFamily>
    <FontFamily x:Key="FontFamilyMono">Cascadia Mono, Consolas, Courier New, monospace</FontFamily>

    <!-- Windows 11 type ramp. Semibold replaces Bold; italic is not part of the ramp. -->
    <sys:Double x:Key="TypeCaption">12</sys:Double>
    <sys:Double x:Key="TypeBody">14</sys:Double>
    <sys:Double x:Key="TypeBodyLarge">18</sys:Double>
    <sys:Double x:Key="TypeSubtitle">20</sys:Double>
    <sys:Double x:Key="TypeTitle">28</sys:Double>
    <sys:Double x:Key="TypeTitleLarge">40</sys:Double>
    <sys:Double x:Key="TypeDisplay">68</sys:Double>
    <sys:Double x:Key="LineCaption">16</sys:Double>
    <sys:Double x:Key="LineBody">20</sys:Double>
    <sys:Double x:Key="LineBodyLarge">24</sys:Double>
    <sys:Double x:Key="LineSubtitle">28</sys:Double>
    <sys:Double x:Key="LineTitle">36</sys:Double>
    <sys:Double x:Key="LineTitleLarge">52</sys:Double>

    <!-- ============================== METRICS =============================== -->
    <!-- 4px grid. Control heights are effective pixels (epx). -->
    <sys:Double x:Key="Space1">4</sys:Double>
    <sys:Double x:Key="Space2">8</sys:Double>
    <sys:Double x:Key="Space3">12</sys:Double>
    <sys:Double x:Key="Space4">16</sys:Double>
    <sys:Double x:Key="Space6">24</sys:Double>
    <sys:Double x:Key="Space8">32</sys:Double>

    <sys:Double x:Key="ControlHeightDefault">32</sys:Double>
    <sys:Double x:Key="ControlHeightCompact">24</sys:Double>
    <sys:Double x:Key="ControlHeightTouch">40</sys:Double>
    <sys:Double x:Key="TitleBarHeight">32</sys:Double>
    <sys:Double x:Key="CommandBarHeight">44</sys:Double>
    <sys:Double x:Key="PageHeaderHeight">64</sys:Double>
    <sys:Double x:Key="DataRowHeight">32</sys:Double>
    <sys:Double x:Key="ListRowHeight">44</sys:Double>
    <sys:Double x:Key="NavPaneWidth">264</sys:Double>
    <sys:Double x:Key="NavPaneWidthCompact">48</sys:Double>
    <sys:Double x:Key="NavItemHeight">36</sys:Double>

    <sys:Double x:Key="IconSizeSm">12</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double>
    <sys:Double x:Key="IconSizeLg">20</sys:Double>
    <sys:Double x:Key="IconSizeXl">24</sys:Double>

    <CornerRadius x:Key="CornerRadiusControl">4</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSurface">8</CornerRadius>
    <CornerRadius x:Key="CornerRadiusOverlay">8</CornerRadius>
    <CornerRadius x:Key="CornerRadiusBar">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusPill">999</CornerRadius>

    <Thickness x:Key="PaddingControl">12,0</Thickness>
    <Thickness x:Key="PaddingCard">16</Thickness>
    <Thickness x:Key="PaddingPage">24</Thickness>
    <Thickness x:Key="PaddingNavItem">10,0</Thickness>

    <sys:Double x:Key="StrokeThin">1</sys:Double>
    <sys:Double x:Key="StrokeFocus">2</sys:Double>
    <sys:Double x:Key="OpacityDisabled">0.36</sys:Double>
    <sys:Double x:Key="OpacitySecondaryText">0.7</sys:Double>

    <!-- ============================== MOTION ================================ -->
    <!-- Fluent durations (ms) and control curves; no overshoot / bounce. -->
    <Duration x:Key="DurationFast">0:0:0.167</Duration>
    <Duration x:Key="DurationNormal">0:0:0.25</Duration>
    <Duration x:Key="DurationSlow">0:0:0.333</Duration>
    <Duration x:Key="DurationGentle">0:0:0.5</Duration>
    <KeySpline x:Key="CurveFastOutSlowIn">0.1,0.9,0.2,1</KeySpline>
    <KeySpline x:Key="CurveEasyEase">0.33,0,0.67,1</KeySpline>
    <KeySpline x:Key="CurveDecelerate">0.1,0.9,0.2,1</KeySpline>
    <KeySpline x:Key="CurveAccelerate">0.7,0,1,0.5</KeySpline>

    <!-- ============================== ACCENT ================================ -->
    <!-- Fallback only: SystemAccentProvider replaces AccentFill* at startup. -->
    <Color x:Key="AccentColor">#005FB8</Color>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#005FB8"/>
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#146CC0"/>
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#0A57A0"/>
    <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#C9C9C9"/>
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#D6D6D6"/>
    <SolidColorBrush x:Key="AccentSubtleFillBrush" Color="#16005FB8"/>
    <SolidColorBrush x:Key="AccentStrokeBrush" Color="#2E005FB8"/>

    <!-- ============================= SURFACES =============================== -->
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#F9F9F9"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="LayerOnAcrylicFillColorDefaultBrush" Color="#40FFFFFF"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#80F6F6F6"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorSolidBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackgroundBrush" Color="#66F9F9F9"/>
    <SolidColorBrush x:Key="NavigationViewContentBackgroundBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="FlyoutBackgroundBrush" Color="#F9F9F9"/>
    <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#F9F9F9"/>
    <SolidColorBrush x:Key="LayeredTitleBarBrush" Color="#66F3F3F3"/>
    <SolidColorBrush x:Key="SmokeFillColorDefaultBrush" Color="#4D000000"/>
    <SolidColorBrush x:Key="TintFillColorBrush" Color="#F3F3F3"/>

    <!-- =============================== TEXT ================================= -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#5D5D5D"/>
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#B5B5B5"/>
    <SolidColorBrush x:Key="TextFillColorInverseBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="#7FFFFFFF"/>

    <!-- ============================== STROKES =============================== -->
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#D6D6D6"/>
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#A6A6A6"/>
    <SolidColorBrush x:Key="ControlStrokeColorTertiaryBrush" Color="#4D000000"/>
    <SolidColorBrush x:Key="ControlStrokeColorOnAccentDefaultBrush" Color="#0F000000"/>
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#80F9F9F9"/>
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#4DF9F9F9"/>
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#4DF9F9F9"/>
    <SolidColorBrush x:Key="ControlFillColorTransparentBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#09000000"/>
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#06000000"/>
    <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="FocusStrokeColorInnerBrush" Color="#FFFFFF"/>

    <!-- ========================== STATUS / SEMANTIC ========================= -->
    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#0F7B0F"/>
    <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush" Color="#DFF6DD"/>
    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#9D5D00"/>
    <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush" Color="#FFF4CE"/>
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#C42B1C"/>
    <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#FDE7E9"/>
    <SolidColorBrush x:Key="SystemFillColorNeutralBrush" Color="#5D5D5D"/>
    <SolidColorBrush x:Key="SystemFillColorNeutralBackgroundBrush" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="#005FB8"/>
    <SolidColorBrush x:Key="SystemFillColorAttentionBackgroundBrush" Color="#E5F1FB"/>

    <SolidColorBrush x:Key="SeverityCriticalBrush" Color="#C42B1C"/>
    <SolidColorBrush x:Key="SeverityHighBrush" Color="#8E562E"/>
    <SolidColorBrush x:Key="SeverityMediumBrush" Color="#9D5D00"/>
    <SolidColorBrush x:Key="SeverityLowBrush" Color="#0F7B0F"/>
    <SolidColorBrush x:Key="SeverityInfoBrush" Color="#005FB8"/>
    <SolidColorBrush x:Key="SeverityCriticalBackgroundBrush" Color="#FDE7E9"/>
    <SolidColorBrush x:Key="SeverityHighBackgroundBrush" Color="#FBF0E4"/>
    <SolidColorBrush x:Key="SeverityMediumBackgroundBrush" Color="#FFF4CE"/>
    <SolidColorBrush x:Key="SeverityLowBackgroundBrush" Color="#DFF6DD"/>
    <SolidColorBrush x:Key="SeverityInfoBackgroundBrush" Color="#E5F1FB"/>

    <!-- ============================= ELEVATION ============================== -->    <sys:Double x:Key="ShadowBlurCard">8</sys:Double>
    <sys:Double x:Key="ShadowOpacityCard">0.10</sys:Double>
    <sys:Double x:Key="ShadowDepthCard">2</sys:Double>
    <sys:Double x:Key="ShadowOpacityFlyout">0.22</sys:Double>
    <sys:Double x:Key="ShadowDepthFlyout">4</sys:Double>

    <!-- ==================================================================== -->
    <!-- LEGACY ALIASES — keep every pre-refactor key resolving to a Fluent    -->
    <!-- token so untouched views immediately adopt the new visual language.   -->
    <!-- ==================================================================== -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#66F9F9F9"/>
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#09000000"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#CCF3F3F3"/>
    <SolidColorBrush x:Key="TableRowAltBrush" Color="#F9F9F9"/>
    <SolidColorBrush x:Key="TableHoverBrush" Color="#09000000"/>
    <SolidColorBrush x:Key="ModalOverlayBrush" Color="#4D000000"/>

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#5D5D5D"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="SidebarTextBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="SidebarMutedTextBrush" Color="#5D5D5D"/>
    <SolidColorBrush x:Key="ButtonTextBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="PrimaryBrush" Color="#005FB8"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#146CC0"/>
    <SolidColorBrush x:Key="PrimaryActiveBrush" Color="#0A57A0"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#005FB8"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="#0F7B0F"/>
    <SolidColorBrush x:Key="SuccessBgBrush" Color="#DFF6DD"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#9D5D00"/>
    <SolidColorBrush x:Key="WarningBgBrush" Color="#FFF4CE"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C"/>
    <SolidColorBrush x:Key="DangerBgBrush" Color="#FDE7E9"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#005FB8"/>
    <SolidColorBrush x:Key="InfoBgBrush" Color="#E5F1FB"/>

    <SolidColorBrush x:Key="BorderBrush" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#D6D6D6"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#E5E5E5"/>

    <!-- Categorical chart ramp (data-viz, accent-independent) -->
    <SolidColorBrush x:Key="Chart1Brush" Color="#005FB8"/>
    <SolidColorBrush x:Key="Chart2Brush" Color="#0F7B0F"/>
    <SolidColorBrush x:Key="Chart3Brush" Color="#9D5D00"/>
    <SolidColorBrush x:Key="Chart4Brush" Color="#C42B1C"/>
    <SolidColorBrush x:Key="Chart5Brush" Color="#5C2E91"/>
    <SolidColorBrush x:Key="Chart6Brush" Color="#00727A"/>
    <SolidColorBrush x:Key="ChartGridBrush" Color="#EDEDED"/>

    <!-- Login branding (light theme: dark photo background behind the card) -->
    <SolidColorBrush x:Key="LoginBrandingTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="LoginBrandingSubtextBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="LoginBrandingMutedBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="LoginBrandingDividerBrush" Color="#93C5FD"/>
    <SolidColorBrush x:Key="LoginBrandingBackdropBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="LoginBrandingBorderBrush" Color="#00000000"/>
    <Thickness x:Key="LoginBrandingBorderThickness">0</Thickness>

</ResourceDictionary>
