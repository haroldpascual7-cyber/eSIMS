<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F6F9"/>
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#334155"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TableRowAltBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="TableHoverBrush" Color="#EEF2F6"/>
    <SolidColorBrush x:Key="ModalOverlayBrush" Color="#990F172A"/>

    <!-- Foregrounds / Text -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="SidebarTextBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="SidebarMutedTextBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="ButtonTextBrush" Color="#FFFFFF"/>

    <!-- Accents & Brands -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="PrimaryActiveBrush" Color="#1E40AF"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6"/>

    <!-- Status & Badges -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="SuccessBgBrush" Color="#ECFDF5"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="WarningBgBrush" Color="#FFFBEB"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="DangerBgBrush" Color="#FEF2F2"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#06B6D4"/>
    <SolidColorBrush x:Key="InfoBgBrush" Color="#ECFEFF"/>

    <!-- Borders & Dividers -->
    <SolidColorBrush x:Key="BorderBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#E2E8F0"/>

    <!-- Login Branding Dynamic Brushes (Light Theme: Light Text on Dark Campus Background) -->
    <SolidColorBrush x:Key="LoginBrandingTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="LoginBrandingSubtextBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="LoginBrandingMutedBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="LoginBrandingDividerBrush" Color="#93C5FD"/>
    <SolidColorBrush x:Key="LoginBrandingBackdropBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="LoginBrandingBorderBrush" Color="#00000000"/>
    <Thickness x:Key="LoginBrandingBorderThickness">0</Thickness>

</ResourceDictionary>
