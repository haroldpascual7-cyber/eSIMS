<!--
    Fluent surface / composition layer.
    These are the building blocks every view should compose from, instead of
    hand-rolling new Borders with their own radius, padding and colours
    (the pre-refactor pattern that produced 24 distinct corner radii).

    Rules encoded here:
      - Cards: 8px radius, 1px card stroke, 16px padding, no drop shadow at rest.
      - Interactive rows: 32-44px tall, divider separated, subtle hover, accent
        selection — never a 100px+ box for one line of data.
      - Chips: 20px tall, 4px radius, 12px semibold.
      - Toolbars: 44px, layer fill, single bottom divider.
      - Dialogs: 8px radius, flyout shadow, 24px padding, buttons bottom-right.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =============================== CARDS =============================== -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSolidBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusSurface}"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="CardTightStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Padding" Value="12"/>
    </Style>

    <Style x:Key="CardSolidStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSolidBrush}"/>
    </Style>

    <!-- Clickable module / record card: no dramatic hover, just border + subtle fill. -->
    <Style x:Key="CardInteractiveStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Cursor" Value="Arrow"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Plain surface: content grouping without a visible box. -->
    <Style x:Key="SurfacePlainStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- ============================ STAT TILES ============================= -->
    <!-- KPI: label 12 secondary, value 28 semibold, optional delta chip.  -->
    <Style x:Key="StatTileStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="MinWidth" Value="140"/>
        <Setter Property="MinHeight" Value="76"/>
    </Style>

    <Style x:Key="StatTileCompactStyle" TargetType="Border" BasedOn="{StaticResource StatTileStyle}">
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="MinWidth" Value="112"/>
        <Setter Property="MinHeight" Value="64"/>
    </Style>

    <Style x:Key="StatTileAccentStyle" TargetType="Border" BasedOn="{StaticResource StatTileStyle}">
        <Setter Property="Background" Value="{DynamicResource AccentSubtleFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentStrokeBrush}"/>
    </Style>

    <Style x:Key="StatTileCriticalStyle" TargetType="Border" BasedOn="{StaticResource StatTileStyle}">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
    </Style>

    <!-- ============================== CHIPS ================================ -->
    <Style x:Key="StatusChipStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusControl}"/>
        <Setter Property="Padding" Value="6,1"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource SystemFillColorNeutralBackgroundBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style x:Key="StatusChipTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyText}"/>
        <Setter Property="FontSize" Value="{DynamicResource TypeCaption}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    </Style>

    <Style x:Key="ChipCriticalStyle" TargetType="Border" BasedOn="{StaticResource StatusChipStyle}">
        <Setter Property="Background" Value="{DynamicResource SeverityCriticalBackgroundBrush}"/>
    </Style>
    <Style x:Key="ChipHighStyle" TargetType="Border" BasedOn="{StaticResource StatusChipStyle}">
        <Setter Property="Background" Value="{DynamicResource SeverityHighBackgroundBrush}"/>
    </Style>
    <Style x:Key="ChipCautionStyle" TargetType="Border" BasedOn="{StaticResource StatusChipStyle}">
        <Setter Property="Background" Value="{DynamicResource SeverityMediumBackgroundBrush}"/>
    </Style>
    <Style x:Key="ChipSuccessStyle" TargetType="Border" BasedOn="{StaticResource StatusChipStyle}">
        <Setter Property="Background" Value="{DynamicResource SeverityLowBackgroundBrush}"/>
    </Style>
    <Style x:Key="ChipInfoStyle" TargetType="Border" BasedOn="{StaticResource StatusChipStyle}">
        <Setter Property="Background" Value="{DynamicResource SeverityInfoBackgroundBrush}"/>
    </Style>
    <Style x:Key="ChipNeutralStyle" TargetType="Border" BasedOn="{StaticResource StatusChipStyle}">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorNeutralBackgroundBrush}"/>
    </Style>

    <Style x:Key="ChipCriticalTextStyle" TargetType="TextBlock" BasedOn="{StaticResource StatusChipTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource SeverityCriticalBrush}"/>
    </Style>
    <Style x:Key="ChipHighTextStyle" TargetType="TextBlock" BasedOn="{StaticResource StatusChipTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource SeverityHighBrush}"/>
    </Style>
    <Style x:Key="ChipCautionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource StatusChipTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource SeverityMediumBrush}"/>
    </Style>
    <Style x:Key="ChipSuccessTextStyle" TargetType="TextBlock" BasedOn="{StaticResource StatusChipTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource SeverityLowBrush}"/>
    </Style>
    <Style x:Key="ChipInfoTextStyle" TargetType="TextBlock" BasedOn="{StaticResource StatusChipTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource SeverityInfoBrush}"/>
    </Style>
    <Style x:Key="ChipNeutralTextStyle" TargetType="TextBlock" BasedOn="{StaticResource StatusChipTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
    </Style>

    <!-- Count badge (unread notifications etc.) -->
    <Style x:Key="CountBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="MinWidth" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Padding" Value="5,0"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>

    <!-- ============================= ICON TILES ============================ -->
    <Style x:Key="IconTileStyle" TargetType="Border">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusControl}"/>
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="IconTileAccentStyle" TargetType="Border" BasedOn="{StaticResource IconTileStyle}">
        <Setter Property="Background" Value="{DynamicResource AccentSubtleFillBrush}"/>
    </Style>

    <Style x:Key="AvatarStyle" TargetType="Border">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ============================== BARS ================================= -->
    <Style x:Key="ToolbarBarStyle" TargetType="Border">
        <Setter Property="Height" Value="{DynamicResource CommandBarHeight}"/>
        <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="16,0"/>
    </Style>

    <Style x:Key="PageHeaderBarStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="24,20,24,12"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style x:Key="DividerStyle" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="VerticalDividerStyle" TargetType="Border">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/>
        <Setter Property="Margin" Value="8,8"/>
    </Style>

    <!-- ============================== ROWS ================================= -->
    <!-- One-line record row: 44px, divider, hover + accent selection. -->
    <Style x:Key="RecordRowStyle" TargetType="Border">
        <Setter Property="MinHeight" Value="{DynamicResource ListRowHeight}"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RecordRowSelectedStyle" TargetType="Border" BasedOn="{StaticResource RecordRowStyle}">
        <Setter Property="Background" Value="{DynamicResource AccentSubtleFillBrush}"/>
    </Style>

    <Style x:Key="CompactRowStyle" TargetType="Border" BasedOn="{StaticResource RecordRowStyle}">
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="12,4"/>
    </Style>

    <!-- Key/value line used in detail dossiers. -->
    <Style x:Key="FieldRowStyle" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- ============================ DIALOGS ================================ -->
    <Style x:Key="ModalOverlayStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SmokeFillColorDefaultBrush}"/>
    </Style>

    <Style x:Key="DialogCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Background" Value="{DynamicResource DialogBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusOverlay}"/>
        <Setter Property="Padding" Value="24"/>
        <Setter Property="MaxWidth" Value="880"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" Opacity="{DynamicResource ShadowOpacityFlyout}" BlurRadius="24" ShadowDepth="4" Direction="270"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DialogFooterBarStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0,16,0,0"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- ============================= EMPTY STATE =========================== -->
    <!-- Compact: icon + one line. No paragraphs, no giant illustration boxes. -->
    <Style x:Key="EmptyStatePanelStyle" TargetType="StackPanel">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="24"/>
        <Setter Property="MaxWidth" Value="360"/>
    </Style>

    <!-- ============================= INFOBAR =============================== -->
    <Style x:Key="InfoBarStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusSurface}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorAttentionBrush}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="InfoBarCriticalStyle" TargetType="Border" BasedOn="{StaticResource InfoBarStyle}">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
    </Style>

    <Style x:Key="InfoBarCautionStyle" TargetType="Border" BasedOn="{StaticResource InfoBarStyle}">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}"/>
    </Style>

    <Style x:Key="InfoBarSuccessStyle" TargetType="Border" BasedOn="{StaticResource InfoBarStyle}">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
    </Style>

    <!-- ============================== TABLE SHELL ========================== -->
    <Style x:Key="TableCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>

    <Style x:Key="TableHeaderBarStyle" TargetType="Border">
        <Setter Property="Height" Value="36"/>
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="12,0"/>
    </Style>

    <Style x:Key="TableHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource StatusChipTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ============================ CHART SHELL ============================ -->
    <Style x:Key="ChartHostStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="MinHeight" Value="160"/>
    </Style>

</ResourceDictionary>
