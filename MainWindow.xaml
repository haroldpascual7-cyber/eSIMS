<Window x:Class="SmartSchoolIncidentManagementSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SmartSchoolIncidentManagementSystem.ViewModels"
        xmlns:views="clr-namespace:SmartSchoolIncidentManagementSystem.Views"
        mc:Ignorable="d"
        Title="Smart School Incident Management System"
        Width="1366" Height="820"
        MinWidth="1024" MinHeight="640"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        UseLayoutRounding="True"
        FontFamily="{DynamicResource FontFamilyText}"
        FontSize="{DynamicResource TypeBody}"
        TextOptions.TextFormattingMode="Ideal">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- DataTemplates mapping ViewModels to Views -->
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TabletDashboardViewModel}">
            <views:TabletDashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StudentsViewModel}">
            <views:StudentsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:IncidentListViewModel}">
            <views:IncidentListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:IncidentDetailViewModel}">
            <views:IncidentDetailView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InvestigationListViewModel}">
            <views:InvestigationListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InvestigationDetailViewModel}">
            <views:InvestigationDetailView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DisciplinaryActionsHubViewModel}">
            <views:DisciplinaryActionsHubView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConsequenceTrackingViewModel}">
            <views:ConsequenceTrackingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RestorativeInterventionsViewModel}">
            <views:RestorativeInterventionsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SuspensionCalendarViewModel}">
            <views:SuspensionCalendarView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProbationTrackingViewModel}">
            <views:ProbationTrackingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BehaviorWorkspaceViewModel}">
            <views:BehaviorWorkspaceView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ParentNoticesViewModel}">
            <views:ParentNoticesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsAnalyticsViewModel}">
            <views:ReportsAnalyticsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsWorkspaceViewModel}">
            <views:SettingsWorkspaceView/>
        </DataTemplate>

        <!-- Quiet busy spinner: 16px arc, no full-screen curtain over the data. -->
        <Style x:Key="BusyArcStyle" TargetType="Path">
            <Setter Property="Data" Value="M16 3a13 13 0 1 0 13 13"/>
            <Setter Property="Stroke" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
            <Setter Property="StrokeThickness" Value="3"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform Angle="0"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="ShellRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 34px title bar -->
            <RowDefinition Height="*"/>     <!-- navigation pane + page content -->
        </Grid.RowDefinitions>

        <!-- ============================= TITLE BAR ========================= -->
        <Grid x:Name="TitleBar" Grid.Row="0" Height="34"
              Visibility="{Binding ShowTitleBar, Converter={StaticResource BoolToVis}}"
              Background="{DynamicResource LayeredTitleBarBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"
                        Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVis}}">
                <Path Data="{StaticResource Icon.School}" Style="{StaticResource IconSmStyle}"
                      Fill="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,8,0"/>
                <TextBlock Text="eSIMS" FontSize="{DynamicResource TypeCaption}" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <TextBlock Text="·" Margin="8,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                <TextBlock Text="{Binding SectionBreadcrumb}" FontSize="{DynamicResource TypeCaption}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource TitleBarButtonStyle}" Command="{Binding NavigateHomeCommand}"
                        Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVis}}"
                        ToolTip="Open the dashboard" AutomationProperties.Name="Dashboard">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Home}" Style="{StaticResource IconSmStyle}" Margin="0,0,6,0"/>
                        <TextBlock Text="Dashboard" FontSize="{DynamicResource TypeCaption}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource TitleBarButtonStyle}" Command="{Binding NavigateKioskCommand}"
                        Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVis}}"
                        ToolTip="Open the full-screen kiosk board" AutomationProperties.Name="Kiosk board">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Fullscreen}" Style="{StaticResource IconSmStyle}" Margin="0,0,6,0"/>
                        <TextBlock Text="Kiosk" FontSize="{DynamicResource TypeCaption}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Live busy spinner (only while a page is loading) -->
                <Grid Width="24" Height="24" VerticalAlignment="Center" Margin="4,0"
                      Visibility="{Binding CurrentViewModel.IsLoading, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                    <Path Style="{StaticResource BusyArcStyle}">
                        <Path.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         From="0" To="360" Duration="0:0:0.9"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Path.Triggers>
                    </Path>
                </Grid>

                <Button Style="{StaticResource IconButtonStyle}" Command="{Binding ToggleThemeCommand}"
                        Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVis}}"
                        ToolTip="{Binding ThemeToggleTooltip, FallbackValue='Switch light / dark'}"
                        AutomationProperties.Name="Toggle theme">
                    <Path>
                        <Path.Style>
                            <Style TargetType="Path" BasedOn="{StaticResource IconSmStyle}">
                                <Setter Property="Data" Value="{StaticResource Icon.Moon}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkMode}" Value="True">
                                        <Setter Property="Data" Value="{StaticResource Icon.Sun}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Button>

                <Button Style="{StaticResource IconButtonStyle}" Width="34" Focusable="False"
                        Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVis}}"
                        Command="{Binding ViewNotificationsCommand}"
                        ToolTip="Notifications" AutomationProperties.Name="Notifications">
                    <Grid Width="28" Height="28">
                        <Path Data="{StaticResource Icon.Bell}" Style="{StaticResource IconStyle}"
                              Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource CountBadgeStyle}"
                                MinWidth="14" Height="14" CornerRadius="7" Padding="3,0"
                                Margin="0,1,0,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Visibility="{Binding HasUnreadNotifications, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding UnreadNotificationCount}"
                                       FontSize="9" FontWeight="Bold"
                                       Foreground="{DynamicResource ButtonTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Button>

                <!-- Profile Icon & Dropdown -->
                <Grid Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVis}}" Margin="4,0,10,0" VerticalAlignment="Center">
                    <ToggleButton x:Name="ProfileMenuButton" Width="28" Height="28" Cursor="Hand" Focusable="False"
                                  ToolTip="{Binding UserDisplayName}" AutomationProperties.Name="User profile">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Root" Width="26" Height="26" CornerRadius="999"
                                        Background="{DynamicResource PrimaryBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                    <TextBlock Text="{Binding UserInitials}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ButtonTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource PrimaryActiveBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <Popup x:Name="ProfileMenuPopup"
                           IsOpen="{Binding IsChecked, ElementName=ProfileMenuButton, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=ProfileMenuButton}"
                           Placement="Bottom" HorizontalOffset="-172" VerticalOffset="6"
                           StaysOpen="False" AllowsTransparency="True">
                        <Border Width="210" Background="{DynamicResource FlyoutBackgroundBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="6" Margin="6">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Opacity="{DynamicResource ShadowOpacityFlyout}" BlurRadius="14" ShadowDepth="3" Direction="270"/>
                            </Border.Effect>
                            <StackPanel>
                                <Grid Margin="8,6,8,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="999" Background="{DynamicResource PrimaryBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding UserInitials}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ButtonTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CurrentUserName}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding CurrentUserRole}" FontSize="11"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="4,0,4,4"/>

                                <Button Style="{StaticResource SubtleButtonStyle}" Height="32" Padding="8,0"
                                        HorizontalContentAlignment="Left" Click="OnProfileLogoutClick">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource Icon.Logout}" Style="{StaticResource IconSmStyle}" Margin="0,0,8,0"/>
                                        <TextBlock Text="Log out" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- ========================= NAVIGATION + PAGE ===================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <views:SidebarNavigationControl Grid.Column="0"
                                            Visibility="{Binding ShowSidebar, Converter={StaticResource BoolToVis}}"/>

            <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" ClipToBounds="False"/>
        </Grid>

        <!-- ================== NOTIFICATION CENTER (DROPDOWN) =============== -->
        <Grid Grid.RowSpan="2"
              Visibility="{Binding IsNotificationModalOpen, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="3000">
            <Border Background="{DynamicResource DropdownBackdropBrush}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseNotificationModalCommand}"/>
                </Border.InputBindings>
            </Border>
            <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Margin" Value="16,38,16,16"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsKioskActive}" Value="True">
                                <Setter Property="Margin" Value="18,74,18,16"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <views:NotificationCenterModalView HorizontalAlignment="Right" VerticalAlignment="Top"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
