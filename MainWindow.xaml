<Window x:Class="SmartSchoolIncidentManagementSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SmartSchoolIncidentManagementSystem.ViewModels"
        xmlns:views="clr-namespace:SmartSchoolIncidentManagementSystem.Views"
        mc:Ignorable="d"
        Title="Smart School Incident Management System"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <!-- DataTemplates mapping ViewModels to Views -->
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TabletDashboardViewModel}">
            <views:TabletDashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StudentsViewModel}">
            <views:StudentsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:IncidentListViewModel}">
            <views:IncidentListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:IncidentDetailViewModel}">
            <views:IncidentDetailView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InvestigationListViewModel}">
            <views:InvestigationListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InvestigationDetailViewModel}">
            <views:InvestigationDetailView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BehaviorWorkspaceViewModel}">
            <views:BehaviorWorkspaceView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ParentNoticesViewModel}">
            <views:ParentNoticesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsAnalyticsViewModel}">
            <views:ReportsAnalyticsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsWorkspaceViewModel}">
            <views:SettingsWorkspaceView/>
        </DataTemplate>

        <!-- Sidebar Navigation Button Style -->
        <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="10,2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 1. Unauthenticated View (Login Screen) -->
        <ContentControl Content="{Binding CurrentViewModel}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAuthenticated}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>

        <!-- 2. Authenticated Shell (Header Bar + 8 Workspaces) -->
        <Grid ClipToBounds="False">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAuthenticated}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- Left Sidebar Navigation -->
                <ColumnDefinition Width="*"/>    <!-- Main Workspace Content Area -->
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR NAVIGATION: Exists in all workspaces except the full-screen Dashboard -->
            <Border Grid.Column="0" Width="230"
                    Visibility="{Binding IsDashboardActive, Converter={StaticResource InverseBoolToVis}}"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- School Branding -->
                        <RowDefinition Height="*"/>    <!-- Vertical Navigation Menu -->
                        <RowDefinition Height="Auto"/> <!-- Bottom User Profile & Quick Actions -->
                    </Grid.RowDefinitions>

                    <!-- 1. School Branding -->
                    <Border Grid.Row="0" Padding="16,14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Ellipse Grid.Column="0" Width="38" Height="38" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="pack://application:,,,/Assets/Matti_National_High_School_logo.png"
                                                Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Ellipse.Fill>
                            </Ellipse>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="MATTI NATIONAL" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SidebarTextBrush}"/>
                                <TextBlock Text="HIGH SCHOOL" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SidebarTextBrush}"/>
                                <TextBlock Text="Incident System" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 2. Vertical Navigation Menu -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,10">
                        <StackPanel>
                            <!-- 1. Dashboard (Returns to Full-Screen Tablet Dashboard) -->
                            <Button Command="{Binding NavigateDashboardCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDashboardActive}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDashboardOverviewActive}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🏠" FontSize="15" Width="26" VerticalAlignment="Center"/>
                                    <TextBlock Text="Dashboard" FontSize="12.5" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>

                            <!-- 2. Students Directory -->
                            <Button Command="{Binding NavigateStudentsCommand}"
                                    Visibility="{Binding CanAccessStudents, Converter={StaticResource BoolToVis}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStudentsActive}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="👥" FontSize="15" Width="26" VerticalAlignment="Center"/>
                                    <TextBlock Text="Students" FontSize="12.5" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>

                            <!-- 3. Incidents Management -->
                            <Button Command="{Binding NavigateIncidentsCommand}"
                                    Visibility="{Binding CanAccessIncidents, Converter={StaticResource BoolToVis}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsIncidentsActive}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🚨" FontSize="15" Width="26" VerticalAlignment="Center"/>
                                    <TextBlock Text="Incidents" FontSize="12.5" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>

                            <!-- 4. Investigations Workspace -->
                            <Button Command="{Binding NavigateInvestigationsCommand}"
                                    Visibility="{Binding CanAccessInvestigations, Converter={StaticResource BoolToVis}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInvestigationsActive}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🔍" FontSize="15" Width="26" VerticalAlignment="Center"/>
                                    <TextBlock Text="Investigations" FontSize="12.5" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>

                            <!-- 5. Student Behavioral Management -->
                            <Button Command="{Binding NavigateBehaviorCommand}"
                                    Visibility="{Binding CanAccessBehavior, Converter={StaticResource BoolToVis}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBehaviorActive}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📈" FontSize="15" Width="26" VerticalAlignment="Center"/>
                                    <TextBlock Text="Behavior &amp; IAP" FontSize="12.5" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>

                            <!-- 6. Parent Notices -->
                            <Button Command="{Binding NavigateParentNoticesCommand}"
                                    Visibility="{Binding CanAccessParentNotices, Converter={StaticResource BoolToVis}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsParentNoticesActive}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="✉️" FontSize="15" Width="26" VerticalAlignment="Center"/>
                                    <TextBlock Text="Parent Notices" FontSize="12.5" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>

                            <!-- 7. Safety Reports & Analytics -->
                            <Button Command="{Binding NavigateReportsAnalyticsCommand}"
                                    Visibility="{Binding CanAccessReports, Converter={StaticResource BoolToVis}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsReportsAnalyticsActive}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📊" FontSize="15" Width="26" VerticalAlignment="Center"/>
                                    <TextBlock Text="Reports &amp; Analytics" FontSize="12.5" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>

                            <!-- 8. System Administration & Settings -->
                            <Button Command="{Binding NavigateSettingsCommand}"
                                    Visibility="{Binding CanAccessSettings, Converter={StaticResource BoolToVis}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSettingsActive}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⚙️" FontSize="15" Width="26" VerticalAlignment="Center"/>
                                    <TextBlock Text="Settings &amp; Users" FontSize="12.5" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 3. Bottom User Profile & Quick Actions -->
                    <Border Grid.Row="2" Padding="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <!-- Active User Card -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="{DynamicResource PrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding UserInitials}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ButtonTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CurrentUserName}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding CurrentUserRole}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
                                        <TextBlock Text="● Online" FontSize="9" Foreground="{DynamicResource SuccessBrush}" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Action Bar: Theme & Logout -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Command="{Binding ToggleThemeCommand}" Style="{DynamicResource SecondaryButtonStyle}" Height="32" Padding="0" ToolTip="Toggle Light / Dark Mode" Margin="0,0,8,0">
                                    <TextBlock Text="🌓" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>

                                <Button Grid.Column="1" Command="{Binding LogoutCommand}" Style="{DynamicResource SecondaryButtonStyle}" Height="32" Padding="0" ToolTip="Log Out of System">
                                    <TextBlock Text="🚪 Exit" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- MAIN WORKSPACE CONTENT AREA -->
            <Grid Grid.Column="1" ClipToBounds="False" Panel.ZIndex="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Minimal Top Breadcrumb & Window Controls -->
                    <RowDefinition Height="*"/>    <!-- Active Workspace View -->
                </Grid.RowDefinitions>

                <!-- Minimal Top Bar (Active only when NOT on full-screen Tablet Dashboard) -->
                <Border Grid.Row="0" Height="42"
                        Visibility="{Binding IsDashboardActive, Converter={StaticResource InverseBoolToVis}}"
                        Background="{DynamicResource HeaderBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="18,0,12,0">
                    <Grid>
                        <!-- Left: Breadcrumb Navigation with Home Icon -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <Button Command="{Binding NavigateTabletDashboardCommand}"
                                    Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,6,0"
                                    Cursor="Hand" ToolTip="Return to Main Home Dashboard">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🏠" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Workspace" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="  /  " FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ActiveSectionTitle}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Right: Action Bar (Home, Notifications, Close) -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <!-- Home Dashboard Icon Button -->
                            <Button Command="{Binding NavigateTabletDashboardCommand}"
                                    Style="{DynamicResource SecondaryButtonStyle}"
                                    Height="28" Width="32" Padding="0" Margin="0,0,8,0"
                                    Cursor="Hand" ToolTip="Home (Return to Main Dashboard)">
                                <TextBlock Text="🏠" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>

                            <!-- Notification Center Bell Icon Button -->
                            <Button Command="{Binding ViewNotificationsCommand}"
                                    Style="{DynamicResource SecondaryButtonStyle}"
                                    Height="28" Padding="8,0" Margin="0,0,8,0"
                                    Cursor="Hand" ToolTip="Open Notification Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🔔" FontSize="12" VerticalAlignment="Center"/>
                                    <Border Visibility="{Binding HasUnreadNotifications, Converter={StaticResource BoolToVis}}"
                                            Background="{DynamicResource DangerBrush}" CornerRadius="6"
                                            Padding="4,0" Margin="5,0,0,0" Height="14" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding UnreadNotificationCount}" FontSize="9" FontWeight="Bold"
                                                   Foreground="{DynamicResource ButtonTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Button>

                            <!-- Close Application Button -->
                            <Button Content="✕" Click="OnCloseWindowClick" Width="30" Height="28"
                                    FontSize="11" Background="Transparent" BorderBrush="{DynamicResource DangerBrush}"
                                    BorderThickness="1" Foreground="{DynamicResource DangerBrush}" Cursor="Hand" ToolTip="Close Application"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Workspace View Content Control -->
                <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" ClipToBounds="False"/>
            </Grid>
        </Grid>

        <!-- ==================== 3. FULL-SCREEN NOTIFICATION CENTER MODAL DIALOG ==================== -->
        <Grid Visibility="{Binding IsNotificationModalOpen, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="3000"
              ClipToBounds="False"
              Background="{DynamicResource ModalOverlayBrush}">
            <views:NotificationCenterModalView HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>