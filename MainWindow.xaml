<Window x:Class="SmartSchoolIncidentManagementSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SmartSchoolIncidentManagementSystem.ViewModels"
        xmlns:views="clr-namespace:SmartSchoolIncidentManagementSystem.Views"
        mc:Ignorable="d"
        Title="Smart School Incident Management System"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <!-- DataTemplates mapping ViewModels to Views -->
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TabletDashboardViewModel}">
            <views:TabletDashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StudentsViewModel}">
            <views:StudentsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:IncidentListViewModel}">
            <views:IncidentListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:IncidentDetailViewModel}">
            <views:IncidentDetailView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InvestigationListViewModel}">
            <views:InvestigationListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InvestigationDetailViewModel}">
            <views:InvestigationDetailView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DisciplinaryActionsHubViewModel}">
            <views:DisciplinaryActionsHubView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConsequenceTrackingViewModel}">
            <views:ConsequenceTrackingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RestorativeInterventionsViewModel}">
            <views:RestorativeInterventionsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SuspensionCalendarViewModel}">
            <views:SuspensionCalendarView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProbationTrackingViewModel}">
            <views:ProbationTrackingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BehaviorWorkspaceViewModel}">
            <views:BehaviorWorkspaceView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ParentNoticesViewModel}">
            <views:ParentNoticesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsAnalyticsViewModel}">
            <views:ReportsAnalyticsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsWorkspaceViewModel}">
            <views:SettingsWorkspaceView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- 1. Unauthenticated View (Login Screen) -->
        <ContentControl Content="{Binding CurrentViewModel}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAuthenticated}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>

        <!-- 2. Authenticated Shell (Header Bar + 8 Workspaces) -->
        <Grid ClipToBounds="False">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAuthenticated}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- Left Sidebar Navigation -->
                <ColumnDefinition Width="*"/>    <!-- Main Workspace Content Area -->
            </Grid.ColumnDefinitions>

            <!-- REUSABLE COLLAPSIBLE LEFT SIDEBAR NAVIGATION: Icons only when collapsed, Icons + Text when expanded -->
            <views:SidebarNavigationControl Grid.Column="0"
                                            Visibility="{Binding IsDashboardActive, Converter={StaticResource InverseBoolToVis}}"/>

            <!-- MAIN WORKSPACE CONTENT AREA -->
            <Grid Grid.Column="1" ClipToBounds="False" Panel.ZIndex="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Minimal Top Breadcrumb & Window Controls -->
                    <RowDefinition Height="*"/>    <!-- Active Workspace View -->
                </Grid.RowDefinitions>

                <!-- Minimal Top Bar (Active only when NOT on full-screen Tablet Dashboard) -->
                <Border Grid.Row="0" Height="42"
                        Visibility="{Binding IsDashboardActive, Converter={StaticResource InverseBoolToVis}}"
                        Background="{DynamicResource HeaderBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="18,0,12,0">
                    <Grid>
                        <!-- Left: Breadcrumb Navigation with Home Icon -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <Button Command="{Binding NavigateTabletDashboardCommand}"
                                    Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,6,0"
                                    Cursor="Hand" ToolTip="Return to Main Home Dashboard">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🏠" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Workspace" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="  /  " FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ActiveSectionTitle}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Right: Action Bar (Home, Notifications, Close) -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <!-- Home Dashboard Icon Button -->
                            <Button Command="{Binding NavigateTabletDashboardCommand}"
                                    Style="{DynamicResource SecondaryButtonStyle}"
                                    Height="28" Width="32" Padding="0" Margin="0,0,8,0"
                                    Cursor="Hand" ToolTip="Home (Return to Main Dashboard)">
                                <TextBlock Text="🏠" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>

                            <!-- Notification Center Bell Icon Button -->
                            <Button Command="{Binding ViewNotificationsCommand}"
                                    Style="{DynamicResource SecondaryButtonStyle}"
                                    Height="28" Padding="8,0" Margin="0,0,8,0"
                                    Cursor="Hand" ToolTip="Open Notification Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🔔" FontSize="12" VerticalAlignment="Center"/>
                                    <Border Visibility="{Binding HasUnreadNotifications, Converter={StaticResource BoolToVis}}"
                                            Background="{DynamicResource DangerBrush}" CornerRadius="6"
                                            Padding="4,0" Margin="5,0,0,0" Height="14" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding UnreadNotificationCount}" FontSize="9" FontWeight="Bold"
                                                   Foreground="{DynamicResource ButtonTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Button>

                            <!-- Close Application Button -->
                            <Button Content="✕" Click="OnCloseWindowClick" Width="30" Height="28"
                                    FontSize="11" Background="Transparent" BorderBrush="{DynamicResource DangerBrush}"
                                    BorderThickness="1" Foreground="{DynamicResource DangerBrush}" Cursor="Hand" ToolTip="Close Application"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Workspace View Content Control -->
                <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" ClipToBounds="False"/>
            </Grid>
        </Grid>

        <!-- ==================== 3. GLOBAL FULL-SCREEN REFRESH / LOADING OVERLAY ==================== -->
        <Grid Visibility="{Binding CurrentViewModel.IsLoading, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed, TargetNullValue=Collapsed}"
              Panel.ZIndex="2500"
              ClipToBounds="False"
              Background="{DynamicResource ModalOverlayBrush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Smooth Rotating Radial Activity Indicator -->
                <Grid Width="56" Height="56" HorizontalAlignment="Center" Margin="0,0,0,16" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <RotateTransform Angle="0"/>
                    </Grid.RenderTransform>
                    <Grid.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                     From="0" To="360" Duration="0:0:0.9"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Grid.Triggers>
                    <!-- 12 Radial Rounded Spokes with Graduated Opacities -->
                    <Border Width="3.5" Height="11" CornerRadius="2" Background="{DynamicResource AccentBrush}" Opacity="1.0" VerticalAlignment="Top" HorizontalAlignment="Center"/>
                    <Grid Width="56" Height="56" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><RotateTransform Angle="30"/></Grid.RenderTransform><Border Width="3.5" Height="11" CornerRadius="2" Background="{DynamicResource AccentBrush}" Opacity="0.91" VerticalAlignment="Top" HorizontalAlignment="Center"/></Grid>
                    <Grid Width="56" Height="56" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><RotateTransform Angle="60"/></Grid.RenderTransform><Border Width="3.5" Height="11" CornerRadius="2" Background="{DynamicResource AccentBrush}" Opacity="0.82" VerticalAlignment="Top" HorizontalAlignment="Center"/></Grid>
                    <Grid Width="56" Height="56" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><RotateTransform Angle="90"/></Grid.RenderTransform><Border Width="3.5" Height="11" CornerRadius="2" Background="{DynamicResource AccentBrush}" Opacity="0.73" VerticalAlignment="Top" HorizontalAlignment="Center"/></Grid>
                    <Grid Width="56" Height="56" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><RotateTransform Angle="120"/></Grid.RenderTransform><Border Width="3.5" Height="11" CornerRadius="2" Background="{DynamicResource AccentBrush}" Opacity="0.64" VerticalAlignment="Top" HorizontalAlignment="Center"/></Grid>
                    <Grid Width="56" Height="56" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><RotateTransform Angle="150"/></Grid.RenderTransform><Border Width="3.5" Height="11" CornerRadius="2" Background="{DynamicResource AccentBrush}" Opacity="0.55" VerticalAlignment="Top" HorizontalAlignment="Center"/></Grid>
                    <Grid Width="56" Height="56" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><RotateTransform Angle="180"/></Grid.RenderTransform><Border Width="3.5" Height="11" CornerRadius="2" Background="{DynamicResource AccentBrush}" Opacity="0.46" VerticalAlignment="Top" HorizontalAlignment="Center"/></Grid>
                    <Grid Width="56" Height="56" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><RotateTransform Angle="210"/></Grid.RenderTransform><Border Width="3.5" Height="11" CornerRadius="2" Background="{DynamicResource AccentBrush}" Opacity="0.36" VerticalAlignment="Top" HorizontalAlignment="Center"/></Grid>
                    <Grid Width="56" Height="56" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><RotateTransform Angle="240"/></Grid.RenderTransform><Border Width="3.5" Height="11" CornerRadius="2" Background="{DynamicResource AccentBrush}" Opacity="0.27" VerticalAlignment="Top" HorizontalAlignment="Center"/></Grid>
                    <Grid Width="56" Height="56" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><RotateTransform Angle="270"/></Grid.RenderTransform><Border Width="3.5" Height="11" CornerRadius="2" Background="{DynamicResource AccentBrush}" Opacity="0.20" VerticalAlignment="Top" HorizontalAlignment="Center"/></Grid>
                    <Grid Width="56" Height="56" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><RotateTransform Angle="300"/></Grid.RenderTransform><Border Width="3.5" Height="11" CornerRadius="2" Background="{DynamicResource AccentBrush}" Opacity="0.14" VerticalAlignment="Top" HorizontalAlignment="Center"/></Grid>
                    <Grid Width="56" Height="56" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><RotateTransform Angle="330"/></Grid.RenderTransform><Border Width="3.5" Height="11" CornerRadius="2" Background="{DynamicResource AccentBrush}" Opacity="0.08" VerticalAlignment="Top" HorizontalAlignment="Center"/></Grid>
                </Grid>

                <!-- Status Title & Subtitle Matching Reference Mockup -->
                <TextBlock Text="Refreshing..."
                           FontSize="19"
                           FontWeight="Bold"
                           Foreground="{DynamicResource ButtonTextBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6"/>
                <TextBlock Text="Please wait a moment."
                           FontSize="13"
                           Foreground="{DynamicResource SidebarTextBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ==================== 3. FULL-SCREEN NOTIFICATION CENTER MODAL DIALOG ==================== -->
        <Grid Visibility="{Binding IsNotificationModalOpen, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="3000"
              ClipToBounds="False"
              Background="{DynamicResource ModalOverlayBrush}">
            <views:NotificationCenterModalView HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
