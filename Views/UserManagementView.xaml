<UserControl x:Class="SmartSchoolIncidentManagementSystem.Views.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackgroundBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER WITH ONLINE ADMIN BADGE -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Title & Subtitle -->
            <StackPanel Grid.Column="0">
                <Button Content="&#x2190; Back to Hub" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding BackToHubCommand}" HorizontalAlignment="Left" Padding="10,4" Margin="0,0,0,10"/>
                <TextBlock Text="User Credentials &amp; Management" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <TextBlock Text="Create and manage system user accounts, role assignments, credential resets, and account status controls." FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 1. TOP HEADER ONLINE ADMIN BADGE PILL -->
            <Border Grid.Column="1" VerticalAlignment="Bottom" Background="{DynamicResource TableHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="12,6">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource SuccessBrush}" Margin="0,0,8,0"/>
                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}">
                        <Run Text="Online Admin: " Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <Run Text="{Binding OnlineAdminText, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOOLBAR: SEARCH, ROLE FILTER, + ADD USER BUTTON -->
            <Border Grid.Row="0" Style="{DynamicResource CardBorderStyle}" Padding="16,12" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Box -->
                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource ModernTextBoxStyle}" Height="36" Padding="28,0,24,0"/>
                        <TextBlock Text="🔍" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False"/>
                        <Button Content="✕" Command="{Binding ClearSearchCommand}" Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource SecondaryTextBrush}" Cursor="Hand" Width="20" Height="20"/>
                    </Grid>

                    <!-- Role Filter -->
                    <ComboBox Grid.Column="1" ItemsSource="{Binding RoleFilterOptions}" SelectedItem="{Binding SelectedRoleFilter}"
                              Style="{DynamicResource ModernComboBoxStyle}" Height="36" Margin="0,0,12,0"/>

                    <!-- Add User Button -->
                    <Button Grid.Column="3" Content="+ Add New User" Style="{DynamicResource PrimaryButtonStyle}"
                            Command="{Binding OpenCreateUserModalCommand}" Height="36" Padding="16,0"/>
                </Grid>
            </Border>

            <!-- 4-COLUMN RESPONSIVE USER CARDS -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding UsersView}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{DynamicResource RecordCardStyle}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.OpenUserCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Top Row: Role Badge & Status Pill -->
                                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                        <Border CornerRadius="4" Padding="6,2" Background="{DynamicResource PrimaryBrush}" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Role}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ButtonTextBrush}"/>
                                        </Border>
                                        <Border CornerRadius="4" Padding="6,2" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        </Border>
                                    </DockPanel>

                                    <!-- Full Name -->
                                    <TextBlock Grid.Row="1" Text="{Binding FullName}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,2"/>

                                    <!-- Username -->
                                    <TextBlock Grid.Row="2" Text="{Binding Username, StringFormat='@{0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>

                                    <!-- Email -->
                                    <TextBlock Grid.Row="3" Text="{Binding Email}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- USER MODAL (VIEW & EDIT WITH IN-MODAL CRUD) -->
        <Grid Margin="-260,-60,-20,-20" Panel.ZIndex="1000" Background="{DynamicResource ModalOverlayBrush}"
              Visibility="{Binding IsUserModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{DynamicResource CardBorderStyle}" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <StackPanel>
                    <!-- Header -->
                    <DockPanel Margin="0,0,0,16">
                        <TextBlock Text="{Binding ModalTitle}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <Button Content="✕" Style="{DynamicResource SecondaryButtonStyle}" HorizontalAlignment="Right" Command="{Binding CloseUserModalCommand}" Width="30" Height="30" Padding="0"/>
                    </DockPanel>

                    <!-- VIEW MODE (When IsModalEditing == false) -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsModalEditing}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Full Name:" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedUser.FullName}" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Username:" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedUser.Username, StringFormat='@{0}'}" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Email Address:" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedUser.Email}" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Assigned Role:" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedUser.Role}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Account Status:" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedUser.Status}" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </Grid>
                        </Border>

                        <!-- In-Modal Actions -->
                        <DockPanel>
                            <Button Content="🗑️ Terminate Account" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding DeleteFromModalCommand}" Foreground="{DynamicResource DangerBrush}" DockPanel.Dock="Left" Height="36"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="🔄 Toggle Status" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding ToggleStatusFromModalCommand}" Margin="0,0,8,0" Height="36"/>
                                <Button Content="✏️ Edit Account" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding SwitchToEditModeCommand}" Margin="0,0,8,0" Height="36"/>
                                <Button Content="Close" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding CloseUserModalCommand}" Height="36" Width="70"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>

                    <!-- EDIT / CREATE MODE (When IsModalEditing == true) -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsModalEditing}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <!-- Username -->
                        <TextBlock Text="USERNAME *" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource ModernTextBoxStyle}" Height="36" Margin="0,0,0,10"/>

                        <!-- Full Name -->
                        <TextBlock Text="FULL NAME *" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewFullName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource ModernTextBoxStyle}" Height="36" Margin="0,0,0,10"/>

                        <!-- Email -->
                        <TextBlock Text="EMAIL ADDRESS *" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewEmail, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource ModernTextBoxStyle}" Height="36" Margin="0,0,0,10"/>

                        <!-- System Role -->
                        <TextBlock Text="SYSTEM ROLE *" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding AvailableRoles}" SelectedItem="{Binding SelectedRole}"
                                  Style="{DynamicResource ModernComboBoxStyle}" Height="36" Margin="0,0,0,10"/>

                        <!-- Password -->
                        <TextBlock Text="PASSWORD (LEAVE BLANK TO KEEP EXISTING)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource ModernTextBoxStyle}" Height="36" Margin="0,0,0,18"/>

                        <!-- In-Modal Edit Actions -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="✕ Cancel" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding CancelEditModeCommand}" Margin="0,0,8,0" Height="36" Width="90"/>
                            <Button Content="💾 Save Account" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding SaveFromModalCommand}" Height="36" Width="130"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
