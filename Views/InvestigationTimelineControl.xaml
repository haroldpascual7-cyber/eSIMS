<UserControl x:Class="SmartSchoolIncidentManagementSystem.Views.InvestigationTimelineControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Section Header -->
        <Border Grid.Row="0" Style="{DynamicResource CardBorderStyle}" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x23F1;&#xFE0F;" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Maintain the Investigation Timeline &amp; Evidence Repository" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Log chronological progress, interview summaries, witness corroborate records, and inspect linked physical or digital evidence."
                               FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="24,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource TableHoverBrush}" CornerRadius="12" Padding="10,4">
                        <TextBlock Text="{Binding TimelineEntries.Count, StringFormat='{}{0} Logged Actions'}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Split: Timeline Activity Feed vs Add Entry & Evidence Sidebars -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Chronological Case Timeline Feed -->
            <Border Grid.Column="0" Style="{DynamicResource CardBorderStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Chronological Investigation Feed" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,10"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Empty State -->
                            <Border Background="{DynamicResource TableHoverBrush}" CornerRadius="6" Padding="16" Margin="0,0,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasTimelineEntries}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="No timeline entries logged yet. Post an entry using the form on the right." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextAlignment="Center"/>
                            </Border>

                            <!-- Timeline Items Control -->
                            <ItemsControl ItemsSource="{Binding TimelineEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Header Row -->
                                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding ActionTitle}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                        <Border Background="{DynamicResource InfoBgBrush}" BorderBrush="{DynamicResource InfoBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding EntryType}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource InfoBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock HorizontalAlignment="Right" Text="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd hh:mm tt}'}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                </Grid>

                                                <!-- Performed By -->
                                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="Recorded by: " FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                    <TextBlock Text="{Binding PerformedBy}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
                                                </StackPanel>

                                                <!-- Notes -->
                                                <TextBlock Grid.Row="2" Text="{Binding Notes}" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" LineHeight="18"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- RIGHT: Add Timeline Entry + Available Evidence Gallery -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Box 1: Add New Action / Timeline Note -->
                <Border Grid.Row="0" Style="{DynamicResource CardBorderStyle}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="&#x270F;&#xFE0F; Add Investigation Timeline Entry" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,2"/>
                        <TextBlock Text="Record interviews, witness developments, or evidence findings." FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10"/>

                        <!-- Title and Type Grid -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Action Title *" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,3"/>
                                <TextBox Style="{DynamicResource ModernTextBoxStyle}" Text="{Binding NewTimelineTitle, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Type *" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,3"/>
                                <ComboBox Style="{DynamicResource ModernComboBoxStyle}" ItemsSource="{Binding TimelineTypeOptions}" SelectedItem="{Binding NewTimelineType}" Height="32"/>
                            </StackPanel>
                        </Grid>

                        <!-- Entry Notes -->
                        <TextBlock Text="Details &amp; Observations *" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,3"/>
                        <TextBox Style="{DynamicResource ModernTextBoxStyle}" Text="{Binding NewTimelineNotes, UpdateSourceTrigger=PropertyChanged}" Height="65" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>

                        <!-- Post Button -->
                        <Button Content="+ Post to Investigation Timeline" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding AddTimelineEntryCommand}" Height="34" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>

                <!-- Box 2: Review & Reference Available Evidence -->
                <Border Grid.Row="2" Style="{DynamicResource CardBorderStyle}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,2">
                            <TextBlock Text="&#x1F4C1; Review &amp; Reference Available Evidence" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="Inspect photos, attached documents, and evidence links associated with this case." FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,8"/>
                        </StackPanel>

                        <!-- Observation Recording Drawer: Record observations in notes without altering original evidence -->
                        <Border Grid.Row="1" Visibility="{Binding IsObservationPanelOpen, Converter={StaticResource BoolToVis}}"
                                Background="{DynamicResource TableHoverBrush}" BorderBrush="{DynamicResource PrimaryBrush}"
                                BorderThickness="1.5" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📝 Record Observation on Evidence" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <Border Background="{DynamicResource InfoBgBrush}" BorderBrush="{DynamicResource InfoBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                            <TextBlock Text="🔒 Original Evidence Immutable" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource InfoBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <Button Content="✕" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding CancelEvidenceObservationCommand}" HorizontalAlignment="Right" Padding="6,1" FontSize="10"/>
                                </Grid>
                                <TextBlock Text="{Binding OriginalEvidenceImmutableBadge}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                                <TextBox Style="{DynamicResource ModernTextBoxStyle}" Text="{Binding EvidenceObservationNotes, UpdateSourceTrigger=PropertyChanged}"
                                         Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"
                                         ToolTip="Type objective observations without modifying original evidence"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Cancel" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding CancelEvidenceObservationCommand}" Margin="0,0,6,0" Padding="8,3" FontSize="11"/>
                                    <Button Content="💾 Save Observation to Notes" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding SaveEvidenceObservationCommand}" Padding="10,4" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Empty State -->
                        <Border Grid.Row="1" Background="{DynamicResource TableHoverBrush}" CornerRadius="6" Padding="14" Margin="0,0,0,8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasEvidence}" Value="False"/>
                                                <Condition Binding="{Binding IsObservationPanelOpen}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="No evidence attachments or links were uploaded during incident reporting." FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" TextAlignment="Center"/>
                        </Border>

                        <!-- Evidence List -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding AvailableEvidenceList}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Icon -->
                                                <TextBlock Grid.Column="0" Text="{Binding TypeIcon}" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                                <!-- Details -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="{Binding FormattedFileSize}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                        <TextBlock Text=" • " FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                        <TextBlock Text="{Binding FormattedDate}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Action Buttons: Observe & Open -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                                    <Button Content="📝 Observe" Style="{DynamicResource SecondaryButtonStyle}"
                                                            Command="{Binding DataContext.StartEvidenceObservationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Record observations in notes without altering original evidence"
                                                            Padding="8,4" FontSize="11" Margin="0,0,4,0"/>
                                                    <Button Content="📂 Open" Style="{DynamicResource SecondaryButtonStyle}"
                                                            Command="{Binding DataContext.OpenEvidenceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Padding="8,4" FontSize="11"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>