<UserControl x:Class="SmartSchoolIncidentManagementSystem.Views.CampusIncidentLocationMapControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             x:Name="MapRoot">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Map Header Badge -->
        <Border Grid.Row="0" Background="{DynamicResource TableHoverBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📍" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="CAMPUS INCIDENT SITE PINPOINT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding ZoneName, ElementName=MapRoot, StringFormat='Zone: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Campus Blueprint Schematic Canvas -->
        <Border Grid.Row="1" Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
            <Viewbox Stretch="Uniform" Height="220">
                <Canvas Width="700" Height="400" Background="Transparent">

                    <!-- Building 1: Gymnasium & Sports Complex -->
                    <Border Canvas.Left="40" Canvas.Top="40" Width="200" Height="140"
                            Background="{DynamicResource TableHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ZoneKey, ElementName=MapRoot}" Value="GYM">
                                        <Setter Property="Background" Value="{DynamicResource DangerBgBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                        <Setter Property="BorderThickness" Value="2.5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🏀" FontSize="16" HorizontalAlignment="Center"/>
                            <TextBlock Text="GYMNASIUM &amp; SPORTS COMPLEX" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Building 2: Restrooms & Lockers -->
                    <Border Canvas.Left="260" Canvas.Top="40" Width="140" Height="90"
                            Background="{DynamicResource TableHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ZoneKey, ElementName=MapRoot}" Value="LOCKERS">
                                        <Setter Property="Background" Value="{DynamicResource DangerBgBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                        <Setter Property="BorderThickness" Value="2.5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🚪" FontSize="14" HorizontalAlignment="Center"/>
                            <TextBlock Text="RESTROOMS &amp; LOCKERS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Building 3: Science & IT Lab Wing / Classrooms -->
                    <Border Canvas.Left="420" Canvas.Top="40" Width="220" Height="140"
                            Background="{DynamicResource TableHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ZoneKey, ElementName=MapRoot}" Value="SCIENCE">
                                        <Setter Property="Background" Value="{DynamicResource DangerBgBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                        <Setter Property="BorderThickness" Value="2.5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🔬" FontSize="16" HorizontalAlignment="Center"/>
                            <TextBlock Text="SCIENCE &amp; IT LAB WING (ROOMS)" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Building 4: Cafeteria & Canteen -->
                    <Border Canvas.Left="240" Canvas.Top="150" Width="160" Height="70"
                            Background="{DynamicResource TableHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ZoneKey, ElementName=MapRoot}" Value="CAFETERIA">
                                        <Setter Property="Background" Value="{DynamicResource DangerBgBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                        <Setter Property="BorderThickness" Value="2.5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🍽️" FontSize="14" HorizontalAlignment="Center"/>
                            <TextBlock Text="CAFETERIA &amp; CANTEEN" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Building 5: Covered Basketball Court & Playground -->
                    <Border Canvas.Left="40" Canvas.Top="240" Width="200" Height="140"
                            Background="{DynamicResource TableHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ZoneKey, ElementName=MapRoot}" Value="COURT">
                                        <Setter Property="Background" Value="{DynamicResource DangerBgBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                        <Setter Property="BorderThickness" Value="2.5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🏃" FontSize="16" HorizontalAlignment="Center"/>
                            <TextBlock Text="COVERED COURT / PLAYGROUND" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Building 6: Main Hallway & Lobby -->
                    <Border Canvas.Left="260" Canvas.Top="240" Width="140" Height="140"
                            Background="{DynamicResource TableHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ZoneKey, ElementName=MapRoot}" Value="HALLWAY">
                                        <Setter Property="Background" Value="{DynamicResource DangerBgBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                        <Setter Property="BorderThickness" Value="2.5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🏛️" FontSize="16" HorizontalAlignment="Center"/>
                            <TextBlock Text="MAIN HALLWAY &amp; LOBBY" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Building 7: Library & Study Hall -->
                    <Border Canvas.Left="420" Canvas.Top="220" Width="140" Height="120"
                            Background="{DynamicResource TableHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ZoneKey, ElementName=MapRoot}" Value="LIBRARY">
                                        <Setter Property="Background" Value="{DynamicResource DangerBgBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                        <Setter Property="BorderThickness" Value="2.5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="📚" FontSize="16" HorizontalAlignment="Center"/>
                            <TextBlock Text="LIBRARY &amp; STUDY HALL" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Building 8: East Parking Lot -->
                    <Border Canvas.Left="570" Canvas.Top="280" Width="120" Height="100"
                            Background="{DynamicResource TableHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ZoneKey, ElementName=MapRoot}" Value="PARKING">
                                        <Setter Property="Background" Value="{DynamicResource DangerBgBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                        <Setter Property="BorderThickness" Value="2.5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🚗" FontSize="16" HorizontalAlignment="Center"/>
                            <TextBlock Text="EAST PARKING LOT" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- DYNAMIC INCIDENT LOCATION PIN -->
                    <Grid Canvas.Left="{Binding PinX, ElementName=MapRoot}"
                          Canvas.Top="{Binding PinY, ElementName=MapRoot}"
                          Margin="-18,-42,0,0">
                        <!-- Location Callout Speech Bubble -->
                        <Border Background="{DynamicResource DangerBrush}" CornerRadius="6" Padding="6,3" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,4">
                            <Border.Effect>
                                <DropShadowEffect Opacity="0.3" BlurRadius="6" ShadowDepth="2"/>
                            </Border.Effect>
                            <TextBlock Text="{Binding LocationName, ElementName=MapRoot, StringFormat='📍 {0}'}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource ButtonTextBrush}"/>
                        </Border>

                        <!-- Pin Marker Point -->
                        <Ellipse Width="18" Height="18" Fill="{DynamicResource DangerBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                            <Ellipse.Effect>
                                <DropShadowEffect Opacity="0.5" BlurRadius="8" ShadowDepth="0"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>

                </Canvas>
            </Viewbox>
        </Border>

        <!-- Map Footer Caption -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Site Marker:" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding LocationName, ElementName=MapRoot}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/>
                <TextBlock Text=" — " FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBlock Text="{Binding ZoneName, ElementName=MapRoot}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
