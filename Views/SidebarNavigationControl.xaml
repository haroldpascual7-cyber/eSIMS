<UserControl x:Class="SmartSchoolIncidentManagementSystem.Views.SidebarNavigationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             ClipToBounds="True"
             HorizontalAlignment="Left">

    <UserControl.Resources>
        <!-- Nav item content: 16px glyph from Tag, 14px label, hidden on the compact rail. -->
        <DataTemplate x:Key="NavItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                      Style="{StaticResource IconSmStyle}" Width="16" Height="16"/>
                <TextBlock Grid.Column="1" Text="{Binding}" Margin="12,0,0,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolToVis}}"/>
            </Grid>
        </DataTemplate>

        <!-- Base item: 32px tall, 4px radius, 3px accent indicator when selected. -->
        <Style x:Key="SidebarItemStyle" TargetType="Button" BasedOn="{StaticResource NavItemButtonStyle}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="ContentTemplate" Value="{StaticResource NavItemTemplate}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                    <Setter Property="Margin" Value="8,1"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavSectionCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource FontFamilyText}"/>
            <Setter Property="FontSize" Value="{DynamicResource TypeCaption}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
            <Setter Property="Margin" Value="14,8,0,2"/>
        </Style>

        <Style x:Key="RailButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
        </Style>
    </UserControl.Resources>

    <!-- 264px expanded (WinUI pane default) / 48px compact rail. -->
    <Border x:Name="SidebarRoot"
            Background="{DynamicResource NavigationViewDefaultPaneBackgroundBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,1,0"
            ClipToBounds="True">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Width" Value="{DynamicResource NavPaneWidth}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                        <Setter Property="Width" Value="{DynamicResource NavPaneWidthCompact}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ========================= PANE HEADER ========================= -->
            <Grid Grid.Row="0" Height="48" Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="4" VerticalAlignment="Center"
                        Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding DashboardLogoSource}" Stretch="UniformToFill"
                                    RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border.Background>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,8,0"
                            Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}">
                    <TextBlock Text="{Binding SchoolName}" FontSize="{DynamicResource TypeCaption}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding SystemTitle}" FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource RailButtonStyle}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Command="{Binding ToggleSidebarCommand}" ToolTip="Toggle navigation"
                        AutomationProperties.Name="Toggle navigation">
                    <Path Data="{StaticResource Icon.Menu}" Style="{StaticResource IconStyle}" Width="14" Height="14"/>
                </Button>
            </Grid>

            <!-- ========================== NAVIGATION ========================= -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,2,0,12">

                    <TextBlock Text="Overview" Style="{StaticResource NavSectionCaptionStyle}"
                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}"/>

                    <Button Content="Dashboard" Tag="{StaticResource Icon.Home}"
                            Command="{Binding NavigateHomeCommand}"
                            ToolTip="Dashboard" ToolTipService.IsEnabled="{Binding IsSidebarCollapsed}"
                            ToolTipService.Placement="Right" AutomationProperties.Name="Dashboard">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHomeActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentSubtleFillBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <TextBlock Text="Case work" Style="{StaticResource NavSectionCaptionStyle}"
                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}"/>

                    <Button Content="Incidents" Tag="{StaticResource Icon.Incident}"
                            Command="{Binding NavigateIncidentsCommand}"
                            Visibility="{Binding CanAccessIncidents, Converter={StaticResource BoolToVis}}"
                            ToolTip="Incidents" ToolTipService.IsEnabled="{Binding IsSidebarCollapsed}"
                            ToolTipService.Placement="Right" AutomationProperties.Name="Incidents">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsIncidentsActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentSubtleFillBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Investigations" Tag="{StaticResource Icon.Investigation}"
                            Command="{Binding NavigateInvestigationsCommand}"
                            Visibility="{Binding CanAccessInvestigations, Converter={StaticResource BoolToVis}}"
                            ToolTip="Investigations" ToolTipService.IsEnabled="{Binding IsSidebarCollapsed}"
                            ToolTipService.Placement="Right" AutomationProperties.Name="Investigations">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInvestigationsActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentSubtleFillBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Disciplinary actions" Tag="{StaticResource Icon.Flag}"
                            Command="{Binding NavigateDisciplinaryActionsCommand}"
                            Visibility="{Binding CanAccessInvestigations, Converter={StaticResource BoolToVis}}"
                            ToolTip="Disciplinary actions" ToolTipService.IsEnabled="{Binding IsSidebarCollapsed}"
                            ToolTipService.Placement="Right" AutomationProperties.Name="Disciplinary actions">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInvestigationsActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentSubtleFillBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <TextBlock Text="Students" Style="{StaticResource NavSectionCaptionStyle}"
                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}"/>

                    <Button Content="Students" Tag="{StaticResource Icon.Students}"
                            Command="{Binding NavigateStudentsCommand}"
                            Visibility="{Binding CanAccessStudents, Converter={StaticResource BoolToVis}}"
                            ToolTip="Students" ToolTipService.IsEnabled="{Binding IsSidebarCollapsed}"
                            ToolTipService.Placement="Right" AutomationProperties.Name="Students">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStudentsActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentSubtleFillBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Behavior &amp; intervention" Tag="{StaticResource Icon.Behavior}"
                            Command="{Binding NavigateBehaviorCommand}"
                            Visibility="{Binding CanAccessBehavior, Converter={StaticResource BoolToVis}}"
                            ToolTip="Behavior &amp; intervention" ToolTipService.IsEnabled="{Binding IsSidebarCollapsed}"
                            ToolTipService.Placement="Right" AutomationProperties.Name="Behavior and intervention">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBehaviorActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentSubtleFillBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <TextBlock Text="Communication" Style="{StaticResource NavSectionCaptionStyle}"
                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}"/>

                    <Button Content="Parent notices" Tag="{StaticResource Icon.Notices}"
                            Command="{Binding NavigateParentNoticesCommand}"
                            Visibility="{Binding CanAccessParentNotices, Converter={StaticResource BoolToVis}}"
                            ToolTip="Parent notices" ToolTipService.IsEnabled="{Binding IsSidebarCollapsed}"
                            ToolTipService.Placement="Right" AutomationProperties.Name="Parent notices">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsParentNoticesActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentSubtleFillBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <TextBlock Text="Insight" Style="{StaticResource NavSectionCaptionStyle}"
                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}"/>

                    <Button Content="Reports" Tag="{StaticResource Icon.Analytics}"
                            Command="{Binding NavigateReportsAnalyticsCommand}"
                            Visibility="{Binding CanAccessReports, Converter={StaticResource BoolToVis}}"
                            ToolTip="Reports" ToolTipService.IsEnabled="{Binding IsSidebarCollapsed}"
                            ToolTipService.Placement="Right" AutomationProperties.Name="Reports">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReportsAnalyticsActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentSubtleFillBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <TextBlock Text="Administration" Style="{StaticResource NavSectionCaptionStyle}"
                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}"/>

                    <Button Content="Administration" Tag="{StaticResource Icon.Settings}"
                            Command="{Binding NavigateSettingsCommand}"
                            Visibility="{Binding CanAccessSettings, Converter={StaticResource BoolToVis}}"
                            ToolTip="Administration" ToolTipService.IsEnabled="{Binding IsSidebarCollapsed}"
                            ToolTipService.Placement="Right" AutomationProperties.Name="Administration">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentSubtleFillBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>