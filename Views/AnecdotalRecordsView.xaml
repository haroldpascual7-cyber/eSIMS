<UserControl x:Class="SmartSchoolIncidentManagementSystem.Views.AnecdotalRecordsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100"
             Background="{DynamicResource AppBackgroundBrush}">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="32,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 1. HEADER WITH BACK BUTTON AND ACTION -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Vertical">
                        <Button Style="{DynamicResource SecondaryButtonStyle}"
                                Command="{Binding BackCommand}"
                                Content="← Back to Profiles Hub"
                                HorizontalAlignment="Left"
                                Height="32" Padding="12,0" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📝" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Classroom &amp; Campus Anecdotal Records" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Document classroom and campus observations, positive conduct notes, and informal behavioral logs." FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{DynamicResource PrimaryButtonStyle}"
                            Command="{Binding OpenAddModalCommand}"
                            Content="+ New Anecdotal Log"
                            Height="40" Padding="16,0"
                            VerticalAlignment="Bottom"/>
                </Grid>

                <!-- 2. KPI / STATS SUMMARY CARDS -->
                <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,20">
                    <Border Style="{DynamicResource CardBorderStyle}" Margin="4" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="TOTAL OBSERVATIONS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding TotalObservationsCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource CardBorderStyle}" Margin="4" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="POSITIVE CONDUCT &amp; MERIT" FontSize="11" FontWeight="Bold" Foreground="#10B981"/>
                            <TextBlock Text="{Binding PositiveConductCount}" FontSize="24" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource CardBorderStyle}" Margin="4" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="MINOR INFRACTIONS" FontSize="11" FontWeight="Bold" Foreground="#EF4444"/>
                            <TextBlock Text="{Binding MinorInfractionsCount}" FontSize="24" FontWeight="Bold" Foreground="#EF4444" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource CardBorderStyle}" Margin="4" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="PENDING FOLLOW-UP" FontSize="11" FontWeight="Bold" Foreground="#F59E0B"/>
                            <TextBlock Text="{Binding PendingFollowUpCount}" FontSize="24" FontWeight="Bold" Foreground="#F59E0B" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- 3. SEARCH & FILTER CONTROLS -->
                <Border Grid.Row="2" Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,16" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search Bar -->
                        <Grid Grid.Column="0" Margin="0,0,12,0">
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Height="36" Padding="10,0" FontSize="13"
                                     VerticalContentAlignment="Center"
                                     Background="{DynamicResource InputBackgroundBrush}"
                                     BorderBrush="{DynamicResource InputBorderBrush}"
                                     BorderThickness="1"/>
                            <TextBlock Text="🔍 Search student name, ID, setting, or observation notes..."
                                       FontSize="13" Foreground="{DynamicResource MutedTextBrush}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Type Filter -->
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding TypeFilterOptions}"
                                  SelectedItem="{Binding SelectedTypeFilter}"
                                  Height="36" FontSize="13"
                                  VerticalContentAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 4. ANECDOTAL RECORDS DATAGRID -->
                <Border Grid.Row="3" Style="{DynamicResource CardBorderStyle}" Padding="0" ClipToBounds="True">
                    <DataGrid ItemsSource="{Binding Records}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              RowHeight="54"
                              Background="Transparent"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <!-- Date -->
                            <DataGridTextColumn Header="Date &amp; Time" Binding="{Binding FormattedDate}" Width="150"/>

                            <!-- Student Info -->
                            <DataGridTemplateColumn Header="Student" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Margin="6,0">
                                            <TextBlock Text="{Binding StudentName}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="{Binding StudentIdNumber}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Grade & Section -->
                            <DataGridTextColumn Header="Grade &amp; Section" Binding="{Binding GradeSection}" Width="150"/>

                            <!-- Subject / Setting -->
                            <DataGridTextColumn Header="Setting / Subject" Binding="{Binding SettingOrSubject}" Width="160"/>

                            <!-- Type Badge -->
                            <DataGridTemplateColumn Header="Observation Type" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding TypeBadgeBg}" BorderBrush="{Binding TypeBadgeColor}" BorderThickness="1" CornerRadius="12" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ObservationType}" FontWeight="SemiBold" FontSize="11" Foreground="{Binding TypeBadgeColor}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Narrative -->
                            <DataGridTextColumn Header="Observed Behavior" Binding="{Binding NarrativeObservation}" Width="*"/>

                            <!-- Actions Column -->
                            <DataGridTemplateColumn Header="Actions" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Button Content="👁"
                                                    ToolTip="View Details"
                                                    Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="0"
                                                    Foreground="{DynamicResource PrimaryBrush}" FontSize="14"
                                                    Cursor="Hand" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <Button Content="🗑"
                                                    ToolTip="Delete Record"
                                                    Command="{Binding DataContext.DeleteRecordCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="0"
                                                    Foreground="#EF4444" FontSize="14"
                                                    Cursor="Hand" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- 5. NEW ANECDOTAL LOG MODAL DIALOG -->
        <Grid Visibility="{Binding IsAddModalOpen, Converter={StaticResource BoolToVis}}" Background="#80000000">
            <Border Width="560" MaxHeight="680"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1.5"
                    CornerRadius="14"
                    Padding="26"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.4" BlurRadius="30" ShadowDepth="10"/>
                </Border.Effect>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Modal Title -->
                        <TextBlock Text="📝 New Classroom Anecdotal Observation" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Record a private classroom observation, positive conduct note, or early behavior sign." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,16"/>

                        <!-- Error Banner -->
                        <Border Background="{DynamicResource DangerBgBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,12">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ModalErrorMessage}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ModalErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="12" FontWeight="SemiBold"/>
                        </Border>

                        <!-- Student Name -->
                        <TextBlock Text="Student Full Name *" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewStudentName, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="8,0" FontSize="13" Margin="0,0,0,12"/>

                        <!-- Student ID & Grade Section -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Student ID / LRN" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding NewStudentIdNumber, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="8,0" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Grade &amp; Section" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding GradeSectionOptions}" SelectedItem="{Binding NewGradeSection}" Height="36" FontSize="13"/>
                            </StackPanel>
                        </Grid>

                        <!-- Setting & Type -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Setting / Subject" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding SettingOptions}" SelectedItem="{Binding NewSettingOrSubject}" Height="36" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Observation Type" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding ObservationTypeOptions}" SelectedItem="{Binding NewObservationType}" Height="36" FontSize="13"/>
                            </StackPanel>
                        </Grid>

                        <!-- Narrative -->
                        <TextBlock Text="Narrative Observation *" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewNarrativeObservation, UpdateSourceTrigger=PropertyChanged}" Height="75" Padding="8" FontSize="13" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>

                        <!-- Action Taken -->
                        <TextBlock Text="Action Taken / Teacher Note" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewActionTaken, UpdateSourceTrigger=PropertyChanged}" Height="55" Padding="8" FontSize="13" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14"/>

                        <!-- Follow-up Plan & Status -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Follow-up Plan" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding FollowUpPlanOptions}" SelectedItem="{Binding NewFollowUpPlan}" Height="36" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Current Status" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding NewStatus}" Height="36" FontSize="13"/>
                            </StackPanel>
                        </Grid>

                        <!-- Modal Buttons -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1" Content="Cancel" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding CloseAddModalCommand}" Width="100" Height="36" Margin="0,0,10,0"/>
                            <Button Grid.Column="2" Content="Save Record" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding SaveNewRecordCommand}" Width="120" Height="36"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 6. DETAILS MODAL DIALOG -->
        <Grid Visibility="{Binding IsDetailsModalOpen, Converter={StaticResource BoolToVis}}" Background="#80000000">
            <Border Width="580" MaxHeight="680"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1.5"
                    CornerRadius="14"
                    Padding="26"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.4" BlurRadius="30" ShadowDepth="10"/>
                </Border.Effect>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Title & Badges -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding SelectedRecord.StudentName}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text="{Binding SelectedRecord.StudentIdNumber}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="{Binding SelectedRecord.TypeBadgeBg}" BorderBrush="{Binding SelectedRecord.TypeBadgeColor}" BorderThickness="1" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedRecord.ObservationType}" FontWeight="SemiBold" FontSize="12" Foreground="{Binding SelectedRecord.TypeBadgeColor}"/>
                            </Border>
                        </Grid>

                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,16"/>

                        <!-- Details Grid -->
                        <UniformGrid Columns="2" Margin="0,0,0,16">
                            <StackPanel Margin="0,0,10,10">
                                <TextBlock Text="GRADE &amp; SECTION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="{Binding SelectedRecord.GradeSection}" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="10,0,0,10">
                                <TextBlock Text="RECORDING TEACHER" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="{Binding SelectedRecord.TeacherName}" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="DATE &amp; TIME" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="{Binding SelectedRecord.FormattedDate}" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="SETTING / SUBJECT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="{Binding SelectedRecord.SettingOrSubject}" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </UniformGrid>

                        <!-- Narrative Box -->
                        <TextBlock Text="OBSERVED BEHAVIOR NARRATIVE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                            <TextBlock Text="{Binding SelectedRecord.NarrativeObservation}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </Border>

                        <!-- Teacher Action Box -->
                        <TextBlock Text="TEACHER INTERVENTION / ACTION TAKEN" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                            <TextBlock Text="{Binding SelectedRecord.ActionTakenByTeacher}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </Border>

                        <!-- Status & Follow Up -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="FOLLOW-UP PLAN" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="{Binding SelectedRecord.FollowUpPlan}" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="RECORD STATUS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="{Binding SelectedRecord.Status}" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Close Button -->
                        <Button Content="Close Details" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding CloseDetailsModalCommand}" Height="38" HorizontalAlignment="Right" Padding="20,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
