<UserControl x:Class="SmartSchoolIncidentManagementSystem.Views.IncidentCounselingSectionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d">
    <Border Background="{DynamicResource TableHoverBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
        <StackPanel>
            <!-- Section Header -->
            <Grid Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚖️" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Counseling Referrals &amp; Disciplinary Consequences" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                    <TextBlock Text="{Binding DisciplinaryActionsForModal.Count, StringFormat='{}{0} Action(s) Assigned'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </Border>
            </Grid>

            <!-- 1. Existing Actions List -->
            <StackPanel Margin="0,0,0,8">
                <!-- Empty State Notice -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasModalDisciplinaryActions}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="No disciplinary action or counseling referral assigned yet. Complete the form below to assign." FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                </Border>

                <!-- Actions ItemsControl -->
                <ItemsControl ItemsSource="{Binding DisciplinaryActionsForModal}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: Action Type & Status Badge -->
                                    <Grid Grid.Row="0" Margin="0,0,0,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding ActionType}" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="{Binding ScheduledDate, StringFormat='• Scheduled: {0:yyyy-MM-dd}'}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" CornerRadius="4" Padding="6,2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource TableHoverBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                            <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                            <Setter Property="Background" Value="{DynamicResource WarningBgBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>

                                    <!-- Row 1: Details & Notes -->
                                    <StackPanel Grid.Row="1" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding ActionDetails}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding FollowUpNotes, StringFormat='Notes / Observations: {0}'}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,3,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding FollowUpNotes}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Row 2: Guidance / Resolution Controls on each item -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <!-- Confirm Complete Button -->
                                        <Button Content="✓ Confirm Complete"
                                                Command="{Binding DataContext.ConfirmCounselingCompleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Height="24" Padding="8,0" FontSize="10" Margin="0,0,6,0">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- Mark as Resolved Button -->
                                        <Button Content="🎯 Mark Incident as Resolved" Style="{DynamicResource PrimaryButtonStyle}"
                                                Command="{Binding DataContext.ResolveIncidentFromCounselingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Height="24" Padding="8,0" FontSize="10" Margin="0,0,6,0"/>

                                        <!-- Delete Action Button -->
                                        <Button Content="✕" Style="{DynamicResource DangerButtonStyle}"
                                                Command="{Binding DataContext.DeleteModalActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Height="24" Width="24" Padding="0" FontSize="10"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- 2. Assign / Send Counseling Action Form -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                <StackPanel>
                    <TextBlock Text="Assign New Corrective Action / Counseling Referral" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>

                    <!-- Action Type & Scheduled Date & Status -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                            <TextBlock Text="Action Type *" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                            <ComboBox ItemsSource="{Binding ActionTypeOptions}" SelectedItem="{Binding CounselingActionType}" Style="{DynamicResource ModernComboBoxStyle}" Height="28"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,4,0">
                            <TextBlock Text="Scheduled Date *" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                            <DatePicker SelectedDate="{Binding CounselingDate}" Height="28"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Initial Status *" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                            <ComboBox ItemsSource="{Binding ActionStatusOptions}" SelectedItem="{Binding CounselingStatus}" Style="{DynamicResource ModernComboBoxStyle}" Height="28"/>
                        </StackPanel>
                    </Grid>

                    <!-- Requirements / Details -->
                    <TextBlock Text="Requirements / Referral Reason / Objectives *" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                    <TextBox Text="{Binding CounselingDetails, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}" Height="40" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6" Tag="Specify counseling session goals, behavioral conditions, or sanctions..."/>

                    <!-- Follow-Up Notes -->
                    <TextBlock Text="Counselor / Officer Notes &amp; Observations" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                    <TextBox Text="{Binding CounselingNotes, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}" Height="34" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8" Tag="Optional initial notes..."/>

                    <!-- Form Buttons -->
                    <Grid>
                        <TextBlock Text="💡 Saving will set case status to '3. Action Taken' and route to Guidance Counselor." FontSize="9.5" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <Button Content="➕ Send / Assign Action" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding AddCounselingActionCommand}" Height="28" Padding="12,0" FontSize="11" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
