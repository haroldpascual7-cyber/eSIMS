<UserControl x:Class="SmartSchoolIncidentManagementSystem.Views.RestorativeInterventionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1150">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="32,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 1. Header & Navigation Back Button -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="← Back to Overview" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding BackToOverviewCommand}" Margin="0,0,14,0" Padding="12,6"/>
                            <TextBlock Text="Restorative Interventions &amp; Rehabilitation Hub" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Manage community service schedules, behavioral contracts, and guidance counselor referrals." FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="+ Create Intervention Plan" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding OpenAddModalCommand}"/>
                    </StackPanel>
                </Grid>

                <!-- Status Notification Banner -->
                <Border Grid.Row="1" Background="{DynamicResource InfoBgBrush}" BorderBrush="{DynamicResource InfoBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,16">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource InfoBrush}" FontWeight="Medium"/>
                </Border>

                <!-- 2. KPI Summary Cards Grid -->
                <Grid Grid.Row="2" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{DynamicResource CardBorderStyle}" Margin="0,0,12,0" Padding="16,14">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="ACTIVE INTERVENTION PLANS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding ActivePlansCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{DynamicResource CardBorderStyle}" Margin="0,0,12,0" Padding="16,14">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="SERVICE HOURS RENDERED" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding TotalServiceHoursCount, StringFormat='{}{0} Hours'}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{DynamicResource CardBorderStyle}" Margin="0,0,12,0" Padding="16,14">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="PENDING COUNSELING" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding PendingCounselingSessionsCount, StringFormat='{}{0} Sessions'}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Style="{DynamicResource CardBorderStyle}" Padding="16,14">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="CLEARED / COMPLETED" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding ClearedCount}" FontSize="24" FontWeight="Bold" Foreground="#10B981" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 3. Control Toolbar (Search & Filters) -->
                <Border Grid.Row="3" Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,16" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.8*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Search Plans" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                            <TextBox Style="{DynamicResource ModernTextBoxStyle}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="Intervention Type" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                            <ComboBox Style="{DynamicResource ModernComboBoxStyle}" ItemsSource="{Binding TypeFilterOptions}" SelectedItem="{Binding SelectedTypeFilter}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Status" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                            <ComboBox Style="{DynamicResource ModernComboBoxStyle}" ItemsSource="{Binding StatusFilterOptions}" SelectedItem="{Binding SelectedStatusFilter}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 4. Restorative Plans DataGrid -->
                <Border Grid.Row="4" Style="{DynamicResource CardBorderStyle}" Padding="0">
                    <DataGrid ItemsSource="{Binding InterventionPlans}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionMode="Single" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                              Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="{DynamicResource TableRowAltBrush}"
                              Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="0" HeadersVisibility="Column"
                              CanUserResizeRows="False" RowDetailsVisibilityMode="Collapsed" RowHeight="52">

                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="10,10"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <Style TargetType="TextBlock" x:Key="CellTextStyle">
                                <Setter Property="Padding" Value="8,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="12"/>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E0F2FE"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#BAE6FD"/>
                                        <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                        <Setter Property="BorderBrush" Value="#0EA5E9"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Plan ID" Binding="{Binding PlanId}" MinWidth="105" Width="105" ElementStyle="{StaticResource CellTextStyle}"/>
                            <DataGridTextColumn Header="Incident" Binding="{Binding IncidentNumber}" MinWidth="120" Width="120" ElementStyle="{StaticResource CellTextStyle}"/>
                            <DataGridTextColumn Header="Student Details" Binding="{Binding StudentNameAndId}" MinWidth="170" Width="1.4*" ElementStyle="{StaticResource CellTextStyle}"/>
                            <DataGridTextColumn Header="Intervention Type" Binding="{Binding PlanType}" MinWidth="140" Width="1.2*" ElementStyle="{StaticResource CellTextStyle}"/>
                            <DataGridTextColumn Header="Facilitator / Staff" Binding="{Binding AssignedStaff}" MinWidth="135" Width="1.1*" ElementStyle="{StaticResource CellTextStyle}"/>

                            <!-- Progress Column with Bar -->
                            <DataGridTemplateColumn Header="Progress" MinWidth="150" Width="1.3*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="8,0">
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="{Binding ProgressText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{Binding ProgressPercentage, StringFormat='{}{0}%'}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <ProgressBar Value="{Binding ProgressPercentage, Mode=OneWay}" Height="6" Minimum="0" Maximum="100" Foreground="#2563EB" Background="{DynamicResource TableHoverBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Deadline" Binding="{Binding DeadlineDate, StringFormat='{}{0:yyyy-MM-dd}'}" MinWidth="100" Width="100" ElementStyle="{StaticResource CellTextStyle}"/>

                            <!-- Status Badge -->
                            <DataGridTemplateColumn Header="Status" MinWidth="105" Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="8,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#DBEAFE"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                            <Setter Property="Background" Value="#D1FAE5"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Overdue">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#1E40AF"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                <Setter Property="Foreground" Value="#065F46"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Overdue">
                                                                <Setter Property="Foreground" Value="#991B1B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Actions -->
                            <DataGridTemplateColumn Header="Actions" MinWidth="180" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="+ Log Progress" Style="{DynamicResource PrimaryButtonStyle}" Padding="8,4" FontSize="11" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.OpenProgressModalCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="📜 Certificate" Style="{DynamicResource SecondaryButtonStyle}" Padding="8,4" FontSize="11"
                                                    Command="{Binding DataContext.PrintCertificateCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- 5. MODAL POP-UP 1: "+ Create Intervention Plan" -->
        <Grid Background="#80000000">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAddModalOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Style="{DynamicResource CardBorderStyle}" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" CornerRadius="12">
                <StackPanel Orientation="Vertical">
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="Assign Restorative Intervention Plan" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <Button Content="✕" Width="28" Height="28" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding CloseAddModalCommand}"/>
                    </Grid>

                    <Border Background="{DynamicResource DangerBgBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AddErrorMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding AddErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="12" FontWeight="Medium"/>
                    </Border>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Student Name *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                            <TextBox Style="{DynamicResource ModernTextBoxStyle}" Text="{Binding AddStudentName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Student ID Number" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                            <TextBox Style="{DynamicResource ModernTextBoxStyle}" Text="{Binding AddStudentId, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Linked Incident Ref" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                            <ComboBox Style="{DynamicResource ModernComboBoxStyle}" ItemsSource="{Binding AvailableIncidents}" SelectedItem="{Binding AddIncidentNumber}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Intervention Type *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                            <ComboBox Style="{DynamicResource ModernComboBoxStyle}" ItemsSource="{Binding PlanTypeOptions}" SelectedItem="{Binding AddPlanType}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Assigned Facilitator / Counselor" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                            <TextBox Style="{DynamicResource ModernTextBoxStyle}" Text="{Binding AddAssignedStaff, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Target Hours / Sessions *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                            <TextBox Style="{DynamicResource ModernTextBoxStyle}" Text="{Binding AddTargetMetric, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Start Date" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                            <DatePicker SelectedDate="{Binding AddStartDate}" FontSize="13" Padding="6,4"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Completion Deadline" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                            <DatePicker SelectedDate="{Binding AddDeadlineDate}" FontSize="13" Padding="6,4"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Objectives &amp; Specific Tasks *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBox Style="{DynamicResource ModernTextBoxStyle}" Text="{Binding AddObjectives, UpdateSourceTrigger=PropertyChanged}" Height="65" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding CloseAddModalCommand}" Margin="0,0,10,0" Padding="14,6"/>
                        <Button Content="Save &amp; Assign Plan" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding SaveNewPlanCommand}" Padding="14,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 6. MODAL POP-UP 2: "+ Log Hours / Session Notes" -->
        <Grid Background="#80000000">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsProgressModalOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Style="{DynamicResource CardBorderStyle}" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" CornerRadius="12">
                <StackPanel Orientation="Vertical">
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="Log Progress &amp; Counselor Session" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <Button Content="✕" Width="28" Height="28" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding CloseProgressModalCommand}"/>
                    </Grid>

                    <Border Background="{DynamicResource TableHoverBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedPlan.PlanId, StringFormat='PLAN ID: {0}'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                            <TextBlock Text="{Binding SelectedPlan.StudentNameAndId, StringFormat='Student: {0}'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource DangerBgBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ProgressErrorMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ProgressErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="12" FontWeight="Medium"/>
                    </Border>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Units Rendered (+Hours/Sessions) *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                            <TextBox Style="{DynamicResource ModernTextBoxStyle}" Text="{Binding ProgressUnits, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Session Date" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                            <DatePicker SelectedDate="{Binding ProgressLogDate}" FontSize="13" Padding="6,4"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Supervisor / Counselor in Charge" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBox Style="{DynamicResource ModernTextBoxStyle}" Text="{Binding ProgressStaffName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Session Notes / Student Reflection *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBox Style="{DynamicResource ModernTextBoxStyle}" Text="{Binding ProgressNotes, UpdateSourceTrigger=PropertyChanged}" Height="65" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </StackPanel>

                    <CheckBox Content="Mark Plan as Fully Completed &amp; Issue Clearance" IsChecked="{Binding ProgressMarkCompleted}" Margin="0,0,0,16" FontSize="12" FontWeight="SemiBold" Foreground="#10B981"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding CloseProgressModalCommand}" Margin="0,0,10,0" Padding="14,6"/>
                        <Button Content="Update Progress" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding SaveProgressCommand}" Padding="14,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
