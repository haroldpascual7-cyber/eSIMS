<UserControl x:Class="SmartSchoolIncidentManagementSystem.Views.IncidentListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1200"
             Background="{DynamicResource AppBackgroundBrush}"
             ClipToBounds="False">

    <Grid Margin="0" ClipToBounds="False">
        <!-- Inner Workspace Content -->
        <Grid Margin="24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

        <!-- 1. WORKSPACE HEADER & ACTIONS -->
        <Border Grid.Row="0" Style="{DynamicResource CardBorderStyle}" Padding="18,14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🚨" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Incidents Records &amp; Intelligence Log" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </StackPanel>
                    <TextBlock Text="Standardized incident intake, automated rule-based risk classification, and case monitoring." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="+ Report New Incident" Style="{DynamicResource PrimaryButtonStyle}"
                            Command="{Binding NewIncidentCommand}" Margin="0,0,8,0" Height="36"
                            Visibility="{Binding CanManageIncidents, Converter={StaticResource BoolToVis}}"/>

                    <Button Content="↻ Refresh" Style="{DynamicResource SecondaryButtonStyle}"
                            Command="{Binding RefreshCommand}" Height="36"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. SEARCH & MULTI-FILTER TOOLBAR -->
        <Border Grid.Row="1" Style="{DynamicResource CardBorderStyle}" Padding="14,10" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Search (Incident #, Student, Title, Narrative)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}" Height="34"/>
                </StackPanel>

                <!-- Category Filter -->
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="Category" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding CategoryFilterOptions}" SelectedItem="{Binding SelectedCategoryFilter}" Style="{DynamicResource ModernComboBoxStyle}" Height="34"/>
                </StackPanel>

                <!-- Status Filter -->
                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="Lifecycle Status" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding StatusFilterOptions}" SelectedItem="{Binding SelectedStatusFilter}" Style="{DynamicResource ModernComboBoxStyle}" Height="34"/>
                </StackPanel>

                <!-- Severity Filter -->
                <StackPanel Grid.Column="3" Margin="0,0,10,0">
                    <TextBlock Text="Severity" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding SeverityFilterOptions}" SelectedItem="{Binding SelectedSeverityFilter}" Style="{DynamicResource ModernComboBoxStyle}" Height="34"/>
                </StackPanel>

                <!-- Reset Button -->
                <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                    <Button Content="Clear Filters" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding ClearFiltersCommand}" Height="34" Padding="12,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. INCIDENTS (4-COLUMN RESPONSIVE CARDS) -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Incidents}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{DynamicResource RecordCardStyle}">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.ViewIncidentDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"/>
                            </Border.InputBindings>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Top Row: Incident Number & Severity -->
                                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                    <Border CornerRadius="4" Padding="6,2" Background="{DynamicResource PrimaryBrush}" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding IncidentNumber}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ButtonTextBrush}"/>
                                    </Border>
                                    <Border CornerRadius="4" Padding="6,2" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Severity}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    </Border>
                                </DockPanel>

                                <!-- Title -->
                                <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>

                                <!-- Student Name -->
                                <TextBlock Grid.Row="2" Text="{Binding StudentDisplayName, StringFormat='👨‍🎓 {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>

                                <!-- Category & Date -->
                                <StackPanel Grid.Row="3" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Category, StringFormat='📁 {0}'}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding IncidentDate, StringFormat='📅 {0:yyyy-MM-dd HH:mm}'}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Bottom Badges: Risk & Status -->
                                <DockPanel Grid.Row="4">
                                    <Border CornerRadius="4" Padding="5,1" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Risk, StringFormat='Risk: {0}'}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </Border>
                                    <Border CornerRadius="4" Padding="6,2" Background="{DynamicResource SurfaceBackgroundBrush}" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
                                    </Border>
                                </DockPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        </Grid>

        <!-- 4. MODAL OVERLAY: CREATE / VIEW / EDIT INCIDENT WITH LIVE RULE ENGINE -->
        <Grid Margin="-260,-60,-20,-20" Panel.ZIndex="1000" Visibility="{Binding IsIncidentModalOpen, Converter={StaticResource BoolToVis}}" Background="{DynamicResource ModalOverlayBrush}">
            <Border Width="840" MaxHeight="720" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ModalTitle}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                <TextBlock Text="{Binding ModalIncidentNumber}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ButtonTextBrush}"/>
                            </Border>
                        </StackPanel>
                        <Button Content="✕" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding CancelModalCommand}"
                                HorizontalAlignment="Right" Width="30" Height="30" Padding="0"/>
                    </Grid>

                    <!-- Scrollable Form with Rule Engine and Email Integration -->
                    <ScrollViewer Grid.Row="1" MaxHeight="520" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Error Notice -->
                            <Border Background="{DynamicResource DangerBgBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="10" Margin="0,0,0,12"
                                    Visibility="{Binding ModalErrorMessage, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="{Binding ModalErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </Border>

                            <!-- SECTION 1: STUDENT SELECTION -->
                            <Border Background="{DynamicResource TableHoverBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="1. Student Information" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="Primary Involved Student *" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding ModalStudentName, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}" Height="34" IsReadOnly="{Binding IsModalReadOnly}"/>
                                            <!-- Auto-Suggestions Dropdown -->
                                            <ListBox ItemsSource="{Binding StudentSuggestions}" Visibility="{Binding IsStudentSuggestionsOpen, Converter={StaticResource BoolToVis}}"
                                                     MaxHeight="120" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,2,0,0">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding DisplayName}" Style="{DynamicResource SecondaryButtonStyle}"
                                                                Command="{Binding DataContext.SelectStudentSuggestionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                CommandParameter="{Binding}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="28" Padding="6,0"/>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                            <TextBlock Text="Grade &amp; Section" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding ModalGradeSection}" Style="{DynamicResource ModernTextBoxStyle}" Height="34" IsReadOnly="True"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Parent Email (Auto-Retrieved)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding ModalParentEmail}" Style="{DynamicResource ModernTextBoxStyle}" Height="34" IsReadOnly="True"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 2: INCIDENT DETAILS -->
                            <Border Background="{DynamicResource TableHoverBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="2. Incident Overview" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="Incident Title *" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding ModalTitleField, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}" Height="34" IsReadOnly="{Binding IsModalReadOnly}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                            <TextBlock Text="Incident Category" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding ModalCategory}" Style="{DynamicResource ModernComboBoxStyle}" Height="34" IsEnabled="{Binding IsModalEditing}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Location / Zone" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding ModalLocation, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}" Height="34" IsReadOnly="{Binding IsModalReadOnly}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="2*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="Date of Incident" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                            <DatePicker SelectedDate="{Binding ModalDate}" Style="{DynamicResource ModernDatePickerStyle}" Height="34" IsEnabled="{Binding IsModalEditing}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                            <TextBlock Text="Time (HH:mm)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding ModalTime}" Style="{DynamicResource ModernTextBoxStyle}" Height="34" IsReadOnly="{Binding IsModalReadOnly}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Reporting Staff / Teacher" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding ModalReporter}" Style="{DynamicResource ModernTextBoxStyle}" Height="34" IsReadOnly="{Binding IsModalReadOnly}"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Incident Narrative / Description *" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding ModalDescription, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}" Height="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" IsReadOnly="{Binding IsModalReadOnly}"/>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 3: RULE-BASED DECISION SUPPORT -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="⚡ Rule Engine Assessment" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                                            <TextBlock Text=" (Automated Classification &amp; Risk Scoring)" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button Content="Apply Recommendations" Style="{DynamicResource SecondaryButtonStyle}"
                                                Command="{Binding ApplyRuleRecommendationsCommand}" HorizontalAlignment="Right" Height="28" Padding="8,0" FontSize="11"
                                                IsEnabled="{Binding IsModalEditing}"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{DynamicResource TableHoverBrush}" CornerRadius="4" Padding="8,6" Margin="0,0,6,0">
                                            <StackPanel>
                                                <TextBlock Text="Suggested Category" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                <TextBlock Text="{Binding LiveSuggestedCategory}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Background="{DynamicResource TableHoverBrush}" CornerRadius="4" Padding="8,6" Margin="0,0,6,0">
                                            <StackPanel>
                                                <TextBlock Text="Recommended Severity" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                <TextBlock Text="{Binding LiveSuggestedSeverity}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Background="{DynamicResource TableHoverBrush}" CornerRadius="4" Padding="8,6">
                                            <StackPanel>
                                                <TextBlock Text="Assessed Risk Level" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                <TextBlock Text="{Binding LiveSuggestedRisk}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Repeat Offender Alert if Triggered -->
                                    <Border Background="{DynamicResource DangerBgBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                                            CornerRadius="4" Padding="8,6" Margin="0,0,0,8" Visibility="{Binding IsRepeatOffenderAlert, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding RepeatAlertMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 4: ACTIONS & CONFLICT RESOLUTION -->
                            <Border Background="{DynamicResource TableHoverBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="3. Action &amp; Consequence" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="Action Taken / Resolution Terms" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding ModalActionTaken}" Style="{DynamicResource ModernTextBoxStyle}" Height="34" IsReadOnly="{Binding IsModalReadOnly}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Incident Lifecycle Status" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding StatusFilterOptions}" SelectedItem="{Binding ModalStatus}" Style="{DynamicResource ModernComboBoxStyle}" Height="34" IsEnabled="{Binding IsModalEditing}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 5: AUTOMATED PARENT EMAIL DISPATCH -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <CheckBox Content="Dispatch Automated Parent Email Notification Upon Saving"
                                                  IsChecked="{Binding SendParentNotification}" FontWeight="Bold"
                                                  Foreground="{DynamicResource PrimaryTextBrush}" IsEnabled="{Binding IsModalEditing}"/>
                                        <TextBlock Text="An official email disclosure will be automatically transmitted to the parent's stored email address." FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="20,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding NotificationStatusText}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Actions -->
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <!-- In Read-Only View: Edit Button -->
                            <Button Content="✏️ Edit Incident" Style="{DynamicResource SecondaryButtonStyle}"
                                    Command="{Binding ToggleEditModeCommand}" Margin="0,0,8,0" Height="36"
                                    Visibility="{Binding IsModalReadOnly, Converter={StaticResource BoolToVis}}"/>

                            <!-- In Edit Mode: Cancel Edit (if existing record) -->
                            <Button Content="✕ Cancel Edit" Style="{DynamicResource SecondaryButtonStyle}"
                                    Command="{Binding CancelEditModeCommand}" Margin="0,0,8,0" Height="36"
                                    Visibility="{Binding CanCancelEdit, Converter={StaticResource BoolToVis}}"/>

                            <!-- In-Modal Delete Button -->
                            <Button Content="🗑️ Delete Incident" Style="{DynamicResource DangerButtonStyle}"
                                    Command="{Binding DeleteCurrentModalIncidentCommand}" Margin="0,0,8,0" Height="36"
                                    Visibility="{Binding CanDeleteModalIncident, Converter={StaticResource BoolToVis}}"/>

                            <!-- In-Modal Open Investigation Button -->
                            <Button Content="🔍 Investigate Case" Style="{DynamicResource PrimaryButtonStyle}"
                                    Command="{Binding InvestigateCurrentModalIncidentCommand}" Height="36"
                                    Visibility="{Binding CanInvestigateModalIncident, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="Close" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding CancelModalCommand}" Margin="0,0,8,0" Height="36"/>
                            <Button Content="{Binding SaveModalButtonText}" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding SaveModalCommand}" Height="36"
                                    Visibility="{Binding IsModalEditing, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>