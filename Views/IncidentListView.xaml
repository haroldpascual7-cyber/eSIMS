<UserControl x:Class="SmartSchoolIncidentManagementSystem.Views.IncidentListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:views="clr-namespace:SmartSchoolIncidentManagementSystem.Views"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1200"
             Background="{DynamicResource AppBackgroundBrush}"
             ClipToBounds="False">

    <Grid Margin="0" ClipToBounds="False">
        <!-- Inner Workspace Content -->
        <Grid Margin="20,12,20,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

        <!-- 1. UNIFIED FLAT TOOLBAR (no boxed headers, no redundant title) -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Search incidents" Style="{DynamicResource ModernTextBoxStyle}" Height="34" Margin="0,0,8,0"/>

            <ComboBox Grid.Column="1" ItemsSource="{Binding CategoryFilterOptions}" SelectedItem="{Binding SelectedCategoryFilter}"
                      Style="{DynamicResource ModernComboBoxStyle}" Height="34" Margin="0,0,8,0"/>

            <ComboBox Grid.Column="2" ItemsSource="{Binding StatusFilterOptions}" SelectedItem="{Binding SelectedStatusFilter}"
                      Style="{DynamicResource ModernComboBoxStyle}" Height="34" Margin="0,0,8,0"/>

            <ComboBox Grid.Column="3" ItemsSource="{Binding SeverityFilterOptions}" SelectedItem="{Binding SelectedSeverityFilter}"
                      Style="{DynamicResource ModernComboBoxStyle}" Height="34" Margin="0,0,8,0"/>

            <Button Grid.Column="4" Content="Clear" Style="{DynamicResource SecondaryButtonStyle}"
                    Command="{Binding ClearFiltersCommand}" Height="34" Padding="12,0" Margin="0,0,8,0"/>

            <Button Grid.Column="5" Content="+ Report New Incident" Style="{DynamicResource PrimaryButtonStyle}"
                    Command="{Binding NewIncidentCommand}" Margin="0,0,8,0" Height="34"
                    Visibility="{Binding CanManageIncidents, Converter={StaticResource BoolToVis}}"/>

            <Button Grid.Column="6" Style="{DynamicResource SecondaryButtonStyle}"
                    Command="{Binding RefreshCommand}" Height="34" MinWidth="104" IsEnabled="{Binding IsNotLoading}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="&#x21BB;"
                                   FontSize="13"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVis}}"/>
                        <Grid Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                            <Ellipse Stroke="{DynamicResource BorderBrush}" StrokeThickness="2"/>
                            <Path x:Name="RefreshButtonLoadingSpinner"
                                  Data="M 9,2 A 7,7 0 0 1 16,9"
                                  Stroke="{DynamicResource PrimaryBrush}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Path.RenderTransform>
                                <Path.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="RefreshButtonLoadingSpinner"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                 From="0" To="360" Duration="0:0:0.75"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Path.Triggers>
                            </Path>
                        </Grid>
                    </Grid>
                    <TextBlock Text="{Binding RefreshButtonText}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- 2. INCIDENTS (4-COLUMN RESPONSIVE CARDS) -->
        <Grid Grid.Row="1">
            <!-- Empty State Display -->
            <Border Visibility="{Binding HasNoIncidents, Converter={StaticResource BoolToVis}}"
                    Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="36,28" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="📋" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="No incidents found" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="No incidents match." FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Incidents}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{DynamicResource RecordCardStyle}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.ViewIncidentDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Top Row: Incident Number & Severity -->
                                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                        <Border CornerRadius="4" Padding="6,2" Background="{DynamicResource PrimaryBrush}" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding IncidentNumber}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ButtonTextBrush}"/>
                                        </Border>
                                        <Border CornerRadius="4" Padding="6,2" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Severity}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        </Border>
                                    </DockPanel>

                                    <!-- Title -->
                                    <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>

                                    <!-- Student Name -->
                                    <TextBlock Grid.Row="2" Text="{Binding StudentDisplayName, StringFormat='👨‍🎓 {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>

                                    <!-- Category & Date -->
                                    <StackPanel Grid.Row="3" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Category, StringFormat='📁 {0}'}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding IncidentDate, StringFormat='📅 {0:yyyy-MM-dd HH:mm}'}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Bottom Badges: Risk & Status -->
                                    <DockPanel Grid.Row="4">
                                        <Border CornerRadius="4" Padding="5,1" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Risk, StringFormat='Risk: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </Border>
                                        <Border CornerRadius="4" Padding="6,2" Background="{DynamicResource SurfaceBackgroundBrush}" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
                                        </Border>
                                    </DockPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Interactive loading overlay for refresh/search/filter reloads -->
        <Grid Grid.RowSpan="3"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="20"
              IsHitTestVisible="True">
            <Border Background="{DynamicResource AppBackgroundBrush}" Opacity="0.78" CornerRadius="8"/>
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource PrimaryBrush}"
                    BorderThickness="1.5"
                    CornerRadius="8"
                    Padding="30,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <Grid Width="68" Height="68" HorizontalAlignment="Center" Margin="0,0,0,14">
                        <Ellipse Stroke="{DynamicResource BorderBrush}" StrokeThickness="5" Opacity="0.65"/>
                        <Path x:Name="IncidentLoadingSpinner"
                              Data="M 34,7 A 27,27 0 0 1 61,34"
                              Stroke="{DynamicResource PrimaryBrush}"
                              StrokeThickness="5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform Angle="0"/>
                            </Path.RenderTransform>
                            <Path.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="IncidentLoadingSpinner"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                             From="0" To="360" Duration="0:0:0.85"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Path.Triggers>
                        </Path>
                    </Grid>
                    <TextBlock Text="{Binding LoadingStatusText}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Loading incidents."
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,14"/>
                    <ProgressBar Width="260"
                                 Height="6"
                                 IsIndeterminate="True"
                                 Foreground="{DynamicResource PrimaryBrush}"
                                 Background="{DynamicResource BorderBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"/>
                </StackPanel>
            </Border>
        </Grid>
        </Grid>

        <!-- 4. MODAL OVERLAY: INCIDENT RECORD (INVOLVED PERSONS, WITNESSES, EVIDENCE & RULE ENGINE) -->
        <views:IncidentRecordModalControl Margin="-260,-60,-20,-20" Panel.ZIndex="1000"/>
    </Grid>
</UserControl>
