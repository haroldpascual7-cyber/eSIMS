<UserControl x:Class="SmartSchoolIncidentManagementSystem.Views.ParentNoticesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:views="clr-namespace:SmartSchoolIncidentManagementSystem.Views"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1200"
             ClipToBounds="False">
    <Grid Background="{DynamicResource AppBackgroundBrush}" ClipToBounds="False">
        <!-- Main Workspace Layout -->
        <Grid Margin="32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. Header & Actions -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Parent Notices &amp; Official Disclosures" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="Manage formal summons, disciplinary notifications, email dispatches, and signed acknowledgment slips." FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsNotRefreshing}"
                            Content="{Binding RefreshButtonText, FallbackValue='↻ Refresh'}"
                            Margin="0,0,8,0" Height="36" Padding="14,0" FontSize="12.5" FontWeight="SemiBold" ToolTip="Refresh Notice Registry"/>
                    <Button Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding ExportOverdueReportCommand}" Margin="0,0,8,0" Height="36" Padding="14,0" ToolTip="Export Overdue Compliance Report (PDF)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📑" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Overdue Report (PDF)" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding OpenCreateNoticeCommand}" Height="36" Padding="16,0" ToolTip="Compose and dispatch new official parent notice">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="✉️" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="+ Send Parent Notice" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource ButtonTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. Metric KPI Cards -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{DynamicResource CardBorderStyle}" Margin="0,0,8,0" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="TOTAL DISPATCHES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Text="{Binding TotalDispatchedCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{DynamicResource CardBorderStyle}" Margin="4,0,4,0" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="PENDING RECEIPT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                        <TextBlock Text="{Binding PendingCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{DynamicResource CardBorderStyle}" Margin="4,0,4,0" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="OVERDUE COMPLIANCE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/>
                        <TextBlock Text="{Binding OverdueCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{DynamicResource CardBorderStyle}" Margin="8,0,0,0" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="ACKNOWLEDGED / SIGNED" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                        <TextBlock Text="{Binding AcknowledgedCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. Search & Toolbar -->
            <Border Grid.Row="2" Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,16" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Input with Magnifying Glass -->
                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <TextBox Style="{DynamicResource ModernTextBoxStyle}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="30,0,10,0" VerticalContentAlignment="Center"/>
                        <TextBlock Text="🔍" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                        <TextBlock Text="Search notices, students, remarks..." FontSize="12" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="32,0,0,0" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Status Filter ComboBox -->
                    <ComboBox Grid.Column="1" Style="{DynamicResource ModernComboBoxStyle}" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatusFilter}" Height="36" VerticalContentAlignment="Center"/>

                    <!-- Right Quick Count Pill -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="{DynamicResource TableHoverBrush}" CornerRadius="6" Padding="12,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📋 Official Records in View: " FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="{Binding FilteredNotices.Count}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 4. Tabbed Content: Registry vs Dispatch Log vs Templates -->
            <TabControl Grid.Row="3" Background="Transparent" BorderThickness="0">
                <!-- Tab 1: Notice Registry & Acknowledgments -->
                <TabItem Header="📋 Notice Registry &amp; Slips" FontSize="13" FontWeight="SemiBold">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                        <ItemsControl ItemsSource="{Binding FilteredNotices}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{DynamicResource RecordCardStyle}">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.OpenNoticeCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                                <Border CornerRadius="4" Padding="6,2" Background="{DynamicResource PrimaryBrush}" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding NoticeId}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ButtonTextBrush}"/>
                                                </Border>
                                                <Border CornerRadius="4" Padding="6,2" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding DisplayStatus}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                </Border>
                                            </DockPanel>
                                            <TextBlock Grid.Row="1" Text="{Binding StudentName}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                                            <StackPanel Grid.Row="2" Margin="0,0,0,6">
                                                <TextBlock Text="{Binding IssueDate, StringFormat='Issued: {0}'}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                <TextBlock Text="{Binding DueDate, StringFormat='Due: {0}'}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Row="3" Text="{Binding Remarks}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" MaxHeight="30"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 2: Dispatch Activity Log -->
                <TabItem Header="📡 Direct Dispatches (SMS &amp; Email)" FontSize="13" FontWeight="SemiBold">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                        <ItemsControl ItemsSource="{Binding RecentDispatches}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{DynamicResource RecordCardStyle}">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.OpenDispatchCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                                <Border CornerRadius="4" Padding="6,2" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Channel}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                </Border>
                                                <Border CornerRadius="4" Padding="5,1" Background="{DynamicResource SurfaceBackgroundBrush}" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
                                                </Border>
                                            </DockPanel>
                                            <TextBlock Grid.Row="1" Text="{Binding GuardianName}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,2"/>
                                            <TextBlock Grid.Row="2" Text="{Binding StudentId, StringFormat='ID: {0}'}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                                            <TextBlock Grid.Row="3" Text="{Binding MessageBody}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" MaxHeight="30"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 3: Official Templates -->
                <TabItem Header="📄 Letter Templates" FontSize="13" FontWeight="SemiBold">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                        <ItemsControl ItemsSource="{Binding EnhancedTemplates}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{DynamicResource RecordCardStyle}" Margin="6" Padding="16">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- 1. Header Badges -->
                                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                                <Border CornerRadius="4" Padding="6,2" Background="{DynamicResource TableHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding DocumentBadge}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                                                </Border>
                                                <Border CornerRadius="4" Padding="5,2" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding ReferenceCode}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                </Border>
                                            </DockPanel>

                                            <!-- 2. Letter Title -->
                                            <DockPanel Grid.Row="1" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Icon}" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding TemplateName}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            </DockPanel>

                                            <!-- 3. Subtitle / Department -->
                                            <TextBlock Grid.Row="2" Text="REPUBLIC OF THE PHILIPPINES • SMART ACADEMY" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" Margin="21,0,0,8"/>

                                            <!-- 4. Realistic Letter Sheet Preview Box -->
                                            <Border Grid.Row="3" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="OFFICE OF STUDENT AFFAIRS &amp; GUIDANCE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding SampleExcerpt}" FontSize="10.5" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis" LineHeight="15"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- 5. Tear-Off Slip Indicator -->
                                            <StackPanel Grid.Row="4" Margin="0,0,0,10">
                                                <TextBlock Text="✂ - - - - - - - - - - - - - - - - - - - - - - - - - - - - - ✂" FontSize="8" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Includes Official Parent Acknowledgment Slip" FontSize="9" FontStyle="Italic" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- 6. Bottom Action Buttons Bar -->
                                            <Grid Grid.Row="5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Content="👁️ Preview Letter" Style="{DynamicResource SecondaryButtonStyle}" Height="32" Padding="0" Margin="0,0,4,0" FontSize="11.5" FontWeight="SemiBold"
                                                        Command="{Binding DataContext.PreviewTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Grid.Column="1" Content="✉️ Dispatch" Style="{DynamicResource PrimaryButtonStyle}" Height="32" Padding="0" Margin="4,0,0,0" FontSize="11.5" FontWeight="Bold"
                                                        Command="{Binding DataContext.UseTemplateInNoticeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Template}"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- MODAL 1: Create / Send Parent Notice -->
        <Grid Margin="-260,-60,-20,-20" Panel.ZIndex="1000" Background="{DynamicResource ModalOverlayBrush}"
              Visibility="{Binding IsCreateNoticeModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{DynamicResource CardBorderStyle}" Width="650" MaxHeight="780" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Modal Title -->
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="✉️ Create &amp; Dispatch Parent Notice" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <Button Content="✕" Style="{DynamicResource SecondaryButtonStyle}" HorizontalAlignment="Right" Command="{Binding CloseCreateNoticeCommand}" Width="30" Height="30" Padding="0"/>
                        </Grid>

                        <!-- Student Search / Selection -->
                        <TextBlock Text="Student Recipient (Search Name or ID):" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBox Style="{DynamicResource ModernTextBoxStyle}" Text="{Binding StudentSearchInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>

                        <Border Visibility="{Binding IsStudentSuggestionsOpen, Converter={StaticResource BoolToVis}}"
                                Style="{DynamicResource CardBorderStyle}" Padding="4" Margin="0,0,0,8" MaxHeight="140">
                            <ListBox ItemsSource="{Binding StudentSuggestions}" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{DynamicResource SecondaryButtonStyle}" HorizontalContentAlignment="Left" Margin="0,2"
                                                Command="{Binding DataContext.SelectStudentCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="{Binding FullName}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <!-- Guardian Details -->
                        <Grid Margin="0,4,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Guardian Name:" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBox Style="{DynamicResource ModernTextBoxStyle}" Text="{Binding GuardianName}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Guardian Email:" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBox Style="{DynamicResource ModernTextBoxStyle}" Text="{Binding GuardianEmail}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Guardian Contact Phone:" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBox Style="{DynamicResource ModernTextBoxStyle}" Text="{Binding GuardianPhone}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Dispatch Channel:" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <ComboBox Style="{DynamicResource ModernComboBoxStyle}" ItemsSource="{Binding ChannelOptions}" SelectedItem="{Binding SelectedChannel}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Template Selection -->
                        <TextBlock Text="Notice Template:" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,4"/>
                        <ComboBox Style="{DynamicResource ModernComboBoxStyle}" ItemsSource="{Binding Templates}" DisplayMemberPath="TemplateName" SelectedItem="{Binding ModalSelectedTemplate}" Margin="0,0,0,8"/>

                        <!-- Subject -->
                        <TextBlock Text="Subject Line:" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBox Style="{DynamicResource ModernTextBoxStyle}" Text="{Binding NoticeSubject}" Margin="0,0,0,8"/>

                        <!-- Body -->
                        <TextBlock Text="Notice Message Body:" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBox Style="{DynamicResource ModernTextBoxStyle}" Text="{Binding NoticeBody}" AcceptsReturn="True" TextWrapping="Wrap" Height="140" Margin="0,0,0,16"/>

                        <!-- Actions -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding CloseCreateNoticeCommand}" Margin="0,0,8,0" Width="90"/>
                            <Button Content="🚀 Send Notice" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding SendNoticeCommand}" Width="130"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- MODAL 2: Log Acknowledgment Receipt -->
        <Grid Margin="-260,-60,-20,-20" Panel.ZIndex="1000" Background="{DynamicResource ModalOverlayBrush}"
              Visibility="{Binding IsLogReceiptModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{DynamicResource CardBorderStyle}" Width="500" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="📋 Log Acknowledgment Receipt" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <Button Content="✕" Style="{DynamicResource SecondaryButtonStyle}" HorizontalAlignment="Right" Command="{Binding CloseLogReceiptCommand}" Width="30" Height="30" Padding="0"/>
                    </Grid>

                    <TextBlock Text="{Binding EditingLog.NoticeId, StringFormat='Notice Reference: {0}'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding EditingLog.StudentName, StringFormat='Student: {0}'}" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,12"/>

                    <!-- Compliance Status -->
                    <TextBlock Text="Acknowledgment Status:" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                    <ComboBox Style="{DynamicResource ModernComboBoxStyle}" ItemsSource="{Binding ComplianceOptions}" SelectedItem="{Binding SelectedComplianceStatus}" Margin="0,0,0,10"/>

                    <!-- Date Acknowledged -->
                    <TextBlock Text="Date Acknowledged:" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding DateAcknowledged}" Margin="0,0,0,10"/>

                    <!-- Attached Slip File -->
                    <TextBlock Text="Attached Signed Slip / Proof (Optional):" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{DynamicResource ModernTextBoxStyle}" Text="{Binding AttachedFilePath}" IsReadOnly="True" Margin="0,0,6,0"/>
                        <Button Grid.Column="1" Content="Browse..." Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding BrowseSlipFileCommand}"/>
                    </Grid>

                    <!-- Remarks -->
                    <TextBlock Text="Remarks / Meeting Notes:" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                    <TextBox Style="{DynamicResource ModernTextBoxStyle}" Text="{Binding SlipRemarks}" AcceptsReturn="True" TextWrapping="Wrap" Height="70" Margin="0,0,0,16"/>

                    <!-- Actions -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding CloseLogReceiptCommand}" Margin="0,0,8,0" Width="90"/>
                        <Button Content="💾 Save Receipt" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding SaveReceiptCommand}" Width="120"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MODAL 3: Notice Details & In-Modal Actions -->
        <Grid Margin="-260,-60,-20,-20" Panel.ZIndex="1000" Background="{DynamicResource ModalOverlayBrush}"
              Visibility="{Binding IsViewNoticeModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{DynamicResource CardBorderStyle}" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ViewingNotice.NoticeId}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <Border CornerRadius="4" Padding="6,2" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="10,0,0,0">
                                <TextBlock Text="{Binding ViewingNotice.DisplayStatus}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </Border>
                        </StackPanel>
                        <Button Content="✕" Style="{DynamicResource SecondaryButtonStyle}" HorizontalAlignment="Right" Command="{Binding CloseNoticeCardCommand}" Width="30" Height="30" Padding="0"/>
                    </DockPanel>

                    <TextBlock Text="{Binding ViewingNotice.StudentName, StringFormat='Student: {0}'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding ViewingNotice.IssueDate, StringFormat='Issue Date: {0}'}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding ViewingNotice.DueDate, StringFormat='Due Date: {0}'}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </Grid>
                    <TextBlock Text="{Binding ViewingNotice.DateAcknowledged, StringFormat='Acknowledged: {0}'}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8"/>

                    <TextBlock Text="Notice Remarks / Details:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <Border Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,4,0,16">
                        <TextBlock Text="{Binding ViewingNotice.Remarks}" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap"/>
                    </Border>

                    <!-- In-Modal CRUD & Workflow Options -->
                    <DockPanel>
                        <Button Content="🗑️ Delete Notice" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding DeleteNoticeCommand}" Foreground="{DynamicResource DangerBrush}" DockPanel.Dock="Left" Height="34"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="📋 Log Receipt" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding InModalLogReceiptCommand}" Margin="0,0,8,0" Height="34"/>
                            <Button Content="📄 Export PDF" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding InModalExportPdfCommand}" Margin="0,0,8,0" Height="34"/>
                            <Button Content="Close" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding CloseNoticeCardCommand}" Height="34" Width="70"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MODAL 4: Dispatch Activity Details -->
        <Grid Margin="-260,-60,-20,-20" Panel.ZIndex="1000" Background="{DynamicResource ModalOverlayBrush}"
              Visibility="{Binding IsViewDispatchModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{DynamicResource CardBorderStyle}" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <TextBlock Text="📡 Direct Dispatch Details" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <Button Content="✕" Style="{DynamicResource SecondaryButtonStyle}" HorizontalAlignment="Right" Command="{Binding CloseDispatchCardCommand}" Width="30" Height="30" Padding="0"/>
                    </DockPanel>
                    <TextBlock Text="{Binding ViewingDispatch.GuardianName, StringFormat='Recipient: {0}'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding ViewingDispatch.StudentId, StringFormat='Student ID: {0}'}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding ViewingDispatch.Channel, StringFormat='Channel: {0}'}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding ViewingDispatch.ContactDestination, StringFormat='Destination: {0}'}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding ViewingDispatch.FormattedDate, StringFormat='Timestamp: {0}'}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8"/>

                    <TextBlock Text="Dispatched Message:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <Border Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,4,0,16">
                        <TextBlock Text="{Binding ViewingDispatch.MessageBody}" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap"/>
                    </Border>
                    <Button Content="Close" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding CloseDispatchCardCommand}" HorizontalAlignment="Right" Height="32" Width="80"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MODAL 5: Letter Template Sheet Preview -->
        <views:LetterTemplateSheetPreviewModal Visibility="{Binding IsViewTemplateModalOpen, Converter={StaticResource BoolToVis}}"/>
    </Grid>
</UserControl>
