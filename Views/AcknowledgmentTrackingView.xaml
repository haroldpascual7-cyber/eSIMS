<UserControl x:Class="SmartSchoolIncidentManagementSystem.Views.AcknowledgmentTrackingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SmartSchoolIncidentManagementSystem.Views"
             Background="{DynamicResource AppBackgroundBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="32,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <Button Content="&#x2190; Back to Parent Notices Hub" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding BackToHubCommand}" HorizontalAlignment="Left" Padding="10,4" Margin="0,0,0,10"/>
                    <TextBlock Text="Parent Acknowledgment &amp; Disclosure Tracking" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="Track signed parent response slips, physical meeting attendance, and electronic disclosure receipts." FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- TOP KPI RIBBON (3 Cards) -->
                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- KPI 1: Pending Signatures -->
                    <Border Grid.Column="0" Style="{DynamicResource CardBorderStyle}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="PENDING SIGNATURES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding PendingCount}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" Margin="0,6,0,0"/>
                            <TextBlock Text="Awaiting parent response slip" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- KPI 2: Overdue Compliance -->
                    <Border Grid.Column="2" Style="{DynamicResource CardBorderStyle}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="OVERDUE COMPLIANCE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding OverdueCount}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" Margin="0,6,0,0"/>
                            <TextBlock Text="Exceeded deadline date" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- KPI 3: Conferences Completed -->
                    <Border Grid.Column="4" Style="{DynamicResource CardBorderStyle}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="ACKNOWLEDGED / COMPLETED" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding CompletedCount}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,6,0,0"/>
                            <TextBlock Text="Signed slip or meeting verified" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- CONTROL TOOLBAR -->
                <Grid Grid.Row="2" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Input -->
                    <Grid Grid.Column="0">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}" Padding="28,0,24,0" Height="36"/>
                        <TextBlock Text="🔍" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False"/>
                        <Button Content="✕" Command="{Binding ClearSearchCommand}" Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource SecondaryTextBrush}" Cursor="Hand" Width="20" Height="20"/>
                    </Grid>

                    <!-- Filter ComboBox & Export Button -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Status Filter:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatusFilter}" Width="140" Height="36" VerticalContentAlignment="Center" Margin="0,0,12,0"/>
                        
                        <!-- Export Overdue Report PDF Button -->
                        <Button Content="🖨️ Export Overdue Report (PDF)"
                                Command="{Binding ExportOverdueReportCommand}"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource DangerBrush}"
                                BorderThickness="1"
                                Foreground="{DynamicResource DangerBrush}"
                                FontWeight="Bold"
                                FontSize="12"
                                Height="36"
                                Padding="12,0"
                                Cursor="Hand"/>
                    </StackPanel>
                </Grid>

                <!-- 4-Column Card Grid -->
                <ItemsControl Grid.Row="3" ItemsSource="{Binding FilteredLogs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" HorizontalAlignment="Stretch"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{DynamicResource RecordCardStyle}" Margin="6">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.OpenLogModalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- NoticeId badge + Status pill -->
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{DynamicResource PrimaryBrush}"
                                                CornerRadius="4" Padding="6,3" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding NoticeId}" FontSize="10"
                                                       FontWeight="Bold" Foreground="{DynamicResource ButtonTextBrush}"/>
                                        </Border>
                                        <!-- Status badge -->
                                        <Border Grid.Column="1" CornerRadius="10" Padding="8,3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource WarningBgBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Acknowledged">
                                                            <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Overdue">
                                                            <Setter Property="Background" Value="{DynamicResource DangerBgBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding DisplayStatus}" FontSize="10" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Acknowledged">
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Overdue">
                                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>

                                    <!-- Student Name -->
                                    <TextBlock Grid.Row="1" Text="{Binding StudentName}"
                                               FontSize="14" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>

                                    <!-- Issue Date -->
                                    <TextBlock Grid.Row="2" FontSize="11"
                                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,3">
                                        <Run Text="Issued: "/><Run Text="{Binding IssueDate}"/>
                                    </TextBlock>

                                    <!-- Due Date -->
                                    <TextBlock Grid.Row="3" FontSize="11"
                                               Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,8">
                                        <Run Text="Due: "/><Run Text="{Binding DueDate}"/>
                                    </TextBlock>

                                    <!-- Action Button -->
                                    <Button Grid.Row="4"
                                            Command="{Binding DataContext.OpenLogModalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Height="30" FontSize="11" Padding="6,0" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                                <Setter Property="Content" Value="📋 Log Receipt"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Acknowledged">
                                                        <Setter Property="Content" Value="📄 View Receipt"/>
                                                        <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </Grid>
        </ScrollViewer>

        <!-- Log Acknowledgment Modal -->
        <views:LogAcknowledgmentModal Visibility="{Binding IsLogModalOpen, Converter={StaticResource BoolToVis}}"/>
    </Grid>
</UserControl>