<UserControl x:Class="SmartSchoolIncidentManagementSystem.Views.SuspensionCalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1150">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="32,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 1. Header & Navigation Back Button -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="← Back to Overview" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding BackToOverviewCommand}" Margin="0,0,14,0" Padding="12,6"/>
                            <TextBlock Text="Suspension Calendar &amp; Compliance Tracker" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Track active in-school and out-of-school suspension orders, compliance dates, and return checks." FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="+ File Suspension Order" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding OpenFileModalCommand}"/>
                    </StackPanel>
                </Grid>

                <!-- Status Notification Banner -->
                <Border Grid.Row="1" Background="{DynamicResource InfoBgBrush}" BorderBrush="{DynamicResource InfoBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,16">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource InfoBrush}" FontWeight="Medium"/>
                </Border>

                <!-- 2. Top KPI Summary Cards -->
                <Grid Grid.Row="2" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{DynamicResource CardBorderStyle}" Margin="0,0,12,0" Padding="16,14">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="ACTIVE SUSPENSIONS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding ActiveSuspensionsCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{DynamicResource CardBorderStyle}" Margin="0,0,12,0" Padding="16,14">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="IN-SCHOOL (ISS)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding IssCount}" FontSize="24" FontWeight="Bold" Foreground="#8B5CF6" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{DynamicResource CardBorderStyle}" Margin="0,0,12,0" Padding="16,14">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="OUT-OF-SCHOOL (OSS)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding OssCount}" FontSize="24" FontWeight="Bold" Foreground="#EF4444" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Style="{DynamicResource CardBorderStyle}" Padding="16,14">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="PENDING CLEARANCE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding PendingClearanceCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 3. Workspace Split-Layout (Calendar Left + Table Right) -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT COLUMN: Mini Calendar & Date Filters -->
                    <Border Grid.Column="0" Style="{DynamicResource CardBorderStyle}" Margin="0,0,16,0" Padding="16">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="SUSPENSION CALENDAR" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,12"/>

                            <!-- Mini Interactive Calendar -->
                            <Calendar SelectedDate="{Binding SelectedCalendarDate}" HorizontalAlignment="Center" Margin="0,0,0,14"/>

                            <TextBlock Text="QUICK DATE FILTERS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8"/>
                            <UniformGrid Columns="3" Margin="0,0,0,16">
                                <Button Content="Today" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding FilterTodayCommand}" Margin="0,0,4,0" Padding="4,4" FontSize="11"/>
                                <Button Content="This Week" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding FilterThisWeekCommand}" Margin="0,0,4,0" Padding="4,4" FontSize="11"/>
                                <Button Content="This Month" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding FilterThisMonthCommand}" Padding="4,4" FontSize="11"/>
                            </UniformGrid>

                            <Border Background="{DynamicResource TableHoverBrush}" CornerRadius="6" Padding="12,10">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="TYPE LEGEND" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <Border Width="10" Height="10" CornerRadius="5" Background="#8B5CF6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="ISS (In-School)" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <Border Width="10" Height="10" CornerRadius="5" Background="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="OSS (Out-of-School)" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <Border Width="10" Height="10" CornerRadius="5" Background="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Readmitted" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- RIGHT COLUMN: Toolbar & Suspension DataGrid -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Control Toolbar -->
                        <Border Grid.Row="0" Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,16" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.8*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="Search Suspension Registry" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                    <TextBox Style="{DynamicResource ModernTextBoxStyle}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="Suspension Type" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                    <ComboBox Style="{DynamicResource ModernComboBoxStyle}" ItemsSource="{Binding TypeFilterOptions}" SelectedItem="{Binding SelectedTypeFilter}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Clearance Status" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                    <ComboBox Style="{DynamicResource ModernComboBoxStyle}" ItemsSource="{Binding StatusFilterOptions}" SelectedItem="{Binding SelectedStatusFilter}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- DataGrid Table -->
                        <Border Grid.Row="1" Style="{DynamicResource CardBorderStyle}" Padding="0">
                            <DataGrid ItemsSource="{Binding SuspensionOrders}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                      SelectionMode="Single" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                                      Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="{DynamicResource TableRowAltBrush}"
                                      Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="0" HeadersVisibility="Column"
                                      CanUserResizeRows="False" RowDetailsVisibilityMode="Collapsed" RowHeight="50">

                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="Padding" Value="8,10"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                    </Style>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGridCell">
                                                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    <Style TargetType="TextBlock" x:Key="CellTextStyle">
                                        <Setter Property="Padding" Value="6,0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontSize" Value="12"/>
                                    </Style>
                                </DataGrid.Resources>

                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#E0F2FE"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#BAE6FD"/>
                                                <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                                <Setter Property="BorderBrush" Value="#0EA5E9"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Order ID" Binding="{Binding OrderId}" MinWidth="95" Width="95" ElementStyle="{StaticResource CellTextStyle}"/>
                                    <DataGridTextColumn Header="Student &amp; ID" Binding="{Binding StudentNameAndId}" MinWidth="150" Width="1.3*" ElementStyle="{StaticResource CellTextStyle}"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding SuspensionType}" MinWidth="110" Width="1.1*" ElementStyle="{StaticResource CellTextStyle}"/>
                                    <DataGridTextColumn Header="Date Span" Binding="{Binding DateSpanText}" MinWidth="150" Width="1.3*" ElementStyle="{StaticResource CellTextStyle}"/>
                                    <DataGridTextColumn Header="Days" Binding="{Binding TotalDays, StringFormat='{}{0} Days'}" MinWidth="65" Width="65" ElementStyle="{StaticResource CellTextStyle}"/>
                                    <DataGridTextColumn Header="Re-entry" Binding="{Binding ReentryDate, StringFormat='{}{0:yyyy-MM-dd}'}" MinWidth="95" Width="95" ElementStyle="{StaticResource CellTextStyle}"/>

                                    <!-- Checklist Badge -->
                                    <DataGridTemplateColumn Header="Checklist" MinWidth="95" Width="95">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4" Padding="6,3" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource TableHoverBrush}">
                                                    <TextBlock Text="{Binding ChecklistStatusText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Status Badge -->
                                    <DataGridTemplateColumn Header="Status" MinWidth="105" Width="105">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4" Padding="8,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Pending Review">
                                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Readmitted">
                                                                    <Setter Property="Background" Value="#D1FAE5"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#991B1B"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Pending Review">
                                                                        <Setter Property="Foreground" Value="#92400E"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Readmitted">
                                                                        <Setter Property="Foreground" Value="#065F46"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Actions -->
                                    <DataGridTemplateColumn Header="Actions" MinWidth="170" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="Checklist / Clear" Style="{DynamicResource PrimaryButtonStyle}" Padding="6,4" FontSize="11" Margin="0,0,4,0"
                                                            Command="{Binding DataContext.OpenChecklistModalCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="🖨️ Notice" Style="{DynamicResource SecondaryButtonStyle}" Padding="6,4" FontSize="11"
                                                            Command="{Binding DataContext.PrintNoticeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- 4. MODAL POP-UP 1: "+ File Suspension Order" -->
        <Grid Background="#80000000">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFileModalOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Style="{DynamicResource CardBorderStyle}" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" CornerRadius="12">
                <StackPanel Orientation="Vertical">
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="Issue Student Suspension Order" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <Button Content="✕" Width="28" Height="28" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding CloseFileModalCommand}"/>
                    </Grid>

                    <Border Background="{DynamicResource DangerBgBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FileErrorMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding FileErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="12" FontWeight="Medium"/>
                    </Border>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Student Name *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                            <TextBox Style="{DynamicResource ModernTextBoxStyle}" Text="{Binding FileStudentName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Student ID Number" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                            <TextBox Style="{DynamicResource ModernTextBoxStyle}" Text="{Binding FileStudentId, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Linked Incident Ref" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                            <ComboBox Style="{DynamicResource ModernComboBoxStyle}" ItemsSource="{Binding AvailableIncidents}" SelectedItem="{Binding FileIncidentNumber}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Suspension Type *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                            <ComboBox Style="{DynamicResource ModernComboBoxStyle}" ItemsSource="{Binding SuspensionTypeOptions}" SelectedItem="{Binding FileSuspensionType}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Start Date" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                            <DatePicker SelectedDate="{Binding FileStartDate}" FontSize="12" Padding="4,4"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="End Date" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                            <DatePicker SelectedDate="{Binding FileEndDate}" FontSize="12" Padding="4,4"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Re-entry Date" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                            <DatePicker SelectedDate="{Binding FileReentryDate}" FontSize="12" Padding="4,4"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Authorized By *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBox Style="{DynamicResource ModernTextBoxStyle}" Text="{Binding FileIssuedBy, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Terms &amp; Sanction Conditions *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBox Style="{DynamicResource ModernTextBoxStyle}" Text="{Binding FileTerms, UpdateSourceTrigger=PropertyChanged}" Height="55" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </StackPanel>

                    <TextBlock Text="Mandatory Re-entry Requirements:" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                    <CheckBox Content="Parent Re-entry Conference Required" IsChecked="{Binding FileParentConferenceRequired}" Margin="0,2" FontSize="12"/>
                    <CheckBox Content="Academic Make-up Packet Submission Required" IsChecked="{Binding FileAcademicPacketRequired}" Margin="0,2" FontSize="12"/>
                    <CheckBox Content="Guidance Counselor Intake Interview Required" IsChecked="{Binding FileCounselorIntakeRequired}" Margin="0,2,0,14" FontSize="12"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding CloseFileModalCommand}" Margin="0,0,10,0" Padding="14,6"/>
                        <Button Content="Save &amp; Issue Order" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding SaveNewOrderCommand}" Padding="14,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 5. MODAL POP-UP 2: "Re-Admission Clearance Checklist" -->
        <Grid Background="#80000000">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsChecklistModalOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Style="{DynamicResource CardBorderStyle}" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" CornerRadius="12">
                <StackPanel Orientation="Vertical">
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="Student Re-Admission Clearance Checklist" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <Button Content="✕" Width="28" Height="28" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding CloseChecklistModalCommand}"/>
                    </Grid>

                    <Border Background="{DynamicResource TableHoverBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedOrder.OrderId, StringFormat='ORDER ID: {0}'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                            <TextBlock Text="{Binding SelectedOrder.StudentNameAndId, StringFormat='Student: {0}'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding SelectedOrder.DateSpanText, StringFormat='Ban Period: {0}'}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Re-entry Verification Checklist:" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"/>
                    <CheckBox Content="Parent attended formal re-entry conference" IsChecked="{Binding ChecklistParentPassed}" Margin="0,4" FontSize="13"/>
                    <CheckBox Content="Completed homework / make-up modules submitted" IsChecked="{Binding ChecklistPacketPassed}" Margin="0,4" FontSize="13"/>
                    <CheckBox Content="Guidance counselor intake interview conducted" IsChecked="{Binding ChecklistCounselorPassed}" Margin="0,4,0,14" FontSize="13"/>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Counselor / Officer Sign-Off Notes" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBox Style="{DynamicResource ModernTextBoxStyle}" Text="{Binding ChecklistNotes, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding CloseChecklistModalCommand}" Margin="0,0,8,0" Padding="12,6"/>
                        <Button Content="Save Progress" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding SaveChecklistCommand}" Margin="0,0,8,0" Padding="12,6"/>
                        <Button Content="Grant Clearance &amp; Readmit" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding GrantFinalClearanceCommand}" Padding="12,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
