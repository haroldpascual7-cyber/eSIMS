<UserControl x:Class="SmartSchoolIncidentManagementSystem.Views.IncidentLifecycleProgressionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:models="clr-namespace:SmartSchoolIncidentManagementSystem.Models"
             mc:Ignorable="d">
    <Border Style="{DynamicResource CardBorderStyle}" Padding="16,14" Margin="0,0,0,16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header Row -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔄" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="INCIDENT LIFECYCLE PROGRESSION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" Background="{DynamicResource TableHoverBrush}" CornerRadius="12" Padding="10,3">
                    <TextBlock Text="{Binding LifecycleStatusLabel, FallbackValue='Pipeline Tracker'}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                </Border>
            </Grid>

            <!-- 5 Progression Buttons -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Step 1: Reported -->
                <Button Grid.Column="0" Content="1. Reported" Command="{Binding SetStatusCommand}" CommandParameter="{x:Static models:IncidentStatus.Reported}" Margin="0,0,6,0" Height="34" FontSize="11.5" FontWeight="SemiBold">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentLifecycleStage}" Value="Reported">
                                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Step 2: Investigating -->
                <Button Grid.Column="1" Content="2. Investigating" Command="{Binding SetStatusCommand}" CommandParameter="{x:Static models:IncidentStatus.UnderInvestigation}" Margin="0,0,6,0" Height="34" FontSize="11.5" FontWeight="SemiBold">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentLifecycleStage}" Value="UnderInvestigation">
                                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Step 3: Action Taken -->
                <Button Grid.Column="2" Content="3. Action Taken" Command="{Binding SetStatusCommand}" CommandParameter="{x:Static models:IncidentStatus.ActionTaken}" Margin="0,0,6,0" Height="34" FontSize="11.5" FontWeight="SemiBold">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentLifecycleStage}" Value="ActionTaken">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Step 4: Resolved -->
                <Button Grid.Column="3" Content="4. Resolved" Command="{Binding SetStatusCommand}" CommandParameter="{x:Static models:IncidentStatus.Resolved}" Margin="0,0,6,0" Height="34" FontSize="11.5" FontWeight="SemiBold">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentLifecycleStage}" Value="Resolved">
                                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Step 5: Closed -->
                <Button Grid.Column="4" Content="5. Closed" Command="{Binding SetStatusCommand}" CommandParameter="{x:Static models:IncidentStatus.Closed}" Height="34" FontSize="11.5" FontWeight="SemiBold">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentLifecycleStage}" Value="Closed">
                                    <Setter Property="Background" Value="{DynamicResource SecondaryTextBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Explanatory Stage Description Row -->
            <Border Grid.Row="2" Background="{DynamicResource TableHoverBrush}" CornerRadius="6" Padding="10,6" Margin="0,8,0,0">
                <TextBlock Text="{Binding LifecycleStageDescription, FallbackValue='Click any stage above to transition incident lifecycle status.'}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
