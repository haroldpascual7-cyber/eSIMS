<UserControl x:Class="SmartSchoolIncidentManagementSystem.Views.StudentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:views="clr-namespace:SmartSchoolIncidentManagementSystem.Views"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1200"
             Background="{DynamicResource AppBackgroundBrush}"
             ClipToBounds="False">

    <Grid ClipToBounds="False">
        <!-- 1. MAIN WORKSPACE CONTENT: STUDENT DIRECTORY & RECORDS -->
        <Grid Margin="24,16" Visibility="{Binding IsStudentDetailOpen, Converter={StaticResource InverseBoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1.1 HEADER & ACTIONS ROW -->
            <Border Grid.Row="0" Style="{DynamicResource CardBorderStyle}" Padding="18,14" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="👥" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Student Directory &amp; Records" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </StackPanel>
                        <TextBlock Text="Manage student enrollment, parent contact details, rosters, and behavioral profiles." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="📥 Import (CSV/Excel)" Style="{DynamicResource SecondaryButtonStyle}"
                                Command="{Binding OpenImportModalCommand}" Margin="0,0,8,0" Height="36"
                                Visibility="{Binding CanManageStudents, Converter={StaticResource BoolToVis}}"/>

                        <Button Content="+ Add Student" Style="{DynamicResource PrimaryButtonStyle}"
                                Command="{Binding OpenAddStudentCommand}" Margin="0,0,8,0" Height="36"
                                Visibility="{Binding CanManageStudents, Converter={StaticResource BoolToVis}}"/>

                        <Button Content="{Binding RefreshButtonIcon, FallbackValue='↻'}" Style="{DynamicResource SecondaryButtonStyle}"
                                Command="{Binding RefreshCommand}" IsEnabled="{Binding IsNotRefreshing}" Width="36" Height="36" Padding="0" ToolTip="Refresh Student Records"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 1.2 SEARCH & FILTER BAR -->
            <Border Grid.Row="1" Style="{DynamicResource CardBorderStyle}" Padding="16,12" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Input -->
                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <TextBox Style="{DynamicResource ModernTextBoxStyle}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Height="36" VerticalContentAlignment="Center"/>
                        <TextBlock Text="🔍  Search by student name, ID number, or section..."
                                   FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                                   IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Grade Filter -->
                    <ComboBox Grid.Column="1" Style="{DynamicResource ModernComboBoxStyle}"
                              ItemsSource="{Binding GradeFilterOptions}"
                              SelectedItem="{Binding SelectedGradeFilter}"
                              Height="36" Margin="0,0,12,0"/>

                    <!-- Section Filter -->
                    <ComboBox Grid.Column="2" Style="{DynamicResource ModernComboBoxStyle}"
                              ItemsSource="{Binding SectionFilterOptions}"
                              SelectedItem="{Binding SelectedSectionFilter}"
                              Height="36" Margin="0,0,12,0"/>

                    <!-- Clear Filters -->
                    <Button Grid.Column="3" Content="Reset Filters" Style="{DynamicResource SecondaryButtonStyle}"
                            Command="{Binding ClearFiltersCommand}" Height="36" Padding="14,0"/>
                </Grid>
            </Border>

            <!-- 1.3 STUDENT ROSTER (4-COLUMN RESPONSIVE CARDS) -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Students}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{DynamicResource RecordCardStyle}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.ViewStudentDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Top Row: Icon/Badge & ID -->
                                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                        <Border CornerRadius="4" Padding="6,2" Background="{DynamicResource PrimaryBrush}" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding StudentNumber}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ButtonTextBrush}"/>
                                        </Border>
                                        <Border CornerRadius="4" Padding="6,2" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Status, FallbackValue='Active'}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        </Border>
                                    </DockPanel>

                                    <!-- Student Name -->
                                    <TextBlock Grid.Row="1" Text="{Binding FullName}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>

                                    <!-- Grade & Section -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="📚 " FontSize="11"/>
                                        <TextBlock Text="{Binding GradeLevel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock Text=" • " FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock Text="{Binding Section}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </StackPanel>

                                    <!-- Guardian & Contact -->
                                    <StackPanel Grid.Row="3" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding GuardianName, StringFormat='👤 {0}'}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding GuardianContact, StringFormat='📞 {0}'}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- 2. STUDENT DETAIL INFORMATION VIEW (MATCHING DESIGN REFERENCE) -->
        <views:StudentInformationDetailView DataContext="{Binding}"
                                            Visibility="{Binding IsStudentDetailOpen, Converter={StaticResource BoolToVis}}"/>

        <!-- 3. FULL-SCREEN MODAL OVERLAY: CREATE / ADD STUDENT -->
        <Grid Margin="0" Panel.ZIndex="1000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              Visibility="{Binding IsStudentModalOpen, Converter={StaticResource BoolToVis}}"
              Background="{DynamicResource ModalOverlayBrush}">
            <Border Width="700" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Modal Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ModalTitle}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="✏️ Edit Record" Style="{DynamicResource SecondaryButtonStyle}"
                                    Command="{Binding ToggleEditModeCommand}" Margin="0,0,8,0" Height="30" Padding="10,0" FontSize="11"
                                    Visibility="{Binding IsModalReadOnly, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="✕" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding CancelModalCommand}"
                                    Width="30" Height="30" Padding="0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Modal Form -->
                    <ScrollViewer Grid.Row="1" MaxHeight="520" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Error Notice -->
                            <Border Background="{DynamicResource DangerBgBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="10" Margin="0,0,0,12"
                                    Visibility="{Binding ModalErrorMessage, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="{Binding ModalErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </Border>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Student ID Number *" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding ModalStudentNumber}" Style="{DynamicResource ModernTextBoxStyle}" Height="34" IsReadOnly="{Binding IsModalReadOnly}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Gender" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding GenderOptions}" SelectedItem="{Binding ModalGender}" Style="{DynamicResource ModernComboBoxStyle}" Height="34" IsEnabled="{Binding IsModalEditing}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="First Name *" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding ModalFirstName}" Style="{DynamicResource ModernTextBoxStyle}" Height="34" IsReadOnly="{Binding IsModalReadOnly}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="3,0,3,0">
                                    <TextBlock Text="Middle Name" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding ModalMiddleName}" Style="{DynamicResource ModernTextBoxStyle}" Height="34" IsReadOnly="{Binding IsModalReadOnly}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                    <TextBlock Text="Last Name *" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding ModalLastName}" Style="{DynamicResource ModernTextBoxStyle}" Height="34" IsReadOnly="{Binding IsModalReadOnly}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Grade Level *" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding GradeOptions}" SelectedItem="{Binding ModalGradeLevel}" Style="{DynamicResource ModernComboBoxStyle}" Height="34" IsEnabled="{Binding IsModalEditing}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="3,0,3,0">
                                    <TextBlock Text="Section *" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding ModalSection}" Style="{DynamicResource ModernTextBoxStyle}" Height="34" IsReadOnly="{Binding IsModalReadOnly}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                    <TextBlock Text="Adviser" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding ModalAdviser}" Style="{DynamicResource ModernTextBoxStyle}" Height="34" IsReadOnly="{Binding IsModalReadOnly}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Parent / Guardian Contact Information" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,10,0,8"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Parent / Guardian Name *" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding ModalGuardianName}" Style="{DynamicResource ModernTextBoxStyle}" Height="34" IsReadOnly="{Binding IsModalReadOnly}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Parent Email (For Alerts) *" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding ModalGuardianEmail}" Style="{DynamicResource ModernTextBoxStyle}" Height="34" IsReadOnly="{Binding IsModalReadOnly}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Contact Number" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding ModalGuardianContact}" Style="{DynamicResource ModernTextBoxStyle}" Height="34" IsReadOnly="{Binding IsModalReadOnly}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Residential Address" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding ModalAddress}" Style="{DynamicResource ModernTextBoxStyle}" Height="34" IsReadOnly="{Binding IsModalReadOnly}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Modal Actions (EDIT, UPDATE, DELETE INSIDE MODAL) -->
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Button Content="🗑️ Delete" Style="{DynamicResource DangerButtonStyle}"
                                    Command="{Binding DeleteCurrentStudentCommand}" Margin="0,0,8,0" Height="36" Padding="12,0"
                                    Visibility="{Binding CanDeleteCurrentStudent, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="🚨 File Incident" Style="{DynamicResource WarningButtonStyle}"
                                    Command="{Binding CreateIncidentForCurrentStudentCommand}" Margin="0,0,8,0" Height="36" Padding="12,0"
                                    Visibility="{Binding IsModalReadOnly, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="📋 Dossier" Style="{DynamicResource SecondaryButtonStyle}"
                                    Command="{Binding ViewCurrentStudentDossierCommand}" Height="36" Padding="12,0"
                                    Visibility="{Binding IsModalReadOnly, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- View Mode Buttons -->
                            <Button Content="Close" Style="{DynamicResource SecondaryButtonStyle}"
                                    Command="{Binding CancelModalCommand}" Height="36" Padding="16,0"
                                    Visibility="{Binding IsModalReadOnly, Converter={StaticResource BoolToVis}}"/>

                            <!-- Edit Mode Buttons -->
                            <Button Content="Cancel" Style="{DynamicResource SecondaryButtonStyle}"
                                    Command="{Binding CancelEditModeCommand}" Margin="0,0,8,0" Height="36" Padding="16,0"
                                    Visibility="{Binding IsModalEditing, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="💾 Update &amp; Save" Style="{DynamicResource PrimaryButtonStyle}"
                                    Command="{Binding SaveStudentCommand}" Height="36" Padding="16,0"
                                    Visibility="{Binding IsModalEditing, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 4. FULL-SCREEN MODAL OVERLAY: CSV / EXCEL ROSTER IMPORT -->
        <Grid Margin="0" Panel.ZIndex="1000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              Visibility="{Binding IsImportModalOpen, Converter={StaticResource BoolToVis}}"
              Background="{DynamicResource ModalOverlayBrush}">
            <Border Width="850" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="📥 Batch Import Student Roster (CSV / Excel .xlsx)" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <Button Content="✕" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding CloseImportModalCommand}"
                                HorizontalAlignment="Right" Width="30" Height="30" Padding="0" FontSize="13" FontWeight="Bold" ToolTip="Close" Cursor="Hand"/>
                    </Grid>

                    <!-- File Selector & Stats -->
                    <Border Grid.Row="1" Background="{DynamicResource TableHoverBrush}" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding ImportFilePath, TargetNullValue='No file selected. Please select a .csv or .xlsx student list.'}" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding ImportStatusMessage}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Browse File..." Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding SelectImportFileCommand}" Height="32"/>
                        </Grid>
                    </Border>

                    <!-- Preview DataGrid -->
                    <Border Grid.Row="2" Style="{DynamicResource CardBorderStyle}" Padding="0" MaxHeight="320">
                        <DataGrid ItemsSource="{Binding ImportPreviewRows}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  BorderThickness="0" Background="Transparent" RowHeight="32">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding RowIndex}" Width="40"/>
                                <DataGridTextColumn Header="Student ID" Binding="{Binding StudentNumber}" Width="110"/>
                                <DataGridTextColumn Header="Name" Binding="{Binding FirstName}" Width="120"/>
                                <DataGridTextColumn Header="Last Name" Binding="{Binding LastName}" Width="120"/>
                                <DataGridTextColumn Header="Grade" Binding="{Binding GradeLevel}" Width="90"/>
                                <DataGridTextColumn Header="Section" Binding="{Binding Section}" Width="90"/>
                                <DataGridTextColumn Header="Parent Email" Binding="{Binding GuardianEmail}" Width="160"/>
                                <DataGridTemplateColumn Header="Validation Status" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ValidationMessage}" Foreground="{Binding StatusColor}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Import Actions -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Cancel" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding CloseImportModalCommand}" Margin="0,0,8,0" Height="36"/>
                        <Button Content="Confirm &amp; Import Valid Students" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding ConfirmImportCommand}" Height="36" IsEnabled="{Binding IsImporting, Converter={StaticResource InverseBoolToVis}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 5. FULL-SCREEN MODAL OVERLAY: STUDENT DOSSIER & PROFILE -->
        <Grid Margin="0" Panel.ZIndex="1000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              Visibility="{Binding IsProfileModalOpen, Converter={StaticResource BoolToVis}}"
              Background="{DynamicResource ModalOverlayBrush}">
            <Border Width="800" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📋 Student 360° Dossier &amp; Behavioral Profile" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </StackPanel>
                        <Button Content="✕" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding CloseProfileModalCommand}"
                                HorizontalAlignment="Right" Width="30" Height="30" Padding="0" FontSize="13" FontWeight="Bold" ToolTip="Close Dossier" Cursor="Hand"/>
                    </Grid>

                    <!-- Student Snapshot Card -->
                    <Border Grid.Row="1" Background="{DynamicResource TableHoverBrush}" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding SelectedStudent.FullName}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                                <TextBlock Text="{Binding SelectedStudent.StudentNumber, StringFormat='{}ID: {0}'}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding SelectedStudent.GradeLevel, StringFormat='{}Grade: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text="{Binding SelectedStudent.Section, StringFormat='{}Section: {0}'}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding SelectedStudent.GuardianName, StringFormat='{}Guardian: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text="{Binding SelectedStudent.GuardianEmail}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Dossier Tabs: Incident History & Merit Badges -->
                    <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0" Height="300">
                        <TabItem Header="🚨 Incidents History" FontSize="12" FontWeight="SemiBold">
                            <Border Style="{DynamicResource CardBorderStyle}" Padding="0" Margin="0,6,0,0">
                                <DataGrid ItemsSource="{Binding StudentIncidents}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" BorderThickness="0" Background="Transparent" RowHeight="32">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Incident #" Binding="{Binding IncidentNumber}" Width="110"/>
                                        <DataGridTextColumn Header="Date" Binding="{Binding IncidentDate, StringFormat='yyyy-MM-dd'}" Width="90"/>
                                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="130"/>
                                        <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="80"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                                        <DataGridTextColumn Header="Action Taken" Binding="{Binding ActionTaken}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </TabItem>
                        <TabItem Header="⭐ Merits &amp; Commendations" FontSize="12" FontWeight="SemiBold">
                            <Border Style="{DynamicResource CardBorderStyle}" Padding="0" Margin="0,6,0,0">
                                <DataGrid ItemsSource="{Binding StudentMerits}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" BorderThickness="0" Background="Transparent" RowHeight="32">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Date" Binding="{Binding DateAwarded, StringFormat='yyyy-MM-dd'}" Width="100"/>
                                        <DataGridTextColumn Header="Commendation" Binding="{Binding Citation}" Width="250"/>
                                        <DataGridTextColumn Header="Points" Binding="{Binding Points}" Width="70"/>
                                        <DataGridTextColumn Header="Awarded By" Binding="{Binding AwardedBy}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </TabItem>
                    </TabControl>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Content="Close Dossier" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding CloseProfileModalCommand}" Height="34" Padding="14,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
