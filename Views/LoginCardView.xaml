<UserControl x:Class="SmartSchoolIncidentManagementSystem.Views.LoginCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Vertical" Margin="36,14,36,20">
            <!-- Top Banner: 3D eSIMS+ SIDS Emblem in Center -->
            <Grid Margin="0,0,0,8">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/esims_plus_sids_logo.png"
                           Height="100"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.28" BlurRadius="18" ShadowDepth="4"/>
                        </Image.Effect>
                    </Image>
                </Border>
            </Grid>

            <TextBlock Text="Welcome Back!" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource LoginPrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,2"/>
            <TextBlock Text="Sign in to continue to eSIMS" FontSize="14" Foreground="{DynamicResource LoginSecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,14"/>

            <!-- Error Alert -->
            <Border Background="{DynamicResource DangerBgBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontWeight="Medium" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Database Selection Row -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0"
                          Height="42"
                          ItemsSource="{Binding DatabaseOptions}"
                          SelectedItem="{Binding SelectedDatabaseOption, UpdateSourceTrigger=PropertyChanged}"
                          Style="{DynamicResource LoginComboBoxStyle}"
                          ToolTip="Database Storage Engine"/>
                <Button Grid.Column="2"
                        Command="{Binding ConfigureDatabaseCommand}"
                        Width="42"
                        Height="42"
                        Cursor="Hand"
                        ToolTip="Configure MySQL Database"
                        Background="Transparent"
                        BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="gearBorder"
                                    CornerRadius="8"
                                    Background="{DynamicResource LoginInputBackgroundBrush}"
                                    BorderBrush="{DynamicResource LoginInputBorderBrush}"
                                    BorderThickness="1">
                                <TextBlock Text="⚙️"
                                           FontSize="18"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource LoginSecondaryTextBrush}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="gearBorder" Property="Background" Value="{DynamicResource LoginInputHoverBrush}"/>
                                    <Setter TargetName="gearBorder" Property="BorderBrush" Value="{DynamicResource LoginAccentTextBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>


            <!-- Username Input -->
            <Border Height="44" Style="{DynamicResource LoginInputBorderStyle}" Padding="14,0" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="👤" FontSize="16" Foreground="{DynamicResource LoginSecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox Grid.Column="1" x:Name="UsernameInput" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource LoginEmbeddedTextBoxStyle}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Username" FontSize="14" Foreground="{DynamicResource LoginMutedTextBrush}" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=UsernameInput}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Password Input -->
            <Border Height="44" Style="{DynamicResource LoginInputBorderStyle}" Padding="14,0" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔒" FontSize="14" Foreground="{DynamicResource LoginSecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <PasswordBox Grid.Column="1" x:Name="UserPasswordBox" PasswordChanged="OnPasswordChanged" Visibility="{Binding IsPasswordVisible, Converter={StaticResource InverseBoolToVis}}" Style="{DynamicResource LoginEmbeddedPasswordBoxStyle}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="VisiblePasswordTextBox" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" TextChanged="OnVisiblePasswordTextChanged" Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVis}}" Style="{DynamicResource LoginEmbeddedTextBoxStyle}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Password" FontSize="14" Foreground="{DynamicResource LoginMutedTextBrush}" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Password}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Grid.Column="2" Command="{Binding TogglePasswordVisibilityCommand}" Background="Transparent" BorderThickness="0" Padding="4" Cursor="Hand" ToolTip="Toggle password visibility" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Button.Template><ControlTemplate TargetType="Button"><TextBlock Text="{Binding PasswordEyeIcon}" FontSize="14" Foreground="{DynamicResource LoginSecondaryTextBrush}" VerticalAlignment="Center"/></ControlTemplate></Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Remember Me & Forgot Password Row -->
            <Grid Margin="2,0,2,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" Content="Remember me" Style="{DynamicResource LoginCheckBoxStyle}" VerticalAlignment="Center" Cursor="Hand"/>
                <TextBlock Grid.Column="1" Text="Forgot Password?" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource LoginAccentTextBrush}" VerticalAlignment="Center" Cursor="Hand"/>
            </Grid>

            <!-- Login Button -->
            <Button Command="{Binding LoginCommand}"
                    IsEnabled="{Binding IsLoginButtonEnabled}"
                    IsDefault="True"
                    Height="44"
                    Cursor="Hand"
                    Margin="0,0,0,12">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="8" Background="{DynamicResource LoginPrimaryButtonBrush}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding LoginButtonText}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ButtonTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="→" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ButtonTextBrush}" VerticalAlignment="Center" Margin="10,0,0,0"
                                           Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVis}}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource LoginPrimaryButtonHoverBrush}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource LoginPrimaryButtonActiveBrush}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="btnBorder" Property="Opacity" Value="0.65"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Bottom Flip Link to Sign Up -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                <TextBlock Text="Don't have an account? " FontSize="14" Foreground="{DynamicResource LoginSecondaryTextBrush}"/>
                <Button Command="{Binding FlipToSignUpCommand}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <TextBlock Text="Sign Up" Foreground="{DynamicResource LoginAccentTextBrush}" FontSize="14" FontWeight="Bold"/>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
