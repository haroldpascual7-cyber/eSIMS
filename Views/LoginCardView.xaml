<UserControl x:Class="SmartSchoolIncidentManagementSystem.Views.LoginCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Vertical" Margin="36,14,36,20">
            <!-- Top Banner: 3D eSIMS+ SIDS Emblem in Center, Theme Toggle at Top-Right -->
            <Grid Margin="0,0,0,8">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/esims_plus_sids_logo.png"
                           Height="100"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.28" BlurRadius="18" ShadowDepth="4"/>
                        </Image.Effect>
                    </Image>
                </Border>

                <!-- Theme Toggle Button -->
                <Button Command="{Binding ToggleThemeCommand}" ToolTip="Toggle Theme (Light / Dark)"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Width="34" Height="34" Cursor="Hand" Margin="0,2,0,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="themeBtnBorder" CornerRadius="17"
                                    Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Border.Effect><DropShadowEffect Color="#000000" Opacity="0.15" BlurRadius="8" ShadowDepth="2"/></Border.Effect>
                                <Canvas Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M 9,1 V 3 M 9,15 V 17 M 1,9 H 3 M 15,9 H 17 M 3.34,3.34 L 4.76,4.76 M 13.24,13.24 L 14.66,14.66 M 3.34,14.66 L 4.76,13.24 M 13.24,4.76 L 14.66,3.34"/>
                                    <Ellipse Canvas.Left="4.5" Canvas.Top="4.5" Width="9" Height="9" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.3"/>
                                    <Path Fill="{DynamicResource SecondaryTextBrush}" Data="M 9,4.5 A 4.5,4.5 0 0 1 9,13.5 Z"/>
                                </Canvas>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="themeBtnBorder" Property="Background" Value="{DynamicResource TableHoverBrush}"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <TextBlock Text="Welcome Back!" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,2"/>
            <TextBlock Text="Sign in to continue to eSIMS" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>

            <!-- Error Alert -->
            <Border Background="{DynamicResource DangerBgBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠️" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontWeight="Medium" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>


            <!-- Username Input -->
            <Border Height="44" CornerRadius="8" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" Padding="14,0" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="👤" FontSize="15" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox Grid.Column="1" x:Name="UsernameInput" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" FontSize="13.5" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" CaretBrush="{DynamicResource PrimaryBrush}" Padding="0"/>
                    <TextBlock Grid.Column="1" Text="Username" FontSize="13.5" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=UsernameInput}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Password Input -->
            <Border Height="44" CornerRadius="8" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" Padding="14,0" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔒" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <PasswordBox Grid.Column="1" x:Name="UserPasswordBox" PasswordChanged="OnPasswordChanged" Visibility="{Binding IsPasswordVisible, Converter={StaticResource InverseBoolToVis}}" Background="Transparent" BorderThickness="0" FontSize="13.5" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" CaretBrush="{DynamicResource PrimaryBrush}" Padding="0"/>
                    <TextBox Grid.Column="1" x:Name="VisiblePasswordTextBox" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" TextChanged="OnVisiblePasswordTextChanged" Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVis}}" Background="Transparent" BorderThickness="0" FontSize="13.5" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" CaretBrush="{DynamicResource PrimaryBrush}" Padding="0"/>
                    <TextBlock Grid.Column="1" Text="Password" FontSize="13.5" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Password}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Grid.Column="2" Command="{Binding TogglePasswordVisibilityCommand}" Background="Transparent" BorderThickness="0" Padding="4" Cursor="Hand" ToolTip="Toggle password visibility" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Button.Template><ControlTemplate TargetType="Button"><TextBlock Text="{Binding PasswordEyeIcon}" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/></ControlTemplate></Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Remember Me & Forgot Password Row -->
            <Grid Margin="2,0,2,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" Content="Remember me" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Cursor="Hand"/>
                <TextBlock Grid.Column="1" Text="Forgot Password?" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Cursor="Hand"/>
            </Grid>

            <!-- Login Button -->
            <Button Command="{Binding LoginCommand}" IsDefault="True" Height="44" Cursor="Hand" Margin="0,0,0,12">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="8" Background="{DynamicResource PrimaryBrush}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Login" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ButtonTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="→" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource ButtonTextBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource PrimaryActiveBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Bottom Flip Link to Sign Up -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                <TextBlock Text="Don't have an account? " FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <Button Command="{Binding FlipToSignUpCommand}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <TextBlock Text="Sign Up" Foreground="{DynamicResource PrimaryBrush}" FontSize="12.5" FontWeight="Bold"/>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
