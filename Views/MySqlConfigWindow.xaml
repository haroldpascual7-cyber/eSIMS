<Window x:Class="SmartSchoolIncidentManagementSystem.Views.MySqlConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MySQL Configuration"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Border Padding="24" Background="{DynamicResource CardBackgroundBrush}">
        <StackPanel>
            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="🗄️" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="MySQL Server Configuration"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="MySQL connection details."
                       FontSize="14"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Margin="0,0,0,16"
                       TextWrapping="Wrap"/>

            <!-- Status Banner -->
            <Border x:Name="StatusBorder"
                    Visibility="Collapsed"
                    CornerRadius="4"
                    BorderThickness="1"
                    Padding="8,6"
                    Margin="0,0,0,14"
                    Background="{DynamicResource InputBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}">
                <TextBlock x:Name="StatusText"
                           FontSize="14"
                           FontWeight="Medium"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- Server & Port Row -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Server Host / IP"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,0,0,4"/>
                    <TextBox x:Name="ServerBox"
                             Style="{DynamicResource ModernTextBoxStyle}"
                             Height="38"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Port"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,0,0,4"/>
                    <TextBox x:Name="PortBox"
                             Style="{DynamicResource ModernTextBoxStyle}"
                             Height="38"/>
                </StackPanel>
            </Grid>

            <!-- Database Name -->
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="Database Name"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="0,0,0,4"/>
                <TextBox x:Name="DatabaseBox"
                         Style="{DynamicResource ModernTextBoxStyle}"
                         Height="38"/>
            </StackPanel>

            <!-- Username -->
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="Username"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="0,0,0,4"/>
                <TextBox x:Name="UsernameBox"
                         Style="{DynamicResource ModernTextBoxStyle}"
                         Height="38"/>
            </StackPanel>

            <!-- Password -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Password"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="0,0,0,4"/>
                <PasswordBox x:Name="PasswordBox"
                             Height="38"
                             Background="{DynamicResource InputBackgroundBrush}"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             BorderBrush="{DynamicResource InputBorderBrush}"
                             BorderThickness="1"
                             Padding="8,6"
                             FontSize="14"/>
            </StackPanel>

            <Separator Background="{DynamicResource DividerBrush}" Margin="0,0,0,16"/>

            <!-- Action Buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Test Connection"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Click="OnTestConnectionClick"
                        Height="36"
                        Padding="14,0"/>

                <Button Grid.Column="2"
                        Content="Cancel"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        IsCancel="True"
                        Click="OnCancelClick"
                        Height="36"
                        Padding="16,0"/>

                <Button Grid.Column="4"
                        Content="Save Settings"
                        Style="{DynamicResource PrimaryButtonStyle}"
                        IsDefault="True"
                        Click="OnSaveClick"
                        Height="36"
                        Padding="16,0"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
