<UserControl x:Class="SmartSchoolIncidentManagementSystem.Views.IndividualActionPlansView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SmartSchoolIncidentManagementSystem.Views"
             Background="{DynamicResource AppBackgroundBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <!-- Main Content ScrollViewer -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,20,28,20">
                <!-- Header -->
                <Grid Margin="0,0,0,20">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="&#x2190; Back to Profiles Hub" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding BackToProfilesHubCommand}" Margin="0,0,14,0" Padding="12,6"/>
                            <TextBlock Text="Individual Action Plans &amp; Case Management" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Tailored intervention roadmaps, counseling note attachments, and progress milestones for at-risk students." FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Grid>

                <!-- Top KPI Ribbon (4 Cards) -->
                <UniformGrid Columns="4" Margin="0,0,0,20">
                    <!-- Card 1: Active Plans -->
                    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="18,16" Margin="0,0,12,0">
                        <Border.Effect><DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="10" ShadowDepth="2"/></Border.Effect>
                        <StackPanel>
                            <TextBlock Text="ACTIVE ACTION PLANS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding ActivePlanCount}" FontSize="24" FontWeight="Bold" Foreground="#059669"/>
                            <TextBlock Text="Currently Enrolled Students" FontSize="11" Foreground="#059669" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Critical Watch -->
                    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="18,16" Margin="0,0,12,0">
                        <Border.Effect><DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="10" ShadowDepth="2"/></Border.Effect>
                        <StackPanel>
                            <TextBlock Text="CRITICAL / TIER 3 WATCH" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding CriticalWatchCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/>
                            <TextBlock Text="Requires Intensive Support" FontSize="11" Foreground="{DynamicResource DangerBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Milestones Due -->
                    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="18,16" Margin="0,0,12,0">
                        <Border.Effect><DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="10" ShadowDepth="2"/></Border.Effect>
                        <StackPanel>
                            <TextBlock Text="MILESTONES PENDING" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding MilestonesDueThisWeekCount}" FontSize="24" FontWeight="Bold" Foreground="#D97706"/>
                            <TextBlock Text="Action Goals In-Progress" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 4: Plans Closed -->
                    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="18,16">
                        <Border.Effect><DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="10" ShadowDepth="2"/></Border.Effect>
                        <StackPanel>
                            <TextBlock Text="PLANS CLOSED / GRADUATED" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding ClosedPlanCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                            <TextBlock Text="Successfully Restored" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Control Toolbar -->
                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="16,14" Margin="0,0,0,20">
                    <Border.Effect><DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="10" ShadowDepth="2"/></Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search -->
                        <TextBox Grid.Column="0" Style="{DynamicResource ModernTextBoxStyle}" 
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 Margin="0,0,12,0"/>

                        <!-- Focus Area Dropdown -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Focus Area:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,6,0"/>
                            <ComboBox ItemsSource="{Binding FocusAreaList}" SelectedItem="{Binding SelectedFocusArea}" Width="170" Height="36" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Status Filter Dropdown -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Status:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,6,0"/>
                            <ComboBox ItemsSource="{Binding StatusFilterList}" SelectedItem="{Binding SelectedStatusFilter}" Width="130" Height="36" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Primary Action Button -->
                        <Button Grid.Column="3" Content="+ Create New Action Plan" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding OpenCreateModalCommand}" Padding="16,0" Height="36"/>
                    </Grid>
                </Border>

                <!-- DataGrid Panel -->
                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="20,16">
                    <Border.Effect><DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="10" ShadowDepth="2"/></Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Active Individual Action Plans Dossier" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,12"/>

                        <DataGrid ItemsSource="{Binding ActionPlans}" SelectedItem="{Binding SelectedPlan}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BorderBrush}" AlternatingRowBackground="{DynamicResource TableRowAltBrush}" Background="{DynamicResource CardBackgroundBrush}" RowBackground="{DynamicResource CardBackgroundBrush}" HeadersVisibility="Column" BorderThickness="0" RowHeight="46">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource TableHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Plan ID" Binding="{Binding Id}" Width="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Padding" Value="8,0"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Student Name &amp; ID" Binding="{Binding StudentName}" Width="1.5*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Padding" Value="8,0"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Focus Domain" Binding="{Binding FocusArea}" Width="1.8*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Padding" Value="8,0"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Assigned Counselor" Binding="{Binding AssignedCounselor}" Width="1.2*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Padding" Value="8,0"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Target Review" Binding="{Binding ReviewDate}" Width="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Header="Milestone Progress" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Margin="8,0">
                                                <ProgressBar Value="{Binding MilestoneProgressPercent, Mode=OneWay}" Height="6" Background="{DynamicResource TableHoverBrush}" Foreground="#059669" BorderThickness="0" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding ProgressText}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="FontWeight" Value="Bold"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Header="Actions" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Open Dossier"
                                                    Command="{Binding DataContext.OpenDossierCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                    CommandParameter="{Binding}"
                                                    Background="{DynamicResource TableHoverBrush}" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" Foreground="{DynamicResource PrimaryBrush}" FontSize="11" FontWeight="SemiBold" Height="28" Padding="10,0" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Background="{TemplateBinding Background}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Overlays for Modal Dialogs -->
        <views:CreateIapModal Visibility="{Binding IsCreateModalOpen, Converter={StaticResource BoolToVis}}"/>
        <views:IapDossierModal Visibility="{Binding IsDossierModalOpen, Converter={StaticResource BoolToVis}}"/>
    </Grid>
</UserControl>