<UserControl x:Class="SmartSchoolIncidentManagementSystem.Views.RecidivismAnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Background="{DynamicResource AppBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header & Top Actions -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <StackPanel VerticalAlignment="Center">
                    <Button Content="&#x2190; Back to Reports Hub" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding BackToHubCommand}" HorizontalAlignment="Left" Padding="10,4" Margin="0,0,0,10"/>
                    <TextBlock Text="Recidivism &amp; Offender Behavioral Analytics" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="Evaluate repeat infraction trends, chronic offender watchlists, and sanction intervention efficacy." FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <Button Content="🖨️ Export Analytics PDF" Command="{Binding ExportReportCommand}" Style="{DynamicResource PrimaryButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Height="36" Padding="16,0"/>
            </Grid>

            <!-- TOP KPI RIBBON (2 Wide Cards) -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- KPI 1: Recidivism Rate -->
                <Border Grid.Column="0" Style="{DynamicResource CardBorderStyle}" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="OVERALL SCHOOL RECIDIVISM RATE" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="{Binding Summary.RecidivismRate, StringFormat='{}{0}%'}" FontSize="28" FontWeight="Bold" Foreground="#4F46E5"/>
                                <TextBlock Text="Repeat Offense Index" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Bottom" Margin="10,0,0,4"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="1" Width="44" Height="44" CornerRadius="8" Background="#EEF2FF" VerticalAlignment="Center">
                            <TextBlock Text="📈" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- KPI 2: Top Intervention -->
                <Border Grid.Column="2" Style="{DynamicResource CardBorderStyle}" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="MOST EFFECTIVE SANCTION INTERVENTION" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                            <TextBlock Text="{Binding Summary.MostEffectiveIntervention}" FontSize="18" FontWeight="Bold" Foreground="#059669" Margin="0,8,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="44" Height="44" CornerRadius="8" Background="#ECFDF5" VerticalAlignment="Center">
                            <TextBlock Text="🎯" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- MIDDLE SECTION: CHARTS (40/60 Split) -->
            <Grid Grid.Row="2" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="6*"/>
                </Grid.ColumnDefinitions>

                <!-- Donut Chart: Offender Distribution -->
                <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Offender Distribution" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="Single vs. Repeat vs. Chronic Students" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,12"/>
                        <lvc:PieChart Series="{Binding OffenderDistributionSeries}" LegendPosition="Right" Height="220"/>
                    </StackPanel>
                </Border>

                <!-- Column Chart: Intervention Success Rates -->
                <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Sanction &amp; Intervention Efficacy Rate (%)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="Percentage of students who did NOT re-offend post-sanction." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,12"/>
                        <lvc:CartesianChart Series="{Binding InterventionSuccessSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}" Height="220"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- BOTTOM SECTION: CHRONIC OFFENDER WATCHLIST DATAGRID -->
            <Border Grid.Row="3" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="Chronic Offender Watchlist (3+ Incidents Logged)" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="High-risk students requiring intensive counseling and behavioral action plans." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding ChronicWatchlist}" SelectedItem="{Binding SelectedWatchItem}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BorderBrush}" Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="{DynamicResource TableRowAltBrush}" Foreground="{DynamicResource PrimaryTextBrush}" HeadersVisibility="Column" BorderThickness="0" RowHeight="46">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Student ID" Binding="{Binding StudentId}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="8,0"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Student Name" Binding="{Binding StudentName}" Width="1.5*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="8,0"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Grade &amp; Section" Binding="{Binding GradeSection}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="8,0"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Total Incidents" Binding="{Binding TotalIncidents}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Primary Offense" Binding="{Binding MostCommonOffense}" Width="2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="8,0"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="IAP Status" Binding="{Binding ActiveIapStatus}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Action" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Open File / Transcript" Command="{Binding DataContext.OpenStudentTranscriptCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" CommandParameter="{Binding}" Style="{DynamicResource SecondaryButtonStyle}" Height="30" FontSize="11" Padding="10,0" Margin="4,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>