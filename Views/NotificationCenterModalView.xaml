<UserControl x:Class="SmartSchoolIncidentManagementSystem.Views.NotificationCenterModalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="480" d:DesignWidth="420">

    <UserControl.Resources>
        <Style x:Key="NotifContainerStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource FlyoutBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsKioskActive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource KioskFlyoutBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource KioskBarBorderBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NotifDividerStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsKioskActive}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource KioskDividerBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NotifPrimaryTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsKioskActive}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource KioskTextPrimaryBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NotifSecondaryTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsKioskActive}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource KioskTextSecondaryBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NotifMutedTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsKioskActive}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource KioskTextMutedBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NotifAccentTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsKioskActive}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource KioskAccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border MinWidth="300" MaxWidth="420"
            Style="{StaticResource NotifContainerStyle}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="{DynamicResource ShadowOpacityFlyout}" BlurRadius="20" ShadowDepth="4" Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. COMPACT HEADER -->
            <Grid Grid.Row="0" Margin="14,12,10,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Notifications" FontSize="15" FontWeight="SemiBold"
                               Style="{StaticResource NotifPrimaryTextStyle}" VerticalAlignment="Center"/>
                    <Border Visibility="{Binding HasUnreadNotifications, Converter={StaticResource BoolToVis}}"
                            Background="{DynamicResource DangerBrush}" CornerRadius="999"
                            Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding UnreadNotificationCount}"
                                   FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ButtonTextBrush}"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding MarkAllNotificationsAsReadCommand}"
                            Content="Mark all read" FontSize="12" Height="26" Padding="8,0"
                            ToolTip="Mark all notifications as read">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource LinkButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKioskActive}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource KioskAccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding CloseNotificationModalCommand}"
                            Content="✕" FontSize="12" Margin="4,0,0,0" ToolTip="Close">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource CompactIconButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKioskActive}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource KioskTextPrimaryBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. COMPACT FILTER BAR -->
            <Border Grid.Row="1" Style="{StaticResource NotifDividerStyle}" BorderThickness="0,0,0,1" Padding="14,0,14,8">
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding FilterAllNotificationsCommand}" Height="26" Padding="10,0" Margin="0,0,6,0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKioskActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource KioskButtonBgBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource KioskTextPrimaryBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource KioskTileBorderBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsAllFilterActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="All" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Button>

                    <Button Command="{Binding FilterUnreadNotificationsCommand}" Height="26" Padding="10,0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKioskActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource KioskButtonBgBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource KioskTextPrimaryBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource KioskTileBorderBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsUnreadFilterActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="Unread" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- 3. CLEAN FLAT NOTIFICATION LIST -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Empty State -->
                    <StackPanel Visibility="{Binding HasFilteredNotifications, Converter={StaticResource InverseBoolToVis}}"
                                HorizontalAlignment="Center" Margin="20,36">
                        <TextBlock Text="You're all caught up" FontSize="14" FontWeight="SemiBold"
                                   Style="{StaticResource NotifPrimaryTextStyle}" HorizontalAlignment="Center"/>
                        <TextBlock Text="No unread notifications." FontSize="12"
                                   Style="{StaticResource NotifMutedTextStyle}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding FilteredNotifications}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,0,0,1" Padding="14,10" Cursor="Hand" ToolTip="Click to open">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsKioskActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource KioskDividerBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsRead}" Value="False">
                                                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsRead}" Value="False"/>
                                                        <Condition Binding="{Binding DataContext.IsKioskActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Background" Value="{DynamicResource KioskFlyoutUnreadBrush}"/>
                                                </MultiDataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource TableHoverBrush}"/>
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                    </MultiTrigger.Conditions>
                                                </MultiTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                        <Condition Binding="{Binding DataContext.IsKioskActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Background" Value="{DynamicResource KioskFlyoutHoverBrush}"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.NavigateNotificationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Unread indicator dot -->
                                        <Ellipse Grid.Column="0" Width="6" Height="6"
                                                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,5,0,0"
                                                 Visibility="{Binding IsRead, Converter={StaticResource InverseBoolToVis}}">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsKioskActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource KioskAccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>

                                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.IsKioskActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource KioskAccentBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text=" · " FontSize="11">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.IsKioskActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource KioskTextMutedBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding TimeAgoText}" FontSize="11">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.IsKioskActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource KioskTextMutedBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.IsKioskActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource KioskTextPrimaryBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <TextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" LineHeight="16">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.IsKioskActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource KioskTextSecondaryBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="›" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsKioskActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource KioskTextMutedBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
