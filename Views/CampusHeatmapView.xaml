<UserControl x:Class="SmartSchoolIncidentManagementSystem.Views.CampusHeatmapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <Button Content="&#x2190; Back to Reports Hub" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding BackToHubCommand}" HorizontalAlignment="Left" Padding="10,4" Margin="0,0,0,10"/>
                <TextBlock Text="Campus Danger Heatmap &amp; Patrol Priorities" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <TextBlock Text="Real-time incident frequency mapping across school grounds to optimize security officer patrol routes." FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- TOP FILTER BAR -->
            <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="16,12" Margin="0,0,0,20">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Timeframe:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding TimeframeModes}" SelectedItem="{Binding SelectedTimeframeMode}" Width="170" Height="36" VerticalContentAlignment="Center" Margin="0,0,12,0"/>

                    <!-- DatePicker for Day -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsDatePickVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,12,0">
                        <TextBlock Text="Date:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <DatePicker SelectedDate="{Binding SelectedHeatmapDate}" Width="135" Height="36" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Month Picker -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsMonthPickVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,12,0">
                        <TextBlock Text="Month:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding AvailableMonths}" SelectedItem="{Binding SelectedMonthName}" Width="120" Height="36" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Year Picker -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsYearPickVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,12,0">
                        <TextBlock Text="Year:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding AvailableYears}" SelectedItem="{Binding SelectedYear}" Width="90" Height="36" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="Category:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Width="170" Height="36" VerticalContentAlignment="Center" Margin="0,0,16,0"/>

                    <Button Content="{Binding RefreshButtonText, FallbackValue='🔄 Refresh Data'}" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsNotRefreshing}" Style="{DynamicResource SecondaryButtonStyle}" Height="36" Padding="14,0"/>
                </WrapPanel>
            </Border>

            <!-- SPLIT PANE GRID (70/30) -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="7*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN: Campus Map Canvas (70%) -->
                <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="20">
                    <Border.Effect><DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="10" ShadowDepth="2"/></Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="Interactive Campus Danger Map" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="{Binding TimeframeSummaryText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- MAP SCHEMATIC & CANVAS CONTAINER -->
                        <Border Grid.Row="1" Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Height="420" ClipToBounds="True">
                            <Grid>
                                <!-- Campus Schematic Blueprint Mockup -->
                                <Canvas>
                                    <!-- Building Rectangles -->
                                    <Border Canvas.Left="40" Canvas.Top="40" Width="200" Height="140" Background="{DynamicResource TableHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" CornerRadius="6">
                                        <TextBlock Text="GYMNASIUM &amp; SPORTS COMPLEX" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                    </Border>

                                    <Border Canvas.Left="260" Canvas.Top="40" Width="140" Height="90" Background="{DynamicResource TableHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" CornerRadius="6">
                                        <TextBlock Text="RESTROOMS &amp; LOCKERS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                    </Border>

                                    <Border Canvas.Left="420" Canvas.Top="40" Width="220" Height="140" Background="{DynamicResource TableHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" CornerRadius="6">
                                        <TextBlock Text="SCIENCE &amp; IT LAB WING" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                    </Border>

                                    <Border Canvas.Left="240" Canvas.Top="150" Width="160" Height="70" Background="{DynamicResource WarningBgBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1.5" CornerRadius="6">
                                        <TextBlock Text="CAFETERIA &amp; CANTEEN" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                    </Border>

                                    <Border Canvas.Left="40" Canvas.Top="240" Width="200" Height="140" Background="{DynamicResource TableHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" CornerRadius="6">
                                        <TextBlock Text="COVERED BASKETBALL COURT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                    </Border>

                                    <Border Canvas.Left="260" Canvas.Top="240" Width="140" Height="140" Background="{DynamicResource TableHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" CornerRadius="6">
                                        <TextBlock Text="MAIN HALLWAY &amp; LOBBY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                    </Border>

                                    <Border Canvas.Left="420" Canvas.Top="220" Width="140" Height="120" Background="{DynamicResource TableHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" CornerRadius="6">
                                        <TextBlock Text="LIBRARY &amp; STUDY HALL" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                    </Border>

                                    <Border Canvas.Left="570" Canvas.Top="280" Width="120" Height="100" Background="{DynamicResource TableHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" CornerRadius="6">
                                        <TextBlock Text="EAST PARKING LOT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                    </Border>
                                </Canvas>

                                <!-- DYNAMIC HEATMAP OVERLAY CANVAS -->
                                <ItemsControl ItemsSource="{Binding HeatmapNodes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding CanvasLeft}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding CanvasTop}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Ellipse Width="{Binding Radius}" Height="{Binding Radius}" Fill="{Binding RiskColor}" Cursor="Hand">
                                                <Ellipse.InputBindings>
                                                    <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.SelectLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                </Ellipse.InputBindings>
                                                <Ellipse.Effect><BlurEffect Radius="8"/></Ellipse.Effect>
                                                <Ellipse.ToolTip>
                                                    <ToolTip Style="{DynamicResource ModernToolTipStyle}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding LocationName}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                            <TextBlock Text="{Binding IncidentCount, StringFormat='Total Incidents: {0}'}" FontSize="11" Foreground="{Binding NodeTextBrush}" Margin="0,2,0,0"/>
                                                            <TextBlock Text="{Binding PrimaryInfraction, StringFormat='Top Category: {0}'}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                                                            <TextBlock Text="{Binding RiskLevelText, StringFormat='Status: {0}'}" FontSize="11" FontWeight="Bold" Foreground="{Binding NodeTextBrush}" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </ToolTip>
                                                </Ellipse.ToolTip>
                                            </Ellipse>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- RIGHT COLUMN: Risk Ranking & Patrol Priorities (30%) / Selected Zone Incident Inspector -->
                <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="20">
                    <Border.Effect><DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="10" ShadowDepth="2"/></Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Title & Clear Button -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="{Binding SelectedLocationTitle}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                <TextBlock Text="Click a zone to inspect incidents." FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Content="✕ All" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding ClearSelectedLocationCommand}" Visibility="{Binding HasSelectedLocation, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="8,2" FontSize="11"/>
                        </DockPanel>

                        <!-- Scrollable Content: Top Locations OR Selected Zone Incidents -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Location Ranking ItemsControl (When HasSelectedLocation is False) -->
                                <ItemsControl ItemsSource="{Binding TopLocations}">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSelectedLocation}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource TableHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10" Cursor="Hand">
                                                <Border.InputBindings>
                                                    <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.SelectLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding LocationName}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                        <TextBlock Text="{Binding PrimaryInfraction, StringFormat='Infraction: {0}'}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                                                        <TextBlock Text="{Binding IncidentCount, StringFormat='{}{0} Incidents Logged'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,2,0,0"/>
                                                    </StackPanel>

                                                    <Border Grid.Column="1" Background="{Binding RiskColor}" CornerRadius="4" Padding="6,2" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding RiskLevelText}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ButtonTextBrush}"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Selected Zone Incidents (When HasSelectedLocation is True) -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSelectedLocation}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <ItemsControl ItemsSource="{Binding SelectedLocationIncidents}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{DynamicResource CardBorderStyle}" Padding="10" Margin="0,0,0,8" Background="{DynamicResource SurfaceBackgroundBrush}">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,4">
                                                            <TextBlock Text="{Binding IncidentNumber}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource PrimaryBrush}"/>
                                                            <Border HorizontalAlignment="Right" Background="{DynamicResource DangerBgBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1">
                                                                <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}"/>
                                                            </Border>
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding IncidentDate, StringFormat='🗓️ {0:MMM dd, yyyy • hh:mm tt}'}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                                                        <TextBlock Text="{Binding StudentDisplayName, StringFormat='👤 Student: {0}'}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Bottom Export Button -->
                        <Button Grid.Row="2" Content="🖨️ Export Location Report (PDF)" Command="{Binding ExportLocationReportCommand}" Style="{DynamicResource PrimaryButtonStyle}" HorizontalAlignment="Stretch" Height="40" FontSize="13" FontWeight="Bold" Margin="0,14,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>