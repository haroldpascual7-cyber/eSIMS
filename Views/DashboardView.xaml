<UserControl x:Class="SmartSchoolIncidentManagementSystem.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="760" d:DesignWidth="1200"
             Background="{DynamicResource AppBackgroundBrush}">

    <UserControl.Resources>
        <Style x:Key="KpiCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource TableHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InlineStatCellStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource TableHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Single-screen, non-scrolling dashboard layout -->
    <Grid Margin="20,12,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0. Compact flat header + scope & refresh -->
            <RowDefinition Height="Auto"/> <!-- 1. Tier 1: 5 Primary Safety KPIs -->
            <RowDefinition Height="Auto"/> <!-- 2. Tier 2: Unified Operations Strip -->
            <RowDefinition Height="*"/>    <!-- 3. Recent Incidents Table (fills remaining viewport) -->
        </Grid.RowDefinitions>

        <!-- 0. FLAT ACTION BAR (titlebar already shows eSIMS · Dashboard) -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Button Content="{Binding CampusOverviewTabHeader}"
                        Command="{Binding SelectCampusOverviewCommand}"
                        Height="32" Padding="12,0" Margin="0,0,6,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCampusOverviewActive}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{Binding MyCaseloadTabHeader}"
                        Command="{Binding SelectMyCaseloadCommand}"
                        Height="32" Padding="12,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMyCaseloadActive}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <Button Content="{Binding RefreshButtonText, FallbackValue='↻ Refresh'}"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    Command="{Binding RefreshCommand}"
                    IsEnabled="{Binding IsNotRefreshing}"
                    Height="32" Padding="12,0"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    ToolTip="Refresh Operational Metrics"/>
        </Grid>

        <!-- 1. TIER 1: PRIMARY SAFETY & INCIDENT METRICS (5 equal columns) -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Incidents -->
            <Border Grid.Column="0" Style="{StaticResource KpiCardStyle}" Margin="0,0,8,0" ToolTip="Click to open Incident Registry">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CardClickTotalCommand}"/>
                </Border.InputBindings>
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="{Binding CardTotalTitle}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Text="→" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <TextBlock Text="{Binding TotalIncidents}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="{Binding TotalIncidentsSubtitle, FallbackValue='All safety reports'}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <!-- Reported / Triage -->
            <Border Grid.Column="1" Style="{StaticResource KpiCardStyle}" Margin="0,0,8,0" ToolTip="Click to view Open &amp; Reported Incidents">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CardClickReportedCommand}"/>
                </Border.InputBindings>
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="{Binding CardReportedTitle}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Text="→" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <TextBlock Text="{Binding OpenIncidents}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                    <TextBlock Text="{Binding CardReportedSubtitle}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <!-- Active Inquiries -->
            <Border Grid.Column="2" Style="{StaticResource KpiCardStyle}" Margin="0,0,8,0" ToolTip="Click to view Investigations Workspace">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CardClickInquiriesCommand}"/>
                </Border.InputBindings>
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="{Binding CardInquiriesTitle}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Text="→" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <TextBlock Text="{Binding TotalInvestigations}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource InfoBrush}"/>
                    <TextBlock Text="{Binding CardInquiriesSubtitle}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <!-- Cases Resolved -->
            <Border Grid.Column="3" Style="{StaticResource KpiCardStyle}" Margin="0,0,8,0" ToolTip="Click to view Resolved Cases">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CardClickResolvedCommand}"/>
                </Border.InputBindings>
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="{Binding CardResolvedTitle}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Text="→" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <TextBlock Text="{Binding ResolvedIncidents}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                    <TextBlock Text="{Binding CardResolvedSubtitle}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <!-- High / Critical Risk -->
            <Border Grid.Column="4" Style="{StaticResource KpiCardStyle}" ToolTip="Click to inspect Critical &amp; High Risk Incidents">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CardClickCriticalCommand}"/>
                </Border.InputBindings>
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="{Binding CardCriticalTitle}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Text="→" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <TextBlock Text="{Binding CriticalIncidents}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/>
                    <TextBlock Text="{Binding CardCriticalSubtitle}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2. TIER 2: UNIFIED SCHOOL OPERATIONS STRIP (1 clean container instead of 4 extra boxes) -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource InlineStatCellStyle}" CornerRadius="8,0,0,8" ToolTip="Click to open Students Directory">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateStudentsCommand}"/>
                    </Border.InputBindings>
                    <DockPanel>
                        <TextBlock Text="{Binding TotalStudents}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Enrolled Students" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="Active directory" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Width="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                <Border Grid.Column="2" Style="{StaticResource InlineStatCellStyle}" ToolTip="Click to view Staff &amp; Faculty Records">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateUserManagementCommand}"/>
                    </Border.InputBindings>
                    <DockPanel>
                        <TextBlock Text="{Binding TotalStaff}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource InfoBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Faculty &amp; Staff" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="Educators &amp; staff" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Grid.Column="3" Width="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                <Border Grid.Column="4" Style="{StaticResource InlineStatCellStyle}" ToolTip="Click to open Behavior &amp; IAP Workspace">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateBehaviorCommand}"/>
                    </Border.InputBindings>
                    <DockPanel>
                        <TextBlock Text="{Binding TotalActionPlans}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Action &amp; Merit Plans" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="Restorative &amp; IAP" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Grid.Column="5" Width="1" Background="{DynamicResource DividerBrush}" Margin="0,8"/>

                <Border Grid.Column="6" Style="{StaticResource InlineStatCellStyle}" CornerRadius="0,8,8,0" ToolTip="Click to open Parent Notices &amp; Letters">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateParentNoticesCommand}"/>
                    </Border.InputBindings>
                    <DockPanel>
                        <TextBlock Text="{Binding TotalParentNotices}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Parent Disclosures" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="Letters dispatched" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 3. TIER 3: RECENT INCIDENTS FEED (fills remaining space, internal scroll only if needed) -->
        <Border Grid.Row="3" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Recent Incidents" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="{Binding ScopeBadgeText, StringFormat='  ·  {0}'}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Content="View Complete Registry →" Style="{DynamicResource SecondaryButtonStyle}"
                            Command="{Binding ViewAllIncidentsCommand}" Height="30" Padding="10,0" HorizontalAlignment="Right"/>
                </DockPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding RecentIncidents}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="8,8" Cursor="Hand" ToolTip="Click to inspect case details">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource TableHoverBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.SelectIncidentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="125"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="{DynamicResource PrimaryBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding IncidentNumber}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ButtonTextBrush}"/>
                                        </Border>

                                        <TextBlock Grid.Column="1" Text="{Binding IncidentDate, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding StudentDisplayName, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text=" · " FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                <TextBlock Text="{Binding Category, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Grid.Column="3" CornerRadius="4" Padding="8,3" Margin="0,0,8,0" VerticalAlignment="Center" Background="{DynamicResource TableHoverBrush}">
                                            <TextBlock Text="{Binding Severity}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        </Border>

                                        <Border Grid.Column="4" CornerRadius="4" Padding="8,3" Margin="0,0,8,0" VerticalAlignment="Center" Background="{DynamicResource DangerBgBrush}">
                                            <TextBlock Text="{Binding Risk}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/>
                                        </Border>

                                        <Border Grid.Column="5" CornerRadius="4" Padding="8,3" VerticalAlignment="Center" Background="{DynamicResource TableHoverBrush}">
                                            <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
