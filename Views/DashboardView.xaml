<UserControl x:Class="SmartSchoolIncidentManagementSystem.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="950" d:DesignWidth="1280"
             Background="{DynamicResource AppBackgroundBrush}">

    <UserControl.Resources>
        <!-- Interactive Information Card (icard) Style -->
        <Style x:Key="InteractiveInfoCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource TableHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Action Strip Button Style -->
        <Style x:Key="ActionStripButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 1. Header Bar -->
                <RowDefinition Height="Auto"/> <!-- 2. Quick Action Strip -->
                <RowDefinition Height="Auto"/> <!-- 3. Tier 1 Incidents Telemetry (5 icards) -->
                <RowDefinition Height="Auto"/> <!-- 4. Tier 2 School Operations Telemetry (4 icards) -->
                <RowDefinition Height="*"/>    <!-- 5. Live Recent Incident Feed & Audit Log -->
            </Grid.RowDefinitions>

            <!-- 1. TOP HEADER BAR: WORKSPACE TITLE & LIVE USER PROFILE -->
            <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="18,14" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- School Logo / Brand Shield -->
                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Background="{DynamicResource PrimaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="🛡️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Workspace Branding Header -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DashboardTitle}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="{Binding RoleSubheader}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Right User Profile Pill & Actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- User Profile Card -->
                        <Border Background="{DynamicResource TableHoverBrush}" CornerRadius="8" Padding="12,6" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource PrimaryBrush}" Margin="0,0,8,0">
                                    <TextBlock Text="👤" FontSize="12" Foreground="{DynamicResource ButtonTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding UserFullName}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding UserRole}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock Text=" • " FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock Text="● Online" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Notification Bell Badge Button -->
                        <Border Visibility="{Binding IsNotificationBadgeVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,8,0">
                            <Button Command="{Binding ViewNotificationsCommand}"
                                    Background="{DynamicResource DangerBrush}" BorderBrush="{DynamicResource DangerBrush}"
                                    Height="38" Padding="12,0" ToolTip="Open Notifications Modal">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🔔" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding NewIncidentCount}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ButtonTextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>

                        <!-- Theme Switcher Button -->
                        <Button Content="🌓" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding ToggleThemeCommand}" 
                                Height="38" Width="38" Padding="0" Margin="0,0,8,0" FontSize="14" ToolTip="Toggle Light / Dark Mode"/>

                        <!-- Refresh Button -->
                        <Button Content="↻ Refresh" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding RefreshCommand}" Height="38" Padding="12,0" Margin="0,0,8,0"/>

                        <!-- Return to Full-Screen Tablet Launcher Button -->
                        <Button Content="🗂️ Tablet Launcher" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding ReturnToTabletDashboardCommand}" Height="38" Padding="14,0" ToolTip="Switch back to full-screen Metro Tablet launcher"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. QUICK OPERATIONAL ACTIONS STRIP -->
            <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14,10" Margin="0,0,0,16">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚡ Quick Shortcuts:" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <Button Content="+ Report Incident" Style="{DynamicResource PrimaryButtonStyle}" Height="36" Padding="14,0" Margin="0,0,10,0"
                                Command="{Binding NewIncidentCommand}"
                                Visibility="{Binding IsNewIncidentButtonVisible, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="📋 Incident Registry" Style="{StaticResource ActionStripButtonStyle}" Command="{Binding NavigateIncidentListCommand}"/>
                        <Button Content="🔍 Investigations" Style="{StaticResource ActionStripButtonStyle}" Command="{Binding NavigateInvestigationsCommand}"/>
                        <Button Content="👥 Student Directory" Style="{StaticResource ActionStripButtonStyle}" Command="{Binding NavigateStudentsCommand}"/>
                        <Button Content="📈 Behavior &amp; Plans" Style="{StaticResource ActionStripButtonStyle}" Command="{Binding NavigateBehaviorCommand}"/>
                        <Button Content="✉️ Parent Notices" Style="{StaticResource ActionStripButtonStyle}" Command="{Binding NavigateParentNoticesCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. TIER 1: INCIDENT & CASE SAFETY TELEMETRY (5 ICARDS) -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="SAFETY &amp; INCIDENT METRICS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="2,0,0,8"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- iCard 1: Total Incidents -->
                    <Border Grid.Column="0" Style="{StaticResource InteractiveInfoCardStyle}" Margin="0,0,8,0" ToolTip="Click to open Incident Registry">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateIncidentListCommand}"/>
                        </Border.InputBindings>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Border Width="32" Height="32" CornerRadius="6" Background="{DynamicResource PrimaryBrush}" HorizontalAlignment="Left">
                                    <TextBlock Text="🚨" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="→" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{Binding TotalIncidents}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <StackPanel Grid.Row="2" Margin="0,4,0,0">
                                <TextBlock Text="Total Incidents" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text="All safety reports" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- iCard 2: Reported / Open -->
                    <Border Grid.Column="1" Style="{StaticResource InteractiveInfoCardStyle}" Margin="0,0,8,0" ToolTip="Click to view Open &amp; Reported Incidents">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateIncidentListCommand}"/>
                        </Border.InputBindings>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Border Width="32" Height="32" CornerRadius="6" Background="{DynamicResource WarningBgBrush}" HorizontalAlignment="Left">
                                    <TextBlock Text="📝" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="→" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{Binding OpenIncidents}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                            <StackPanel Grid.Row="2" Margin="0,4,0,0">
                                <TextBlock Text="Reported / Triage" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text="Pending review queue" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- iCard 3: Active Investigations -->
                    <Border Grid.Column="2" Style="{StaticResource InteractiveInfoCardStyle}" Margin="0,0,8,0" ToolTip="Click to view Investigations Workspace">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateInvestigationsCommand}"/>
                        </Border.InputBindings>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Border Width="32" Height="32" CornerRadius="6" Background="{DynamicResource InfoBgBrush}" HorizontalAlignment="Left">
                                    <TextBlock Text="🔍" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="→" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{Binding TotalInvestigations}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource InfoBrush}"/>
                            <StackPanel Grid.Row="2" Margin="0,4,0,0">
                                <TextBlock Text="Active Inquiries" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text="Under investigation" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- iCard 4: Cases Resolved -->
                    <Border Grid.Column="3" Style="{StaticResource InteractiveInfoCardStyle}" Margin="0,0,8,0" ToolTip="Click to view Resolved Cases">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateIncidentListCommand}"/>
                        </Border.InputBindings>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Border Width="32" Height="32" CornerRadius="6" Background="{DynamicResource SuccessBgBrush}" HorizontalAlignment="Left">
                                    <TextBlock Text="✅" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="→" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{Binding ResolvedIncidents}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                            <StackPanel Grid.Row="2" Margin="0,4,0,0">
                                <TextBlock Text="Cases Resolved" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text="Successfully concluded" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- iCard 5: Critical / High Risk -->
                    <Border Grid.Column="4" Style="{StaticResource InteractiveInfoCardStyle}" ToolTip="Click to inspect Critical &amp; High Risk Incidents">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateIncidentListCommand}"/>
                        </Border.InputBindings>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Border Width="32" Height="32" CornerRadius="6" Background="{DynamicResource DangerBgBrush}" HorizontalAlignment="Left">
                                    <TextBlock Text="⚠️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="→" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{Binding CriticalIncidents}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/>
                            <StackPanel Grid.Row="2" Margin="0,4,0,0">
                                <TextBlock Text="High / Critical Risk" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text="Requires priority attention" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- 4. TIER 2: SCHOOL OPERATIONS & INTERVENTIONS TELEMETRY (4 ICARDS) -->
            <Grid Grid.Row="3" Margin="0,0,0,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="POPULATION &amp; BEHAVIORAL SUPPORT TELEMETRY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="2,0,0,8"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- iCard 6: Enrolled Students -->
                    <Border Grid.Column="0" Style="{StaticResource InteractiveInfoCardStyle}" Margin="0,0,8,0" ToolTip="Click to open Students Directory">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateStudentsCommand}"/>
                        </Border.InputBindings>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Border Width="32" Height="32" CornerRadius="6" Background="{DynamicResource PrimaryBrush}" HorizontalAlignment="Left">
                                    <TextBlock Text="👥" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="→" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{Binding TotalStudents}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <StackPanel Grid.Row="2" Margin="0,4,0,0">
                                <TextBlock Text="Enrolled Students" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text="Active student directory" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- iCard 7: Faculty & Staff -->
                    <Border Grid.Column="1" Style="{StaticResource InteractiveInfoCardStyle}" Margin="0,0,8,0" ToolTip="Click to view Staff &amp; Faculty Records">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateStudentsCommand}"/>
                        </Border.InputBindings>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Border Width="32" Height="32" CornerRadius="6" Background="{DynamicResource InfoBgBrush}" HorizontalAlignment="Left">
                                    <TextBlock Text="🏫" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="→" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{Binding TotalStaff}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource InfoBrush}"/>
                            <StackPanel Grid.Row="2" Margin="0,4,0,0">
                                <TextBlock Text="Faculty &amp; Staff" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text="Educators &amp; school staff" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- iCard 8: Action & Merit Plans -->
                    <Border Grid.Column="2" Style="{StaticResource InteractiveInfoCardStyle}" Margin="0,0,8,0" ToolTip="Click to open Behavior &amp; IAP Workspace">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateBehaviorCommand}"/>
                        </Border.InputBindings>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Border Width="32" Height="32" CornerRadius="6" Background="{DynamicResource WarningBgBrush}" HorizontalAlignment="Left">
                                    <TextBlock Text="📈" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="→" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{Binding TotalActionPlans}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                            <StackPanel Grid.Row="2" Margin="0,4,0,0">
                                <TextBlock Text="Action &amp; Merit Plans" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text="Restorative &amp; IAP tracking" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- iCard 9: Parent Notices Dispatched -->
                    <Border Grid.Column="3" Style="{StaticResource InteractiveInfoCardStyle}" ToolTip="Click to open Parent Notices &amp; Letters">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateParentNoticesCommand}"/>
                        </Border.InputBindings>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Border Width="32" Height="32" CornerRadius="6" Background="{DynamicResource TableHoverBrush}" HorizontalAlignment="Left">
                                    <TextBlock Text="📬" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="→" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{Binding TotalParentNotices}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                            <StackPanel Grid.Row="2" Margin="0,4,0,0">
                                <TextBlock Text="Parent Disclosures" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text="Official letters dispatched" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- 5. RECENT INCIDENTS AUTOMATED ANALYSIS & AUDIT TRAIL LOG -->
            <Border Grid.Row="4" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Recent Automated Incident Analysis Log" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="Live real-time incident audit feed filtered for your active role." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="View Complete Registry →" Style="{DynamicResource SecondaryButtonStyle}"
                                    Command="{Binding ViewAllIncidentsCommand}" Height="34" Padding="12,0"/>
                        </StackPanel>
                    </Grid>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding RecentIncidents}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,12" Cursor="Hand" ToolTip="Click to inspect case details">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource TableHoverBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.SelectIncidentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="{DynamicResource PrimaryBrush}" CornerRadius="4" Padding="6,3" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding IncidentNumber}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ButtonTextBrush}"/>
                                        </Border>

                                        <Border Grid.Column="1" Background="{DynamicResource TableHoverBrush}" CornerRadius="4" Padding="8,4" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding IncidentDate, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </Border>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="👨‍🎓 Student: " FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
                                                <TextBlock Text="{Binding StudentDisplayName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,10,0"/>
                                                <TextBlock Text="•  " FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                <TextBlock Text="{Binding Category}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Grid.Column="3" CornerRadius="4" Padding="8,4" Margin="0,0,12,0" VerticalAlignment="Center" Background="{DynamicResource TableHoverBrush}">
                                            <TextBlock Text="{Binding Severity, StringFormat='Severity: {0}'}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        </Border>

                                        <Border Grid.Column="4" CornerRadius="4" Padding="8,4" Margin="0,0,12,0" VerticalAlignment="Center" Background="{DynamicResource DangerBgBrush}">
                                            <TextBlock Text="{Binding Risk, StringFormat='Risk: {0}'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/>
                                        </Border>

                                        <Border Grid.Column="5" CornerRadius="4" Padding="8,4" Margin="0,0,8,0" VerticalAlignment="Center" Background="{DynamicResource TableHoverBrush}">
                                            <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        </Border>

                                        <TextBlock Grid.Column="6" Text="→" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>