<UserControl x:Class="SmartSchoolIncidentManagementSystem.Views.LetterTemplateSheetPreviewModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d">
    <Grid Margin="-260,-60,-20,-20" Panel.ZIndex="1000" Background="{DynamicResource ModalOverlayBrush}">
        <Border Style="{DynamicResource CardBorderStyle}" Width="700" MaxHeight="850" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0" CornerRadius="12" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Modal Action Header -->
                    <RowDefinition Height="*"/>    <!-- Real-life Paper Sheet Document -->
                    <RowDefinition Height="Auto"/> <!-- Modal Bottom Toolbar -->
                </Grid.RowDefinitions>

                <!-- 1. Modal Top Header -->
                <Border Grid.Row="0" Background="{DynamicResource TableHoverBrush}" Padding="20,14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ViewingEnhancedTemplate.Icon, FallbackValue='📄'}" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ViewingTemplate.TemplateName, FallbackValue='Official Letter Preview'}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                            <Border Margin="10,0,0,0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ViewingEnhancedTemplate.ReferenceCode, FallbackValue='REF: SA-DISC'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </Border>
                        </StackPanel>
                        <Button Content="✕" Style="{DynamicResource SecondaryButtonStyle}" HorizontalAlignment="Right" Command="{Binding CloseTemplateCardCommand}" Width="32" Height="32" Padding="0" FontSize="13" FontWeight="Bold"/>
                    </DockPanel>
                </Border>

                <!-- 2. Authentic Real-Life Document Sheet -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" CornerRadius="4" Padding="36,32">
                        <StackPanel>
                            <!-- Official School Letterhead Header -->
                            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,16">
                                <TextBlock Text="REPUBLIC OF THE PHILIPPINES" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="DEPARTMENT OF EDUCATION • REGION XI" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,1,0,4"/>
                                <TextBlock Text="SMART ACADEMY" FontSize="20" FontWeight="ExtraBold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="OFFICE OF STUDENT AFFAIRS &amp; GUIDANCE COUNSELING" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,2,0,2"/>
                                <TextBlock Text="Cor. Rizal &amp; Quezon Avenue, Digos City, Davao Del Sur • Tel: (082) 553-2411 • guidance@smartacademy.edu.ph" FontSize="9" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center"/>
                                <Border Height="2" Background="{DynamicResource PrimaryBrush}" Margin="0,10,0,0" Width="540"/>
                                <Border Height="0.8" Background="{DynamicResource AccentBrush}" Margin="0,2,0,0" Width="540"/>
                            </StackPanel>

                            <!-- Document Control Bar -->
                            <Grid Margin="0,4,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding ViewingEnhancedTemplate.ReferenceCode, StringFormat='Control Ref No.: {0}'}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock Text="{Binding RealisticCurrentDate, StringFormat='Date of Issue: {0}'}" FontSize="10.5" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource TableHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ViewingEnhancedTemplate.DocumentBadge, FallbackValue='OFFICIAL ADVISORY'}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                                </Border>
                            </Grid>

                            <!-- Addressee Line -->
                            <Border Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="MEMORANDUM FOR: PARENT / LEGAL GUARDIAN" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <TextBlock Text="{Binding ViewingTemplate.TemplateName, StringFormat='SUBJECT: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Document Body Text -->
                            <TextBox Text="{Binding ViewingTemplate.TemplateBody}" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" FontSize="12" FontFamily="Segoe UI" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,24"/>

                            <!-- Official Signatures Block -->
                            <Grid Margin="0,8,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Officer -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Prepared &amp; Issued by:" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,28"/>
                                    <Border Height="1" Background="{DynamicResource PrimaryTextBrush}" Width="180" HorizontalAlignment="Left"/>
                                    <TextBlock Text="Guidance Counselor" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,4,0,0"/>
                                    <TextBlock Text="Office of Student Welfare" FontSize="9.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </StackPanel>

                                <!-- Seal Watermark Emblem -->
                                <Border Grid.Column="1" Width="76" Height="76" CornerRadius="38" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="⚖️" FontSize="16" HorizontalAlignment="Center"/>
                                        <TextBlock Text="OFFICIAL" FontSize="7.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                        <TextBlock Text="SEAL" FontSize="7.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Right Authority -->
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                    <TextBlock Text="Approved by:" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,28"/>
                                    <Border Height="1" Background="{DynamicResource PrimaryTextBrush}" Width="180" HorizontalAlignment="Right"/>
                                    <TextBlock Text="Discipline Prefect / Principal" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                    <TextBlock Text="Smart Academy Administration" FontSize="9.5" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>

                            <!-- Perforated Tear-off Parent Return Slip -->
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="✂ - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - ✂" FontSize="9" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <Border Background="{DynamicResource TableHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="PARENT / GUARDIAN ACKNOWLEDGMENT RETURN SLIP" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="(Return to Guidance Office within 48 hours)" FontSize="9.5" FontStyle="Italic" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Student Name: ________________________________" FontSize="10" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Grid.Column="1" Text="Grade &amp; Section: ____________________" FontSize="10" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Parent / Guardian Signature: ____________________" FontSize="10" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Grid.Column="1" Text="Date Received: ____________________" FontSize="10" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        </Grid>
                                        <TextBlock Text="[  ] I confirm receipt of this notice and will attend the conference / comply with disciplinary instructions." FontSize="9.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <!-- 3. Modal Bottom Action Toolbar -->
                <Border Grid.Row="2" Background="{DynamicResource TableHoverBrush}" Padding="20,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                    <DockPanel>
                        <Button Content="🖨️ Export PDF / Print Letter" Style="{DynamicResource SecondaryButtonStyle}"
                                Command="{Binding ExportTemplatePdfDirectCommand}"
                                CommandParameter="{Binding ViewingTemplate}"
                                Height="36" Padding="14,0" FontSize="12" FontWeight="SemiBold"
                                DockPanel.Dock="Left"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="✉️ Dispatch Notice with this Template" Style="{DynamicResource PrimaryButtonStyle}"
                                    Command="{Binding UseTemplateInNoticeCommand}"
                                    CommandParameter="{Binding ViewingTemplate}"
                                    Height="36" Padding="16,0" FontSize="12" FontWeight="Bold" Margin="0,0,8,0"/>
                            <Button Content="Close" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding CloseTemplateCardCommand}" Height="36" Width="80" FontSize="12"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
