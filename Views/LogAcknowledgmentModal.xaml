<UserControl x:Class="SmartSchoolIncidentManagementSystem.Views.LogAcknowledgmentModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#70000000">
        <Border Width="640" MaxHeight="620" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" CornerRadius="12" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect><DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="20" ShadowDepth="4"/></Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="6" Background="{DynamicResource SuccessBgBrush}" Margin="0,0,12,0">
                            <TextBlock Text="✍️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Log Parent Acknowledgment &amp; Slip" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="Verify signed parent slips or meeting attendance." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Content="✕" Command="{Binding CloseLogModalCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" FontSize="16" Foreground="{DynamicResource MutedTextBrush}" Cursor="Hand"/>
                </Grid>

                <!-- Form Body -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                    <StackPanel DataContext="{Binding EditingLog}">
                        <!-- Read-only Confirmation Row -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Student Name" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding StudentName, Mode=OneWay}" IsReadOnly="True" Style="{DynamicResource ModernTextBoxStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Notice ID" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding NoticeId, Mode=OneWay}" IsReadOnly="True" Style="{DynamicResource ModernTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Compliance Status & Date Received -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Compliance Status" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding DataContext.ComplianceStatuses, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" SelectedItem="{Binding DataContext.SelectedComplianceStatus, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Height="36" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Date Received / Attended" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <DatePicker SelectedDate="{Binding DataContext.DateAcknowledgedInput, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Height="36" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- File Attachment Area -->
                        <TextBlock Text="Scanned Signed Slip / Meeting Proof (PDF/JPG)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <Border Background="{DynamicResource TableHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,14,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="📁 Upload Scanned Slip" Command="{Binding DataContext.UploadSlipCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Style="{DynamicResource SecondaryButtonStyle}" Padding="12,6" Height="32"/>
                                <TextBlock Grid.Column="1" Text="{Binding DataContext.AttachedFileName, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" FontSize="12" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>

                        <!-- Remarks & Meeting Notes -->
                        <TextBlock Text="Counselor / Admin Remarks &amp; Notes" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding DataContext.RemarksInput, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="80" VerticalContentAlignment="Top" Padding="8"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer Actions -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding CloseLogModalCommand}" Margin="0,0,8,0" Width="90" Height="36"/>
                    <Button Content="Save Acknowledgment" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding SaveAcknowledgmentCommand}" Background="{DynamicResource SuccessBrush}" BorderBrush="{DynamicResource SuccessBrush}" Padding="16,0" Height="36"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>