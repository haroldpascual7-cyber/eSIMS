<UserControl x:Class="SmartSchoolIncidentManagementSystem.Views.EditTemplateModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#70000000">
        <Border Width="780" MaxHeight="680" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" CornerRadius="12" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect><DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="20" ShadowDepth="4"/></Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="6" Background="{DynamicResource SuccessBgBrush}" Margin="0,0,12,0">
                            <TextBlock Text="⚙️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Manage &amp; Edit Letter Templates" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="Customize official text body and interpolation tags." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Content="✕" Command="{Binding CloseTemplateManagerCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" FontSize="16" Foreground="{DynamicResource MutedTextBrush}" Cursor="Hand"/>
                </Grid>

                <!-- 2-Column Split: List + Editor -->
                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Template ListBox -->
                    <Border Grid.Column="0" Background="{DynamicResource TableHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                        <StackPanel>
                            <TextBlock Text="AVAILABLE TEMPLATES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="4,4,4,8"/>
                            <ListBox ItemsSource="{Binding AvailableTemplates}" SelectedItem="{Binding EditingTemplate}" DisplayMemberPath="TemplateName" Height="380" BorderThickness="0" Background="Transparent"/>
                        </StackPanel>
                    </Border>

                    <!-- Right: Editor & Cheat Sheet -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Template Name" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding TemplateNameInput, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}" Margin="0,0,0,12"/>

                            <TextBlock Text="Boilerplate Letter Text Body (Supports {{Tags}})" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding TemplateBodyInput, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="220" VerticalContentAlignment="Top" Padding="8" FontFamily="Consolas" FontSize="12" Margin="0,0,0,12"/>

                            <!-- Tag Cheat Sheet Panel -->
                            <Border Background="{DynamicResource TableHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="💡 Available Interpolation Tags:" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{}{{StudentName}}, {{StudentId}}, {{GradeSection}}, {{IncidentDate}}, {{Infraction}}, {{Location}}, {{ActionDate}}, {{OfficerName}}" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Footer Actions -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding CloseTemplateManagerCommand}" Margin="0,0,8,0" Width="90" Height="36"/>
                    <Button Content="Save Template Changes" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding SaveTemplateCommand}" Background="{DynamicResource SuccessBrush}" BorderBrush="{DynamicResource SuccessBrush}" Padding="16,0" Height="36"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>