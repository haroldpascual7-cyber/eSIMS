<UserControl x:Class="SmartSchoolIncidentManagementSystem.Views.CreateIapModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#70000000">
        <Border Width="620" MaxHeight="680" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" CornerRadius="12" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect><DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="20" ShadowDepth="4"/></Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Modal Header -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="6" Background="{DynamicResource InfoBgBrush}" Margin="0,0,12,0">
                            <TextBlock Text="📋" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Initialize Individual Action Plan" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="Set up a targeted intervention roadmap and review schedule." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Content="✕" Command="{Binding CloseCreateModalCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" FontSize="16" Foreground="{DynamicResource MutedTextBrush}" Cursor="Hand"/>
                </Grid>

                <!-- Form ScrollViewer -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- Row 1: Student Selection -->
                        <TextBlock Text="Target Student *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding RegisteredStudents}" SelectedItem="{Binding NewStudent}" DisplayMemberPath="FullName" Height="36" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                        <!-- Row 2: Focus Area & Counselor -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Target Behavioral Focus *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding FocusAreaList}" SelectedItem="{Binding NewFocusArea}" Height="36" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Assigned Counselor / Officer *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding CounselorList}" SelectedItem="{Binding NewCounselor}" Height="36" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 3: Risk Tier & Dates -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Initial Risk Tier" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding RiskTierList}" SelectedItem="{Binding NewRiskTier}" Height="36" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Start Date" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <DatePicker SelectedDate="{Binding NewStartDate}" Height="36" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Target Review Date" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <DatePicker SelectedDate="{Binding NewReviewDate}" Height="36" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 4: Problem Statement -->
                        <TextBlock Text="Problem Statement &amp; Identified Triggers" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewProblemStatement, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="60" VerticalContentAlignment="Top" Padding="8" Margin="0,0,0,12"/>

                        <!-- Row 5: Core Roadmap Objectives -->
                        <TextBlock Text="Core Roadmap Objectives &amp; Expected Outcomes" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewCoreObjectives, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="60" VerticalContentAlignment="Top" Padding="8"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer Action Buttons -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding CloseCreateModalCommand}" Margin="0,0,8,0" Width="100" Height="36"/>
                    <Button Content="Create &amp; Build Milestones" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding SaveCreatePlanCommand}" Padding="16,0" Height="36"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>