<UserControl x:Class="SmartSchoolIncidentManagementSystem.Views.AuditTrailHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <TextBlock Text="{Binding Subtitle}" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 3-Card Grid -->
            <Grid Grid.Row="1">
                <UniformGrid Columns="3">

                    <!-- CARD 1: User Activity Logging -->
                    <Border Style="{DynamicResource CardBorderStyle}" Margin="6" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Width="44" Height="44" CornerRadius="8" Background="#EFF6FF" Margin="0,0,0,14" HorizontalAlignment="Left">
                                <TextBlock Text="📜" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Grid.Row="1" Text="User Activity Logging" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="2" Text="Comprehensive audit ledger tracking user logins, incident record creations, modifications, and PDF exports." FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,16"/>

                            <Button Grid.Row="3" Content="Open Activity Logs →"
                                    Style="{DynamicResource PrimaryButtonStyle}"
                                    Command="{Binding OpenActivityLogCommand}"
                                    HorizontalAlignment="Stretch"
                                    Height="38"/>
                        </Grid>
                    </Border>

                    <!-- CARD 2: Data Integrity & Compliance Audit -->
                    <Border Style="{DynamicResource CardBorderStyle}" Margin="6" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Width="44" Height="44" CornerRadius="8" Background="#FEF2F2" Margin="0,0,0,14" HorizontalAlignment="Left">
                                <TextBlock Text="🛡️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Grid.Row="1" Text="Data Integrity &amp; Compliance Audit" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="2" Text="Verify cryptographic hash signatures, database consistency checks, and un-tampered audit trail verification." FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,16"/>

                            <Button Grid.Row="3" Content="Open Integrity Diagnostic →"
                                    Style="{DynamicResource PrimaryButtonStyle}"
                                    Command="{Binding OpenIntegrityAuditCommand}"
                                    HorizontalAlignment="Stretch"
                                    Height="38"/>
                        </Grid>
                    </Border>

                    <!-- CARD 3: Security & Access Log -->
                    <Border Style="{DynamicResource CardBorderStyle}" Margin="6" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Width="44" Height="44" CornerRadius="8" Background="#F0FDF4" Margin="0,0,0,14" HorizontalAlignment="Left">
                                <TextBlock Text="🔑" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Grid.Row="1" Text="Security &amp; Access Log" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="2" Text="Monitor failed login attempts, privilege escalation requests, role modifications, and system security events." FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,16"/>

                            <Button Grid.Row="3" Content="Open Access Control Logs →"
                                    Style="{DynamicResource PrimaryButtonStyle}"
                                    Command="{Binding OpenSecurityAccessLogCommand}"
                                    HorizontalAlignment="Stretch"
                                    Height="38"/>
                        </Grid>
                    </Border>

                </UniformGrid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>