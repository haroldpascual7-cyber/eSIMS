<UserControl x:Class="SmartSchoolIncidentManagementSystem.Views.SystemSettingsHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100"
             Background="{DynamicResource AppBackgroundBrush}">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="32,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header with Back Button -->
                <Grid Grid.Row="0" Margin="0,0,0,24">
                    <StackPanel Orientation="Vertical">
                        <Button Style="{DynamicResource SecondaryButtonStyle}"
                                Command="{Binding BackCommand}"
                                Content="← Back to Dashboard"
                                HorizontalAlignment="Left"
                                Height="32" Padding="12,0" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="⚙️" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Subtitle}" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="{DynamicResource InfoBgBrush}" BorderBrush="{DynamicResource InfoBrush}" BorderThickness="1" CornerRadius="20" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🟢 " FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="SECTION: SYSTEM &amp; PREFERENCES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource InfoBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 3-Card Grid -->
                <Grid Grid.Row="1">
                    <UniformGrid Columns="3">

                        <!-- CARD 1: School Branding & Identity -->
                        <Border Style="{DynamicResource CardBorderStyle}" Margin="6" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Width="44" Height="44" CornerRadius="8" Background="{DynamicResource InfoBgBrush}" Margin="0,0,0,14" HorizontalAlignment="Left">
                                    <TextBlock Text="🏫" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Grid.Row="1" Text="School Branding &amp; Identity" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>

                                <TextBlock Grid.Row="2" Text="Update school name, institutional motto, system title, and official DepEd school header credentials." FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,16"/>

                                <Button Grid.Row="3" Content="Open Branding Settings →"
                                        Style="{DynamicResource PrimaryButtonStyle}"
                                        Command="{Binding OpenBrandingCommand}"
                                        HorizontalAlignment="Stretch"
                                        Height="38"/>
                            </Grid>
                        </Border>

                        <!-- CARD 2: Interface & Display Settings -->
                        <Border Style="{DynamicResource CardBorderStyle}" Margin="6" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Width="44" Height="44" CornerRadius="8" Background="{DynamicResource TableHoverBrush}" Margin="0,0,0,14" HorizontalAlignment="Left">
                                    <TextBlock Text="🎨" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Grid.Row="1" Text="Interface &amp; Display Settings" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>

                                <TextBlock Grid.Row="2" Text="Customize theme modes (Light / Dark), visual contrast, accent colors, and kiosk mode layout options." FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,16"/>

                                <Button Grid.Row="3" Content="Open Display Settings →"
                                        Style="{DynamicResource PrimaryButtonStyle}"
                                        Command="{Binding OpenDisplayCommand}"
                                        HorizontalAlignment="Stretch"
                                        Height="38"/>
                            </Grid>
                        </Border>

                        <!-- CARD 3: Database Maintenance & Backup -->
                        <Border Style="{DynamicResource CardBorderStyle}" Margin="6" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Width="44" Height="44" CornerRadius="8" Background="{DynamicResource SuccessBgBrush}" Margin="0,0,0,14" HorizontalAlignment="Left">
                                    <TextBlock Text="💾" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Grid.Row="1" Text="Database Maintenance &amp; Backup" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>

                                <TextBlock Grid.Row="2" Text="Create instant SQLite database backup snapshots, inspect storage health, and safeguard audit records." FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,16"/>

                                <Button Grid.Row="3" Content="Open Backup Manager →"
                                        Style="{DynamicResource PrimaryButtonStyle}"
                                        Command="{Binding OpenBackupCommand}"
                                        HorizontalAlignment="Stretch"
                                        Height="38"/>
                            </Grid>
                        </Border>

                    </UniformGrid>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- 1. BRANDING SETTINGS MODAL -->
        <Grid Visibility="{Binding IsBrandingModalOpen, Converter={StaticResource BoolToVis}}" Background="#80000000">
            <Border Width="520" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" CornerRadius="12" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.3" BlurRadius="20" ShadowDepth="6"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="🏫 School Branding &amp; Identity Configuration" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="Modify system titles, school banner names, and official slogan text." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,16"/>

                    <!-- Success Message -->
                    <Border Background="{DynamicResource SuccessBgBrush}" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BrandingSuccessMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding BrandingSuccessMessage}" Foreground="{DynamicResource SuccessBrush}" FontSize="12" FontWeight="SemiBold"/>
                    </Border>

                    <!-- School Name -->
                    <TextBlock Text="Official School Name *" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding SchoolName, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="8,0" FontSize="13" Margin="0,0,0,12"/>

                    <!-- System Title -->
                    <TextBlock Text="System Title *" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding SystemTitle, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="8,0" FontSize="13" Margin="0,0,0,12"/>

                    <!-- Motto -->
                    <TextBlock Text="School Motto" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Motto, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="8,0" FontSize="13" Margin="0,0,0,12"/>

                    <!-- Tagline -->
                    <TextBlock Text="System Slogan / Tagline" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Tagline, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="8,0" FontSize="13" Margin="0,0,0,16"/>

                    <!-- Buttons -->
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="1" Content="Close" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding CloseBrandingModalCommand}" Width="90" Height="36" Margin="0,0,10,0"/>
                        <Button Grid.Column="2" Content="💾 Save Settings" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding SaveBrandingCommand}" Width="130" Height="36"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2. DISPLAY SETTINGS MODAL -->
        <Grid Visibility="{Binding IsDisplayModalOpen, Converter={StaticResource BoolToVis}}" Background="#80000000">
            <Border Width="480" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" CornerRadius="12" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.3" BlurRadius="20" ShadowDepth="6"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="🎨 Interface &amp; Display Preferences" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="Manage theme appearance, visual styles, and color modes." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,16"/>

                    <!-- Current Theme Status Card -->
                    <Border Background="{DynamicResource TableHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="ACTIVE COLOR THEME" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="{Binding ThemeModeText}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="🌓 Switch Theme" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding ToggleThemeCommand}" Height="34" Padding="12,0"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="DISPLAY FEATURES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8"/>
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="• High Contrast Typography for accessibility" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2"/>
                        <TextBlock Text="• Tablet Kiosk Optimized Grid (6-column responsive)" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2"/>
                        <TextBlock Text="• Offline SQLite local persistent database cache" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2"/>
                    </StackPanel>

                    <Button Content="Close" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding CloseDisplayModalCommand}" Height="36" HorizontalAlignment="Right" Padding="18,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. DATABASE BACKUP MODAL -->
        <Grid Visibility="{Binding IsBackupModalOpen, Converter={StaticResource BoolToVis}}" Background="#80000000">
            <Border Width="520" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" CornerRadius="12" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.3" BlurRadius="20" ShadowDepth="6"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="💾 Database Maintenance &amp; Backup Snapshots" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="Export instant backups and safeguard all student safety logs and case files." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,16"/>

                    <!-- Status Notification Banner -->
                    <Border Background="{DynamicResource InfoBgBrush}" BorderBrush="{DynamicResource InfoBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,14">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BackupStatusMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding BackupStatusMessage}" TextWrapping="Wrap" Foreground="{DynamicResource InfoBrush}" FontSize="12" FontWeight="SemiBold"/>
                    </Border>

                    <!-- DB Info Grid -->
                    <Border Background="{DynamicResource TableHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Storage Engine:" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="SQLite (Local Encrypted Database)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Database Health:" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="Healthy (Read/Write OK)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="Last Snapshot:" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="{Binding LastBackupDate}" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Button Content="💾 Create Instant Backup Snapshot Now" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding CreateBackupCommand}" Height="40" Margin="0,0,0,12"/>
                    <Button Content="Close" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding CloseBackupModalCommand}" Height="36" HorizontalAlignment="Right" Padding="18,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
