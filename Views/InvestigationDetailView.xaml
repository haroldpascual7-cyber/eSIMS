<UserControl x:Class="SmartSchoolIncidentManagementSystem.Views.InvestigationDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:models="clr-namespace:SmartSchoolIncidentManagementSystem.Models"
             mc:Ignorable="d" 
             d:DesignHeight="950" d:DesignWidth="1100"
             ClipToBounds="False">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid ClipToBounds="False">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="32,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 1. Header & Quick Case Info -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="4" Padding="8,4" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding IncidentNumber}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ButtonTextBrush}"/>
                            </Border>
                            <TextBlock Text="{Binding Title, StringFormat='Investigation: {0}'}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Category, StringFormat='Category: {0}'}" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="← Back to Cases" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding CloseCommand}" Margin="0,0,8,0"/>
                        <Button Content="{Binding DisciplinaryActions.Count, StringFormat='⚖️ Disciplinary &amp; Counseling ({0})'}"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Command="{Binding OpenDisciplinaryModalCommand}"
                                Visibility="{Binding CanManageInvestigation, Converter={StaticResource BoolToVis}}"
                                Margin="0,0,8,0"/>
                        <Button Content="💾 Save Investigation" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding SaveInvestigationCommand}"
                                Visibility="{Binding CanManageInvestigation, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Grid>

            <!-- Status Notification Alert -->
            <Border Grid.Row="1" Background="{DynamicResource InfoBgBrush}" BorderBrush="{DynamicResource InfoBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource InfoBrush}" FontWeight="Medium"/>
            </Border>

            <!-- 2. Interactive Lifecycle Stepper -->
            <Border Grid.Row="2" Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,20" Padding="16,14"
                    Visibility="{Binding CanManageInvestigation, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="INCIDENT LIFECYCLE PROGRESSION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,12"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Step 1: Reported -->
                        <Button Grid.Column="0" Content="1. Reported" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,6,0" Command="{Binding SetStatusCommand}">
                            <Button.CommandParameter>
                                <models:IncidentStatus>Reported</models:IncidentStatus>
                            </Button.CommandParameter>
                        </Button>

                        <!-- Step 2: Under Investigation -->
                        <Button Grid.Column="1" Content="2. Investigating" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,6,0" Command="{Binding SetStatusCommand}">
                            <Button.CommandParameter>
                                <models:IncidentStatus>UnderInvestigation</models:IncidentStatus>
                            </Button.CommandParameter>
                        </Button>

                        <!-- Step 3: Action Taken -->
                        <Button Grid.Column="2" Content="3. Action Taken" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,6,0" Command="{Binding SetStatusCommand}">
                            <Button.CommandParameter>
                                <models:IncidentStatus>ActionTaken</models:IncidentStatus>
                            </Button.CommandParameter>
                        </Button>

                        <!-- Step 4: Resolved -->
                        <Button Grid.Column="3" Content="4. Resolved" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,6,0" Command="{Binding SetStatusCommand}">
                            <Button.CommandParameter>
                                <models:IncidentStatus>Resolved</models:IncidentStatus>
                            </Button.CommandParameter>
                        </Button>

                        <!-- Step 5: Closed -->
                        <Button Grid.Column="4" Content="5. Closed" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding SetStatusCommand}">
                            <Button.CommandParameter>
                                <models:IncidentStatus>Closed</models:IncidentStatus>
                            </Button.CommandParameter>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- 3. Investigation Dossier & Disciplinary Management -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Investigation Notes & Findings -->
                <Border Grid.Column="0">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                            <Setter Property="Margin" Value="0,0,16,0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTeacher}" Value="True">
                                    <Setter Property="Margin" Value="0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Investigation Dossier &amp; Witness Statements" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,16"/>

                        <!-- Investigator & Findings Row -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Lead Investigator" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                                <Grid>
                                    <TextBox Style="{DynamicResource ModernTextBoxStyle}"
                                             Text="{Binding LeadInvestigatorName, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding IsTeacher}"
                                             x:Name="InvestigatorTextBox"/>
                                    <!-- Placeholder text -->
                                    <TextBlock Text="Enter lead investigator name"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="14"
                                               IsHitTestVisible="False"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding LeadInvestigatorName}" Value=""/>
                                                            <Condition Binding="{Binding IsTeacher}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Formal Finding / Conclusion" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                                <ComboBox Style="{DynamicResource ModernComboBoxStyle}" ItemsSource="{Binding FindingsOptions}" SelectedItem="{Binding Findings}"
                                          IsEnabled="{Binding CanManageInvestigation}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Interview Logs -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Interview Logs &amp; Statements" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                            <TextBox Style="{DynamicResource ModernTextBoxStyle}" Text="{Binding InterviewLogs, UpdateSourceTrigger=PropertyChanged}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     IsReadOnly="{Binding IsTeacher}"/>
                        </StackPanel>

                        <!-- Witness Testimonies -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Witness Testimonies &amp; Corroboration" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                            <TextBox Style="{DynamicResource ModernTextBoxStyle}" Text="{Binding WitnessStatements, UpdateSourceTrigger=PropertyChanged}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     IsReadOnly="{Binding IsTeacher}"/>
                        </StackPanel>

                        <!-- Chronological Notes -->
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Investigator Chronological Notes &amp; Evidence Summary" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                            <TextBox Style="{DynamicResource ModernTextBoxStyle}" Text="{Binding InvestigationNotes, UpdateSourceTrigger=PropertyChanged}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     IsReadOnly="{Binding IsTeacher}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Right Column: Disciplinary Action & Counseling Overview Card -->
                <Border Grid.Column="1" Width="410" Style="{DynamicResource CardBorderStyle}"
                        Visibility="{Binding CanManageInvestigation, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Disciplinary Actions &amp; Counseling" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Manage corrective sanctions, counseling referrals, and student interventions." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <!-- Metrics Summary Box -->
                        <Border Background="{DynamicResource TableHoverBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Total Assigned" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock Text="{Binding DisciplinaryActions.Count}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Completed" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock Text="{Binding CompletedActionsCount, StringFormat='{}{0} Done'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Prominent Button: View Disciplinary Action & Counseling -->
                        <Button Content="⚖️ View Disciplinary Actions &amp; Counseling" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding OpenDisciplinaryModalCommand}" Height="36" Margin="0,0,0,14" HorizontalAlignment="Stretch"/>

                        <!-- Assigned Consequences List Header -->
                        <TextBlock Text="Assigned Consequences &amp; Interventions:" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"/>

                        <!-- Empty State -->
                        <Border Background="{DynamicResource TableHoverBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasDisciplinaryActions}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="No disciplinary actions recorded yet." FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                                <Button Content="+ Add New Action" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding OpenDisciplinaryModalCommand}" Margin="0,6,0,0" Padding="8,3" FontSize="11"/>
                            </StackPanel>
                        </Border>

                        <!-- Preview List with Edit, Complete, and Delete -->
                        <ScrollViewer MaxHeight="350" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding DisciplinaryActions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource TableRowAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding ActionType}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    <TextBlock Text="{Binding ActionDetails}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding Status, StringFormat='Status: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <!-- Action Buttons: Edit, Complete, Delete -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="✏️" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding DataContext.StartEditActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="Edit in full form" Padding="6,4" FontSize="11" Margin="4,0,2,0"/>
                                                    <Button Content="✓" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding DataContext.CompleteActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="Mark as completed" Padding="6,4" FontSize="11" Margin="2,0,2,0"/>
                                                    <Button Content="✕" Style="{DynamicResource DangerButtonStyle}" Command="{Binding DataContext.DeleteActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="Delete action" Padding="6,4" FontSize="11" Margin="2,0,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>

    <!-- Full Modal Dialog Overlay for Disciplinary Actions & Counseling -->
    <Grid Margin="-260,-60,-20,-20" Visibility="{Binding IsDisciplinaryModalOpen, Converter={StaticResource BoolToVis}}" Background="{DynamicResource ModalOverlayBrush}" Panel.ZIndex="1000">
        <Border Width="930" MaxHeight="700" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" CornerRadius="12" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.45" BlurRadius="28" ShadowDepth="8"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Modal Header -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚖️" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Disciplinary Actions &amp; Counseling Management" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding IncidentNumber, StringFormat='Case Incident #{0} • View all details, edit or delete disciplinary actions, and record interventions.'}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="26,2,0,0"/>
                    </StackPanel>
                    <Button Content="✕ Close" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding CloseDisciplinaryModalCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="12,6"/>
                </Grid>

                <!-- Alert Message Banner -->
                <Border Grid.Row="1" Background="{DynamicResource InfoBgBrush}" BorderBrush="{DynamicResource InfoBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ModalMessage}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ModalMessage}" Foreground="{DynamicResource InfoBrush}" FontWeight="Medium" FontSize="12"/>
                </Border>

                <!-- Modal Split Body: Left List + Right Full Form -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: All Assigned Actions List -->
                    <Border Grid.Column="0" Background="{DynamicResource TableHoverBrush}" CornerRadius="8" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="{Binding DisciplinaryActions.Count, StringFormat='ASSIGNED CONSEQUENCES ({0})'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                <Button Content="+ New Action" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding StartAddActionCommand}" HorizontalAlignment="Right" Padding="8,3" FontSize="11"/>
                            </Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasDisciplinaryActions}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="No consequences recorded yet. Complete the form on the right to add one." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding DisciplinaryActions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <Grid Margin="0,0,0,4">
                                                            <TextBlock Text="{Binding ActionType}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                            <Border HorizontalAlignment="Right" CornerRadius="4" Padding="6,2" Background="{DynamicResource TableHoverBrush}">
                                                                <TextBlock Text="{Binding Status}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock Text="{Binding ActionDetails}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding ScheduledDate, StringFormat='Date: {0:yyyy-MM-dd}'}" FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding FollowUpNotes, StringFormat='Notes: {0}'}" FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                                        </Grid>
                                                        <!-- Action Row: Edit, Complete, Delete -->
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <Button Content="✏️ Edit Form" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding DataContext.StartEditActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,6,0" Padding="8,4" FontSize="11"/>
                                                            <Button Content="✓ Complete" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding DataContext.CompleteActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,6,0" Padding="8,4" FontSize="11"/>
                                                            <Button Content="🗑️ Delete" Style="{DynamicResource DangerButtonStyle}" Command="{Binding DataContext.DeleteActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="8,4" FontSize="11"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- RIGHT: The Full Form ("like i see all the form") -->
                    <Border Grid.Column="2" Background="{DynamicResource TableHoverBrush}" CornerRadius="8" Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{Binding FormHeaderTitle}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,2"/>
                                <TextBlock Text="View all form fields to add or modify disciplinary and counseling details." FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10"/>

                                <!-- Action Type -->
                                <TextBlock Text="Action Type *" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,3"/>
                                <ComboBox Style="{DynamicResource ModernComboBoxStyle}" ItemsSource="{Binding ActionTypes}" SelectedItem="{Binding ActionFormType}" Height="34" Margin="0,0,0,8"/>

                                <!-- Scheduled Date & Status Grid -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="Scheduled Date *" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,3"/>
                                        <DatePicker SelectedDate="{Binding ActionFormDate}" Height="34"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="Status *" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,3"/>
                                        <ComboBox Style="{DynamicResource ModernComboBoxStyle}" ItemsSource="{Binding ActionStatusOptions}" SelectedItem="{Binding ActionFormStatus}" Height="34"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Requirements / Action Details -->
                                <TextBlock Text="Requirements / Action Details *" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,3"/>
                                <TextBox Style="{DynamicResource ModernTextBoxStyle}" Text="{Binding ActionFormDetails, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"/>

                                <!-- Follow-Up Notes -->
                                <TextBlock Text="Follow-Up Notes &amp; Observations" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,3"/>
                                <TextBox Style="{DynamicResource ModernTextBoxStyle}" Text="{Binding ActionFormNotes, UpdateSourceTrigger=PropertyChanged}" Height="45" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>

                                <!-- Form Buttons -->
                                <Grid>
                                    <Button Content="✕ Cancel Edit" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding CancelEditCommand}" Visibility="{Binding IsEditingAction, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Left" Height="34" Padding="12,0"/>
                                    <Button Content="{Binding FormSubmitButtonText}" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding SaveActionCommand}" HorizontalAlignment="Right" Height="34" Padding="14,0"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Grid>
</UserControl>