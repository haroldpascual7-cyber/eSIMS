<!-- Views/StudentListView.xaml -->
<UserControl x:Class="SmartSchoolIncidentManagementSystem.Views.StudentListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SmartSchoolIncidentManagementSystem.ViewModels"
             xmlns:local="clr-namespace:SmartSchoolIncidentManagementSystem.Views"
             xmlns:conv="clr-namespace:SmartSchoolIncidentManagementSystem.Converters"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StudentListViewModel, IsDesignTimeCreatable=True}">
    <UserControl.Resources>
        <!-- Styles can be defined here or referenced from CoreStyles.xaml -->
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Search bar -->
            <RowDefinition Height="*" />    <!-- Data grid -->
            <RowDefinition Height="Auto" /> <!-- Status / Loading -->
        </Grid.RowDefinitions>

        <!-- Search Panel -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <TextBox Width="250"
                     Margin="0,0,5,0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Background="{DynamicResource InputBackgroundBrush}"
                     Foreground="{DynamicResource PrimaryTextBrush}" />
            <Button Content="Search"
                    Command="{Binding SearchCommand}"
                    IsEnabled="{Binding IsNotLoading}"
                    Padding="8,4"
                    Background="{DynamicResource PrimaryBrush}"
                    Foreground="{DynamicResource ButtonTextBrush}" />
            <Button Content="Refresh"
                    Command="{Binding RefreshCommand}"
                    IsEnabled="{Binding IsNotLoading}"
                    Padding="8,4"
                    Margin="5,0,0,0"
                    Background="{DynamicResource PrimaryBrush}"
                    Foreground="{DynamicResource ButtonTextBrush}" />
            <Button Content="View Profile"
                    Command="{Binding OpenDetailCommand}"
                    Padding="8,4"
                    Margin="5,0,0,0"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="{DynamicResource ButtonTextBrush}" />
        </StackPanel>

        <!-- Student Data Grid -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Students}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  RowBackground="{DynamicResource SurfaceBackgroundBrush}"
                  AlternatingRowBackground="{DynamicResource TableRowAltBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  FontFamily="{DynamicResource PrimaryFontFamily}" >
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto" />
                <DataGridTextColumn Header="Student #" Binding="{Binding StudentNumber}" Width="*" />
                <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="2*" />
                <DataGridTextColumn Header="Grade" Binding="{Binding GradeLevel}" Width="Auto" />
                <DataGridTextColumn Header="Section" Binding="{Binding Section}" Width="Auto" />
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*" />
                <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Loading / Status Bar -->
        <TextBlock Grid.Row="2"
                   Text="Loading..."
                   Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                   HorizontalAlignment="Center"
                   Margin="0,5,0,0"
                   Foreground="{DynamicResource MutedTextBrush}" />
    </Grid>
</UserControl>