<UserControl x:Class="SmartSchoolIncidentManagementSystem.Views.ConductAnalyticsView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
              Background="{DynamicResource AppBackgroundBrush}">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,20,28,20">
                <!-- Header Strip -->
                <Grid Margin="0,0,0,20">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="&#x2190; Back to Profiles Hub" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding BackToProfilesHubCommand}" Margin="0,0,14,0" Padding="12,6"/>
                            <TextBlock Text="Conduct Analytics &amp; Early Intervention Dashboard" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="School-wide behavioral trajectory trends, category risk breakdowns, and high-priority early-intervention student watchlists." FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Top KPI Ribbon (4 Cards) -->
                <UniformGrid Columns="4" Margin="0,0,0,20">
                    <!-- Card 1: Avg Score -->
                    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="18,16" Margin="0,0,12,0">
                        <Border.Effect><DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="10" ShadowDepth="2"/></Border.Effect>
                        <StackPanel>
                            <TextBlock Text="SCHOOL AVG CONDUCT SCORE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding AverageConductScoreText}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                            <TextBlock Text="Target Benchmark: 85.0/100" FontSize="11" Foreground="#059669" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Highest Risk Section -->
                    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="18,16" Margin="0,0,12,0">
                        <Border.Effect><DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="10" ShadowDepth="2"/></Border.Effect>
                        <StackPanel>
                            <TextBlock Text="HIGHEST RISK ZONE / CLASS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding HighestRiskSection}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Requires Enhanced Supervision" FontSize="11" Foreground="{DynamicResource DangerBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Active Interventions -->
                    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="18,16" Margin="0,0,12,0">
                        <Border.Effect><DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="10" ShadowDepth="2"/></Border.Effect>
                        <StackPanel>
                            <TextBlock Text="ACTIVE INTERVENTIONS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding ActiveInterventionsCount}" FontSize="24" FontWeight="Bold" Foreground="#D97706"/>
                            <TextBlock Text="Counseling &amp; Suspension Bans" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 4: 30-Day Escalation Rate -->
                    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="18,16">
                        <Border.Effect><DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="10" ShadowDepth="2"/></Border.Effect>
                        <StackPanel>
                            <TextBlock Text="30-DAY ESCALATION RATE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding EscalationRateText}" FontSize="24" FontWeight="Bold" Foreground="{Binding EscalationRateColor}"/>
                            <TextBlock Text="Compared to Prior 30-Day Window" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Main Charts Area (60/40 Split) -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="4*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Trajectory Line Chart (60%) -->
                    <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="20,16">
                        <Border.Effect><DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="10" ShadowDepth="2"/></Border.Effect>
                        <StackPanel>
                            <TextBlock Text="School-Wide Conduct Score Trajectory (6-Month Trend)" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,12"/>
                            <lvc:CartesianChart Series="{Binding TrajectorySeries}" XAxes="{Binding TrajectoryXAxes}" Height="240"/>
                        </StackPanel>
                    </Border>

                    <!-- Right: Category Bar Chart (40%) -->
                    <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="20,16">
                        <Border.Effect><DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="10" ShadowDepth="2"/></Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Incident Frequencies by Category" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,12"/>
                            <lvc:CartesianChart Series="{Binding CategorySeries}" XAxes="{Binding CategoryXAxes}" Height="240"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Bottom Panel: Early-Intervention Watchlist DataGrid -->
                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="20,16">
                    <Border.Effect><DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="10" ShadowDepth="2"/></Border.Effect>
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚠️ Early-Intervention Student Watchlist" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource TableHoverBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="12" Padding="8,2" Margin="12,0,0,0">
                                    <TextBlock Text="High Priority" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Students exhibiting sharp score drops (>= 15 pts) or at-risk standing" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <DataGrid ItemsSource="{Binding WatchlistStudents}"
                                  SelectedItem="{Binding SelectedWatchlistStudent}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                                  Background="{DynamicResource CardBackgroundBrush}" RowBackground="{DynamicResource CardBackgroundBrush}" AlternatingRowBackground="{DynamicResource TableRowAltBrush}"
                                  HeadersVisibility="Column" BorderThickness="0" RowHeight="42">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource TableHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Student ID" Binding="{Binding StudentId}" Width="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Padding" Value="8,0"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Student Name" Binding="{Binding StudentName}" Width="1.5*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Padding" Value="8,0"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Grade &amp; Section" Binding="{Binding GradeSection}" Width="1.4*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Padding" Value="8,0"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Current Score" Binding="{Binding CurrentScore}" Width="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="FontWeight" Value="Bold"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="30-Day Drop" Binding="{Binding ThirtyDayDropText}" Width="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Status Standing" Binding="{Binding StandingLabel}" Width="130">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Header="Action" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Review Profile"
                                                    Command="{Binding DataContext.ReviewStudentProfileCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                    CommandParameter="{Binding StudentId}"
                                                    Background="{DynamicResource TableHoverBrush}" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" Foreground="{DynamicResource PrimaryBrush}"
                                                    FontSize="11" FontWeight="SemiBold" Height="28" Padding="8,0" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Background="{TemplateBinding Background}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>