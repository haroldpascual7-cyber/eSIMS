<UserControl x:Class="SmartSchoolIncidentManagementSystem.Views.TabletDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1280">

    <UserControl.Background>
        <ImageBrush ImageSource="pack://application:,,,/Assets/blue_wave_bg.png" Stretch="UniformToFill"/>
    </UserControl.Background>

    <UserControl.Resources>
        <!-- Cohesive Kiosk Tile Style -->
        <Style x:Key="KioskTileStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource KioskTileBaseBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource KioskTextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource KioskTileBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="tileBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tileBorder" Property="BorderBrush" Value="{DynamicResource KioskTileHoverBorderBrush}"/>
                                <Setter TargetName="tileBorder" Property="Background" Value="{DynamicResource KioskTileHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="tileBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="tileBorder" Property="Background" Value="{DynamicResource KioskTileDisabledBrush}"/>
                                <Setter TargetName="tileBorder" Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Unified Header Action Button Style -->
        <Style x:Key="KioskHeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource KioskButtonBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource KioskTextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource KioskTileBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource KioskButtonHoverBrush}"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="{DynamicResource KioskTileHoverBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KioskTileTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource KioskTextPrimaryBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="KioskTileSubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource KioskTextMutedBrush}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="KioskTileGlyphStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Opacity" Value="0.9"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="14,10,14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. TOP HEADER BAR -->
        <Border Grid.Row="0" Margin="4,0,4,6" Padding="14,8" CornerRadius="6" BorderThickness="1"
                Background="{DynamicResource KioskBarBrush}" BorderBrush="{DynamicResource KioskBarBorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="pack://application:,,,/Assets/esims_plus_sids_logo.png"
                       Height="46" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="SCHOOL INCIDENT MANAGEMENT SYSTEM" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource KioskTextPrimaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="Manage. Monitor. Protect." FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource KioskAccentBrush}" Margin="0,0,12,0"/>
                        <TextBlock Text="REPORT  ·  MONITOR  ·  RESOLVE  ·  ANALYZE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource KioskTextMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right: Properly aligned controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🌓" Style="{StaticResource KioskHeaderButtonStyle}" Command="{Binding ToggleThemeCommand}" Width="32" Margin="0,0,6,0" ToolTip="Toggle Light / Dark Mode"/>
                    <Button Content="{Binding RefreshButtonIcon, FallbackValue='↻'}" Style="{StaticResource KioskHeaderButtonStyle}" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsNotRefreshing}" Width="32" Margin="0,0,6,0" ToolTip="Refresh Data"/>
                    <Border Visibility="{Binding IsNotificationBadgeVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,6,0">
                        <Button Command="{Binding ViewNotificationsCommand}" Style="{StaticResource KioskHeaderButtonStyle}"
                                Background="{DynamicResource KioskTileDangerBrush}" Padding="10,0" ToolTip="System Notifications">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔔" FontSize="13" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding NewIncidentCount}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>
                    <Button Content="✕" Click="OnCloseWindowClick" Style="{StaticResource KioskHeaderButtonStyle}" Width="32" ToolTip="Close Application"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. UNIFIED TILE BOARD -->
        <Grid Grid.Row="1">

            <!-- A. STAFF & TEACHER GRID (3x6) -->
            <Grid Visibility="{Binding IsStaffOrTeacher, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Row 0 -->
                <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource KioskTileStyle}" Background="{DynamicResource KioskTilePrimaryBrush}" Command="{Binding NavigateDashboardCommand}">
                    <Grid>
                        <TextBlock Text="📊" Style="{StaticResource KioskTileGlyphStyle}"/>
                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock Text="Dashboard" Style="{StaticResource KioskTileTitleStyle}"/>
                            <TextBlock Text="Alerts, KPIs, &amp; actions." Style="{StaticResource KioskTileSubtitleStyle}" Foreground="{DynamicResource KioskTextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Button>
                <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource KioskTileStyle}" Background="{DynamicResource KioskTileTealBrush}" Command="{Binding NavigateReportNewIncidentCommand}">
                    <Grid>
                        <TextBlock Text="📝" Style="{StaticResource KioskTileGlyphStyle}"/>
                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock Text="Report Incident" Style="{StaticResource KioskTileTitleStyle}"/>
                            <TextBlock Text="Quick intake shortcut." Style="{StaticResource KioskTileSubtitleStyle}" Foreground="{DynamicResource KioskTextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Button>
                <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource KioskTileStyle}" Background="{DynamicResource KioskTileTealBrush}" Command="{Binding NavigateIncidentListCommand}">
                    <Grid>
                        <TextBlock Text="📋" Style="{StaticResource KioskTileGlyphStyle}"/>
                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock Text="Incident List" Style="{StaticResource KioskTileTitleStyle}"/>
                            <TextBlock Text="Browse &amp; filter records." Style="{StaticResource KioskTileSubtitleStyle}" Foreground="{DynamicResource KioskTextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Button>
                <Border Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="3" Margin="4" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource KioskTileBorderBrush}" ClipToBounds="True">
                    <Image Source="pack://application:,,,/Assets/sids_blue_banner.png" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Row 1: Live Clock + My Filed Reports / Investigations -->
                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="4" Padding="20,12" CornerRadius="6" BorderThickness="1"
                        Background="{DynamicResource KioskTileBaseBrush}" BorderBrush="{DynamicResource KioskTileBorderBrush}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding TimeGreeting}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource KioskTextMutedBrush}"/>
                        <TextBlock Text="{Binding CurrentDate}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource KioskTextPrimaryBrush}" Margin="0,3,0,2"/>
                        <TextBlock Text="{Binding CurrentTime}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource KioskAccentBrush}"/>
                    </StackPanel>
                </Border>
                <Grid Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="3" Visibility="{Binding CanAccessInvestigations, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource KioskTileStyle}" Background="{DynamicResource KioskTilePrimaryBrush}" Command="{Binding NavigateMyFiledReportsCommand}">
                        <Grid>
                            <TextBlock Text="📂" Style="{StaticResource KioskTileGlyphStyle}"/>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="My Filed Reports" Style="{StaticResource KioskTileTitleStyle}"/>
                                <TextBlock Text="Personal incident filings &amp; status records." Style="{StaticResource KioskTileSubtitleStyle}" Foreground="{DynamicResource KioskTextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource KioskTileStyle}" Command="{Binding NavigateInvestigationsCommand}">
                        <Grid>
                            <TextBlock Text="🔍" Style="{StaticResource KioskTileGlyphStyle}"/>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Investigations" Style="{StaticResource KioskTileTitleStyle}"/>
                                <TextBlock Text="Evidence &amp; case logs." Style="{StaticResource KioskTileSubtitleStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </Grid>
                <Button Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="3" Visibility="{Binding CanAccessInvestigations, Converter={StaticResource InverseBoolToVis}}"
                        Style="{StaticResource KioskTileStyle}" Background="{DynamicResource KioskTilePrimaryBrush}" Command="{Binding NavigateMyFiledReportsCommand}">
                    <Grid>
                        <TextBlock Text="📂" Style="{StaticResource KioskTileGlyphStyle}"/>
                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock Text="My Filed Reports" Style="{StaticResource KioskTileTitleStyle}"/>
                            <TextBlock Text="Personal incident filings &amp; status records." Style="{StaticResource KioskTileSubtitleStyle}" Foreground="{DynamicResource KioskTextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- Row 2 -->
                <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="6" Visibility="{Binding CanAccessReportsAnalytics, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource KioskTileStyle}" Background="{DynamicResource KioskTilePrimaryBrush}" Command="{Binding NavigateStudentProfileCommand}">
                        <Grid>
                            <TextBlock Text="👨‍🎓" Style="{StaticResource KioskTileGlyphStyle}"/>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Student Profile" Style="{StaticResource KioskTileTitleStyle}"/>
                                <TextBlock Text="Behavioral histories &amp; records." Style="{StaticResource KioskTileSubtitleStyle}" Foreground="{DynamicResource KioskTextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource KioskTileStyle}" Command="{Binding NavigateReportsAnalyticsCommand}">
                        <Grid>
                            <TextBlock Text="📈" Style="{StaticResource KioskTileGlyphStyle}"/>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Reports &amp; Data" Style="{StaticResource KioskTileTitleStyle}"/>
                                <TextBlock Text="Heatmaps, safety trends &amp; exports." Style="{StaticResource KioskTileSubtitleStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource KioskTileStyle}" Background="{DynamicResource KioskTileDangerBrush}" Command="{Binding LogoutCommand}">
                        <Grid>
                            <TextBlock Text="🚪" Style="{StaticResource KioskTileGlyphStyle}"/>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Exit / Log Out" Style="{StaticResource KioskTileTitleStyle}"/>
                                <TextBlock Text="Close application or switch user." Style="{StaticResource KioskTileSubtitleStyle}" Foreground="{DynamicResource KioskTextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </Grid>
                <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="6" Visibility="{Binding CanAccessReportsAnalytics, Converter={StaticResource InverseBoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource KioskTileStyle}" Background="{DynamicResource KioskTilePrimaryBrush}" Command="{Binding NavigateStudentProfileCommand}">
                        <Grid>
                            <TextBlock Text="👨‍🎓" Style="{StaticResource KioskTileGlyphStyle}"/>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Student Profile" Style="{StaticResource KioskTileTitleStyle}"/>
                                <TextBlock Text="Behavioral histories &amp; student records." Style="{StaticResource KioskTileSubtitleStyle}" Foreground="{DynamicResource KioskTextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource KioskTileStyle}" Background="{DynamicResource KioskTileDangerBrush}" Command="{Binding LogoutCommand}">
                        <Grid>
                            <TextBlock Text="🚪" Style="{StaticResource KioskTileGlyphStyle}"/>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Exit / Log Out" Style="{StaticResource KioskTileTitleStyle}"/>
                                <TextBlock Text="Close application or switch user." Style="{StaticResource KioskTileSubtitleStyle}" Foreground="{DynamicResource KioskTextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </Grid>
            </Grid>

            <!-- B. LEADERSHIP & ADMIN MASTER GRID (4x6) -->
            <Grid Visibility="{Binding IsStaffOrTeacher, Converter={StaticResource InverseBoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Row 0 -->
                <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource KioskTileStyle}" Background="{DynamicResource KioskTilePrimaryBrush}" Command="{Binding NavigateDashboardCommand}"><Grid><TextBlock Text="📊" Style="{StaticResource KioskTileGlyphStyle}"/><StackPanel VerticalAlignment="Bottom"><TextBlock Text="Dashboard" Style="{StaticResource KioskTileTitleStyle}"/><TextBlock Text="Alerts, KPIs, &amp; actions." Style="{StaticResource KioskTileSubtitleStyle}" Foreground="{DynamicResource KioskTextSecondaryBrush}"/></StackPanel></Grid></Button>
                <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource KioskTileStyle}" Background="{DynamicResource KioskTileTealBrush}" Command="{Binding NavigateReportNewIncidentCommand}"><Grid><TextBlock Text="📝" Style="{StaticResource KioskTileGlyphStyle}"/><StackPanel VerticalAlignment="Bottom"><TextBlock Text="Report Incident" Style="{StaticResource KioskTileTitleStyle}"/><TextBlock Text="Quick intake shortcut." Style="{StaticResource KioskTileSubtitleStyle}" Foreground="{DynamicResource KioskTextSecondaryBrush}"/></StackPanel></Grid></Button>
                <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource KioskTileStyle}" Background="{DynamicResource KioskTileTealBrush}" Command="{Binding NavigateIncidentListCommand}"><Grid><TextBlock Text="📋" Style="{StaticResource KioskTileGlyphStyle}"/><StackPanel VerticalAlignment="Bottom"><TextBlock Text="Incident List" Style="{StaticResource KioskTileTitleStyle}"/><TextBlock Text="Browse &amp; filter records." Style="{StaticResource KioskTileSubtitleStyle}" Foreground="{DynamicResource KioskTextSecondaryBrush}"/></StackPanel></Grid></Button>
                <Border Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="3" Margin="4" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource KioskTileBorderBrush}" ClipToBounds="True">
                    <Image Source="pack://application:,,,/Assets/sids_blue_banner.png" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Row 1 -->
                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="4" Padding="20,12" CornerRadius="6" BorderThickness="1"
                        Background="{DynamicResource KioskTileBaseBrush}" BorderBrush="{DynamicResource KioskTileBorderBrush}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding TimeGreeting}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource KioskTextMutedBrush}"/>
                        <TextBlock Text="{Binding CurrentDate}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource KioskTextPrimaryBrush}" Margin="0,3,0,2"/>
                        <TextBlock Text="{Binding CurrentTime}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource KioskAccentBrush}"/>
                    </StackPanel>
                </Border>
                <Button Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Style="{StaticResource KioskTileStyle}" Background="{DynamicResource KioskTilePrimaryBrush}" Command="{Binding NavigateMyFiledReportsCommand}"><Grid><TextBlock Text="📂" Style="{StaticResource KioskTileGlyphStyle}"/><StackPanel VerticalAlignment="Bottom"><TextBlock Text="My Filed Reports" Style="{StaticResource KioskTileTitleStyle}"/><TextBlock Text="Personal filings." Style="{StaticResource KioskTileSubtitleStyle}" Foreground="{DynamicResource KioskTextSecondaryBrush}"/></StackPanel></Grid></Button>
                <Button Grid.Row="1" Grid.Column="5" Style="{StaticResource KioskTileStyle}" Command="{Binding NavigateInvestigationsCommand}"><Grid><TextBlock Text="🔍" Style="{StaticResource KioskTileGlyphStyle}"/><StackPanel VerticalAlignment="Bottom"><TextBlock Text="Investigations" Style="{StaticResource KioskTileTitleStyle}"/><TextBlock Text="Evidence &amp; case logs." Style="{StaticResource KioskTileSubtitleStyle}"/></StackPanel></Grid></Button>

                <!-- Row 2 -->
                <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource KioskTileStyle}" Command="{Binding NavigateDisciplinaryActionsCommand}"><Grid><TextBlock Text="⚖️" Style="{StaticResource KioskTileGlyphStyle}"/><StackPanel VerticalAlignment="Bottom"><TextBlock Text="Disciplinary" Style="{StaticResource KioskTileTitleStyle}"/><TextBlock Text="Sanctions &amp; plans." Style="{StaticResource KioskTileSubtitleStyle}"/></StackPanel></Grid></Button>
                <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource KioskTileStyle}" Command="{Binding NavigateRiskRulesCommand}"><Grid><TextBlock Text="⚡" Style="{StaticResource KioskTileGlyphStyle}"/><StackPanel VerticalAlignment="Bottom"><TextBlock Text="Risk &amp; Rules" Style="{StaticResource KioskTileTitleStyle}"/><TextBlock Text="Matrix &amp; evaluation." Style="{StaticResource KioskTileSubtitleStyle}"/></StackPanel></Grid></Button>
                <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource KioskTileStyle}" Background="{DynamicResource KioskTilePrimaryBrush}" Command="{Binding NavigateStudentProfileCommand}"><Grid><TextBlock Text="👨‍🎓" Style="{StaticResource KioskTileGlyphStyle}"/><StackPanel VerticalAlignment="Bottom"><TextBlock Text="Student Profile" Style="{StaticResource KioskTileTitleStyle}"/><TextBlock Text="Behavioral histories." Style="{StaticResource KioskTileSubtitleStyle}" Foreground="{DynamicResource KioskTextSecondaryBrush}"/></StackPanel></Grid></Button>
                <Button Grid.Row="2" Grid.Column="3" Style="{StaticResource KioskTileStyle}" Command="{Binding NavigateParentNoticesCommand}"><Grid><TextBlock Text="✉️" Style="{StaticResource KioskTileGlyphStyle}"/><StackPanel VerticalAlignment="Bottom"><TextBlock Text="Parent Notices" Style="{StaticResource KioskTileTitleStyle}"/><TextBlock Text="Letters &amp; tracking." Style="{StaticResource KioskTileSubtitleStyle}"/></StackPanel></Grid></Button>
                <Button Grid.Row="2" Grid.Column="4" Style="{StaticResource KioskTileStyle}" Command="{Binding NavigateReportsAnalyticsCommand}"><Grid><TextBlock Text="📈" Style="{StaticResource KioskTileGlyphStyle}"/><StackPanel VerticalAlignment="Bottom"><TextBlock Text="Reports &amp; Data" Style="{StaticResource KioskTileTitleStyle}"/><TextBlock Text="Heatmaps &amp; trends." Style="{StaticResource KioskTileSubtitleStyle}"/></StackPanel></Grid></Button>
                <Button Grid.Row="2" Grid.Column="5" Style="{StaticResource KioskTileStyle}" Command="{Binding NavigateAuditTrailCommand}"><Grid><TextBlock Text="🔒" Style="{StaticResource KioskTileGlyphStyle}"/><StackPanel VerticalAlignment="Bottom"><TextBlock Text="Audit Trail" Style="{StaticResource KioskTileTitleStyle}"/><TextBlock Text="Tamper-evident logs." Style="{StaticResource KioskTileSubtitleStyle}"/></StackPanel></Grid></Button>

                <!-- Row 3: Admin (with User Management) -->
                <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="6" Visibility="{Binding CanAccessUserManagement, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource KioskTileStyle}" Background="{DynamicResource KioskTilePrimaryBrush}" Command="{Binding NavigateUserManagementCommand}"><Grid><TextBlock Text="👥" Style="{StaticResource KioskTileGlyphStyle}"/><StackPanel VerticalAlignment="Bottom"><TextBlock Text="User Management" Style="{StaticResource KioskTileTitleStyle}"/><TextBlock Text="Accounts, roles &amp; privileges." Style="{StaticResource KioskTileSubtitleStyle}" Foreground="{DynamicResource KioskTextSecondaryBrush}"/></StackPanel></Grid></Button>
                    <Button Grid.Column="1" Style="{StaticResource KioskTileStyle}" Command="{Binding NavigateSystemSettingsCommand}"><Grid><TextBlock Text="⚙️" Style="{StaticResource KioskTileGlyphStyle}"/><StackPanel VerticalAlignment="Bottom"><TextBlock Text="System Settings" Style="{StaticResource KioskTileTitleStyle}"/><TextBlock Text="School branding &amp; database." Style="{StaticResource KioskTileSubtitleStyle}"/></StackPanel></Grid></Button>
                    <Button Grid.Column="2" Style="{StaticResource KioskTileStyle}" Background="{DynamicResource KioskTileDangerBrush}" Command="{Binding LogoutCommand}"><Grid><TextBlock Text="🚪" Style="{StaticResource KioskTileGlyphStyle}"/><StackPanel VerticalAlignment="Bottom"><TextBlock Text="Exit / Log Out" Style="{StaticResource KioskTileTitleStyle}"/><TextBlock Text="Close application or switch user." Style="{StaticResource KioskTileSubtitleStyle}" Foreground="{DynamicResource KioskTextSecondaryBrush}"/></StackPanel></Grid></Button>
                </Grid>

                <!-- Row 3: Discipline & Guidance (no User Management) -->
                <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="6" Visibility="{Binding CanAccessUserManagement, Converter={StaticResource InverseBoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource KioskTileStyle}" Command="{Binding NavigateSystemSettingsCommand}"><Grid><TextBlock Text="⚙️" Style="{StaticResource KioskTileGlyphStyle}"/><StackPanel VerticalAlignment="Bottom"><TextBlock Text="System Settings" Style="{StaticResource KioskTileTitleStyle}"/><TextBlock Text="School branding, display preferences &amp; database maintenance." Style="{StaticResource KioskTileSubtitleStyle}"/></StackPanel></Grid></Button>
                    <Button Grid.Column="1" Style="{StaticResource KioskTileStyle}" Background="{DynamicResource KioskTileDangerBrush}" Command="{Binding LogoutCommand}"><Grid><TextBlock Text="🚪" Style="{StaticResource KioskTileGlyphStyle}"/><StackPanel VerticalAlignment="Bottom"><TextBlock Text="Exit / Log Out" Style="{StaticResource KioskTileTitleStyle}"/><TextBlock Text="Close application or switch user." Style="{StaticResource KioskTileSubtitleStyle}" Foreground="{DynamicResource KioskTextSecondaryBrush}"/></StackPanel></Grid></Button>
                </Grid>
            </Grid>
