<UserControl x:Class="SmartSchoolIncidentManagementSystem.Views.TabletDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1280">

    <UserControl.Background>
        <ImageBrush ImageSource="pack://application:,,,/Assets/blue_wave_bg.png" Stretch="UniformToFill"/>
    </UserControl.Background>

    <UserControl.Resources>
        <!-- Metro Tile Button Style (Flat, Sharp Box Edges CornerRadius="0", No Border, Bright Blue Hover Glow) -->
        <Style x:Key="MetroTileButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="tileBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tileBorder" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="tileBorder" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="tileBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#3B82F6" Opacity="0.50" BlurRadius="16" ShadowDepth="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="tileBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="tileBorder" Property="Background" Value="#0F172A"/>
                                <Setter TargetName="tileBorder" Property="Opacity" Value="0.42"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Top Right Header Control Button Style -->
        <Style x:Key="HeaderSquareButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- FIT-SCREEN RESPONSIVE GRID -->
    <Grid Margin="16,8,16,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. TOP HEADER BAR: MATTI NATIONAL HIGH SCHOOL & SMART INCIDENT BANNER -->
        <Border Grid.Row="0" CornerRadius="0" Margin="0,0,0,8" Padding="12,6" BorderThickness="0,0,0,1" BorderBrush="#1E3A8A">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#D9060E1A" Offset="0.0"/>
                    <GradientStop Color="#B30F172A" Offset="0.5"/>
                    <GradientStop Color="#801E293B" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: 3D eSIMS+ SIDS Logo -->
                <Image Grid.Column="0" Source="pack://application:,,,/Assets/esims_plus_sids_logo.png"
                       Height="54" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.3" BlurRadius="8" ShadowDepth="2"/>
                    </Image.Effect>
                </Image>

                <!-- Center-Left: System Title, Slogan, and 4 Pillars -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="SCHOOL INCIDENT MANAGEMENT SYSTEM" FontSize="14" FontWeight="ExtraBold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Manage. Monitor. Protect." FontSize="10.5" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,2,0,3"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📋 REPORT" FontSize="8" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="🔍 MONITOR" FontSize="8" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="🛡️ RESOLVE" FontSize="8" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="📊 ANALYZE" FontSize="8" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Central Glowing Security Shield Seal -->
                <Border Grid.Column="2" Width="46" Height="46" CornerRadius="23" Background="#1A1E3A8A" BorderBrush="#0284C7" BorderThickness="1.5" VerticalAlignment="Center" Margin="4,0,12,0">
                    <Border.Effect><DropShadowEffect Color="#38BDF8" Opacity="0.50" BlurRadius="12" ShadowDepth="0"/></Border.Effect>
                    <TextBlock Text="🔒" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Right: Action Buttons, Profile Pill & Notification Badge -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🌓" Style="{StaticResource HeaderSquareButtonStyle}" Command="{Binding ToggleThemeCommand}" Width="32" Height="32" Margin="0,0,6,0" ToolTip="Toggle Light / Dark Mode"/>
                    <Button Content="↻" Style="{StaticResource HeaderSquareButtonStyle}" Command="{Binding RefreshCommand}" Width="32" Height="32" Margin="0,0,8,0" ToolTip="Refresh Data"/>
                    <Border Background="#7F1D1D" BorderBrush="#991B1B" BorderThickness="1" CornerRadius="4" Padding="12,4" Margin="0,0,8,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding DashboardTitle}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding UserFullName, StringFormat='{}{0} | Online'}" FontSize="10" Foreground="#FECACA" Margin="0,1,0,0" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                    <Border Visibility="{Binding IsNotificationBadgeVisible, Converter={StaticResource BoolToVis}}">
                        <Button Command="{Binding ViewNotificationsCommand}" Style="{StaticResource MetroTileButtonStyle}" Background="{DynamicResource DangerBrush}" Width="40" Height="36" Padding="0" ToolTip="System Notifications">
                            <Grid>
                                <TextBlock Text="🔔" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource DangerBrush}" CornerRadius="5" Padding="3,1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,1,0">
                                    <TextBlock Text="{Binding NewIncidentCount}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ButtonTextBrush}"/>
                                </Border>
                            </Grid>
                        </Button>
                    </Border>
                    <!-- Window Management Controls (Close Only) -->
                    <Button Content="✕" Click="OnCloseWindowClick" Style="{StaticResource HeaderSquareButtonStyle}" Width="32" Height="32" Margin="8,0,0,0" ToolTip="Close Application"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. TABLET DASHBOARD CONTENT (ROLE-ALIGNED: TOP-RIGHT SIDS BANNER, LEFT-SIDE CLOCK, ZERO GHOST CARDS) -->
        <Grid Grid.Row="1" Margin="0,0,0,6">

            <!-- ==================== A. STAFF & TEACHER GRID (3 BALANCED ROWS, TOP-RIGHT SIDS BANNER, LEFT-SIDE CLOCK) ==================== -->
            <Grid Visibility="{Binding IsStaffOrTeacher, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ROW 0: Dashboard (Col 0), Report Incident (Col 1), Incident List (Col 2), SIDS Banner (Cols 3-5 TOP RIGHT) -->
                <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource MetroTileButtonStyle}" Background="#0078D7" Margin="0,0,6,6" Padding="12,10" Command="{Binding NavigateDashboardCommand}">
                    <Grid>
                        <TextBlock Text="📊" FontSize="24" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.9"/>
                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock Text="Dashboard" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="Alerts, KPIs, &amp; actions." FontSize="10" Foreground="#E0E7FF" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource MetroTileButtonStyle}" Background="#107C41" Margin="0,0,6,6" Padding="12,10" Command="{Binding NavigateReportNewIncidentCommand}">
                    <Grid>
                        <TextBlock Text="📝" FontSize="24" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.9"/>
                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock Text="Report Incident" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="Quick intake shortcut." FontSize="10" Foreground="#D1FAE5" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource MetroTileButtonStyle}" Background="#0D9488" Margin="0,0,6,6" Padding="12,10" Command="{Binding NavigateIncidentListCommand}">
                    <Grid>
                        <TextBlock Text="📋" FontSize="24" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.9"/>
                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock Text="Incident List" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="Browse &amp; filter records." FontSize="10" Foreground="#CCFBF1" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- Top Right: SIDS Software Solution Banner (Cols 3-5) -->
                <Border Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="3" Background="Transparent" BorderThickness="0" CornerRadius="0" Margin="0,0,0,6" Padding="0" ClipToBounds="True">
                    <Image Source="pack://application:,,,/Assets/sids_blue_banner.png" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- ROW 1: Live Clock (Cols 0-2 LEFT SIDE TIME) -->
                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Background="#0F172A" BorderThickness="0" CornerRadius="0" Margin="0,0,6,6" Padding="20,12">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding TimeGreeting}" FontSize="15" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding CurrentDate}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding CurrentTime}" FontSize="19" FontWeight="SemiBold" Foreground="#38BDF8"/>
                    </StackPanel>
                </Border>

                <!-- ROW 1 RIGHT: When Investigations IS permitted in RBAC (My Filed Reports 2 cols + Investigations 1 col) -->
                <Grid Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="3" Visibility="{Binding CanAccessInvestigations, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource MetroTileButtonStyle}" Background="#0063B1" Margin="0,0,6,6" Padding="14,10" Command="{Binding NavigateMyFiledReportsCommand}">
                        <Grid>
                            <TextBlock Text="📂" FontSize="24" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.9"/>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="My Filed Reports" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Personal incident filings &amp; status records." FontSize="10" Foreground="#DBEAFE" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource MetroTileButtonStyle}" Background="#1E293B" Margin="0,0,0,6" Padding="12,10" Command="{Binding NavigateInvestigationsCommand}">
                        <Grid>
                            <TextBlock Text="🔍" FontSize="24" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.9"/>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Investigations" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Evidence &amp; case logs." FontSize="10" Foreground="#CBD5E1" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </Grid>

                <!-- ROW 1 RIGHT: When Investigations is NOT permitted in RBAC (My Filed Reports spans all 3 columns) -->
                <Button Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="3" Visibility="{Binding CanAccessInvestigations, Converter={StaticResource InverseBoolToVis}}"
                        Style="{StaticResource MetroTileButtonStyle}" Background="#0063B1" Margin="0,0,0,6" Padding="14,10" Command="{Binding NavigateMyFiledReportsCommand}">
                    <Grid>
                        <TextBlock Text="📂" FontSize="24" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.9"/>
                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock Text="My Filed Reports" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="Personal incident filings &amp; status records." FontSize="10" Foreground="#DBEAFE" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- ROW 2: Student Profile, Reports & Data (if enabled), and Exit / Log Out -->
                <!-- Layout 1: When Reports & Data IS permitted in RBAC (3 clean cards, 2 cols each) -->
                <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="6" Visibility="{Binding CanAccessReportsAnalytics, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource MetroTileButtonStyle}" Background="#0284C7" Margin="0,0,6,0" Padding="14,10" Command="{Binding NavigateStudentProfileCommand}">
                        <Grid>
                            <TextBlock Text="👨‍🎓" FontSize="26" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.9"/>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Student Profile" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Behavioral histories &amp; records." FontSize="10" Foreground="#E0F2FE" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource MetroTileButtonStyle}" Background="#7C3AED" Margin="0,0,6,0" Padding="14,10" Command="{Binding NavigateReportsAnalyticsCommand}">
                        <Grid>
                            <TextBlock Text="📈" FontSize="26" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.9"/>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Reports &amp; Data" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Heatmaps, safety trends &amp; exports." FontSize="10" Foreground="#EDE9FE" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource MetroTileButtonStyle}" Background="#B91C1C" Margin="0,0,0,0" Padding="14,10" Command="{Binding LogoutCommand}">
                        <Grid>
                            <TextBlock Text="🚪" FontSize="26" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.9"/>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Exit / Log Out" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Close application or switch user." FontSize="10" Foreground="#FEE2E2" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </Grid>

                <!-- Layout 2: When Reports & Data is NOT permitted in RBAC (2 wide cards, 3 cols each) -->
                <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="6" Visibility="{Binding CanAccessReportsAnalytics, Converter={StaticResource InverseBoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource MetroTileButtonStyle}" Background="#0284C7" Margin="0,0,6,0" Padding="14,10" Command="{Binding NavigateStudentProfileCommand}">
                        <Grid>
                            <TextBlock Text="👨‍🎓" FontSize="26" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.9"/>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Student Profile" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Behavioral histories &amp; student records." FontSize="10" Foreground="#E0F2FE" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource MetroTileButtonStyle}" Background="#B91C1C" Margin="0,0,0,0" Padding="14,10" Command="{Binding LogoutCommand}">
                        <Grid>
                            <TextBlock Text="🚪" FontSize="26" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.9"/>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Exit / Log Out" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Close application or switch user." FontSize="10" Foreground="#FEE2E2" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </Grid>
            </Grid>

            <!-- ==================== B. LEADERSHIP & ADMIN MASTER GRID (4 ROWS x 6 COLUMNS) ==================== -->
            <Grid Visibility="{Binding IsStaffOrTeacher, Converter={StaticResource InverseBoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ROW 0: Dashboard (Col 0), Report Incident (Col 1), Incident List (Col 2), SIDS Banner (Cols 3-5) -->
                <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource MetroTileButtonStyle}" Background="#0078D7" Margin="0,0,6,6" Padding="10,8" Command="{Binding NavigateDashboardCommand}"><Grid><TextBlock Text="📊" FontSize="22" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.9"/><StackPanel VerticalAlignment="Bottom"><TextBlock Text="Dashboard" FontSize="13" FontWeight="Bold"/><TextBlock Text="Alerts, KPIs, &amp; actions." FontSize="9" Foreground="#E0E7FF" Margin="0,1,0,0"/></StackPanel></Grid></Button>
                <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource MetroTileButtonStyle}" Background="#107C41" Margin="0,0,6,6" Padding="10,8" Command="{Binding NavigateReportNewIncidentCommand}"><Grid><TextBlock Text="📝" FontSize="22" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.9"/><StackPanel VerticalAlignment="Bottom"><TextBlock Text="Report Incident" FontSize="13" FontWeight="Bold"/><TextBlock Text="Quick intake shortcut." FontSize="9" Foreground="#D1FAE5" Margin="0,1,0,0"/></StackPanel></Grid></Button>
                <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource MetroTileButtonStyle}" Background="#0D9488" Margin="0,0,6,6" Padding="10,8" Command="{Binding NavigateIncidentListCommand}"><Grid><TextBlock Text="📋" FontSize="22" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.9"/><StackPanel VerticalAlignment="Bottom"><TextBlock Text="Incident List" FontSize="13" FontWeight="Bold"/><TextBlock Text="Browse &amp; filter records." FontSize="9" Foreground="#CCFBF1" Margin="0,1,0,0"/></StackPanel></Grid></Button>
                <Border Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="3" Background="Transparent" BorderThickness="0" CornerRadius="0" Margin="0,0,0,6" Padding="0" ClipToBounds="True">
                    <Image Source="pack://application:,,,/Assets/sids_blue_banner.png" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- ROW 1: Live Clock (Cols 0-2), My Filed Reports (Cols 3-4), Investigations (Col 5) -->
                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Background="#0F172A" BorderThickness="0" CornerRadius="0" Margin="0,0,6,6" Padding="20,10">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding TimeGreeting}" FontSize="14" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding CurrentDate}" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding CurrentTime}" FontSize="18" FontWeight="SemiBold" Foreground="#38BDF8"/>
                    </StackPanel>
                </Border>
                <Button Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Style="{StaticResource MetroTileButtonStyle}" Background="#0063B1" Margin="0,0,6,6" Padding="12,8" Command="{Binding NavigateMyFiledReportsCommand}"><Grid><TextBlock Text="📂" FontSize="22" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.9"/><StackPanel VerticalAlignment="Bottom"><TextBlock Text="My Filed Reports" FontSize="13" FontWeight="Bold"/><TextBlock Text="Personal filings." FontSize="9" Foreground="#DBEAFE" Margin="0,1,0,0"/></StackPanel></Grid></Button>
                <Button Grid.Row="1" Grid.Column="5" Style="{StaticResource MetroTileButtonStyle}" Background="#1E293B" Margin="0,0,0,6" Padding="10,8" Command="{Binding NavigateInvestigationsCommand}"><Grid><TextBlock Text="🔍" FontSize="22" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.9"/><StackPanel VerticalAlignment="Bottom"><TextBlock Text="Investigations" FontSize="13" FontWeight="Bold"/><TextBlock Text="Evidence &amp; case logs." FontSize="9" Foreground="#CBD5E1" Margin="0,1,0,0"/></StackPanel></Grid></Button>

                <!-- ROW 2: Disciplinary (Col 0), Risk & Rules (Col 1), Student Profile (Col 2), Parent Notices (Col 3), Reports & Data (Col 4), Audit Trail (Col 5) -->
                <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource MetroTileButtonStyle}" Background="#334155" Margin="0,0,6,6" Padding="10,8" Command="{Binding NavigateDisciplinaryActionsCommand}"><Grid><TextBlock Text="⚖️" FontSize="22" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.9"/><StackPanel VerticalAlignment="Bottom"><TextBlock Text="Disciplinary" FontSize="13" FontWeight="Bold"/><TextBlock Text="Sanctions &amp; plans." FontSize="9" Foreground="#E2E8F0" Margin="0,1,0,0"/></StackPanel></Grid></Button>
                <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource MetroTileButtonStyle}" Background="#D97706" Margin="0,0,6,6" Padding="10,8" Command="{Binding NavigateRiskRulesCommand}"><Grid><TextBlock Text="⚡" FontSize="22" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.9"/><StackPanel VerticalAlignment="Bottom"><TextBlock Text="Risk &amp; Rules" FontSize="13" FontWeight="Bold"/><TextBlock Text="Matrix &amp; evaluation." FontSize="9" Foreground="#FEF3C7" Margin="0,1,0,0"/></StackPanel></Grid></Button>
                <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource MetroTileButtonStyle}" Background="#0284C7" Margin="0,0,6,6" Padding="10,8" Command="{Binding NavigateStudentProfileCommand}"><Grid><TextBlock Text="👨‍🎓" FontSize="22" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.9"/><StackPanel VerticalAlignment="Bottom"><TextBlock Text="Student Profile" FontSize="13" FontWeight="Bold"/><TextBlock Text="Behavioral histories." FontSize="9" Foreground="#E0F2FE" Margin="0,1,0,0"/></StackPanel></Grid></Button>
                <Button Grid.Row="2" Grid.Column="3" Style="{StaticResource MetroTileButtonStyle}" Background="#0891B2" Margin="0,0,6,6" Padding="10,8" Command="{Binding NavigateParentNoticesCommand}"><Grid><TextBlock Text="✉️" FontSize="22" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.9"/><StackPanel VerticalAlignment="Bottom"><TextBlock Text="Parent Notices" FontSize="13" FontWeight="Bold"/><TextBlock Text="Letters &amp; tracking." FontSize="9" Foreground="#CFFAFE" Margin="0,1,0,0"/></StackPanel></Grid></Button>
                <Button Grid.Row="2" Grid.Column="4" Style="{StaticResource MetroTileButtonStyle}" Background="#7C3AED" Margin="0,0,6,6" Padding="10,8" Command="{Binding NavigateReportsAnalyticsCommand}"><Grid><TextBlock Text="📈" FontSize="22" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.9"/><StackPanel VerticalAlignment="Bottom"><TextBlock Text="Reports &amp; Data" FontSize="13" FontWeight="Bold"/><TextBlock Text="Heatmaps &amp; trends." FontSize="9" Foreground="#EDE9FE" Margin="0,1,0,0"/></StackPanel></Grid></Button>
                <Button Grid.Row="2" Grid.Column="5" Style="{StaticResource MetroTileButtonStyle}" Background="#0F766E" Margin="0,0,0,6" Padding="10,8" Command="{Binding NavigateAuditTrailCommand}"><Grid><TextBlock Text="🔒" FontSize="22" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.9"/><StackPanel VerticalAlignment="Bottom"><TextBlock Text="Audit Trail" FontSize="13" FontWeight="Bold"/><TextBlock Text="Tamper-evident logs." FontSize="9" Foreground="#CCFBF1" Margin="0,1,0,0"/></StackPanel></Grid></Button>

                <!-- ROW 3: Layout 1 (Admin: User Management 2 cols + System Settings 2 cols + Exit/Logout 2 cols) -->
                <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="6" Visibility="{Binding CanAccessUserManagement, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource MetroTileButtonStyle}" Background="#4338CA" Margin="0,0,6,0" Padding="12,8" Command="{Binding NavigateUserManagementCommand}">
                        <Grid>
                            <TextBlock Text="👥" FontSize="22" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.9"/>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="User Management" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Accounts, roles &amp; privileges." FontSize="9" Foreground="#E0E7FF" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource MetroTileButtonStyle}" Background="#334155" Margin="0,0,6,0" Padding="12,8" Command="{Binding NavigateSystemSettingsCommand}">
                        <Grid>
                            <TextBlock Text="⚙️" FontSize="22" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.9"/>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="System Settings" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="School branding &amp; database." FontSize="9" Foreground="#F1F5F9" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource MetroTileButtonStyle}" Background="#B91C1C" Margin="0,0,0,0" Padding="12,8" Command="{Binding LogoutCommand}">
                        <Grid>
                            <TextBlock Text="🚪" FontSize="22" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.9"/>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Exit / Log Out" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Close application or switch user." FontSize="9" Foreground="#FEE2E2" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </Grid>

                <!-- ROW 3: Layout 2 (Discipline & Guidance: System Settings 3 cols + Exit/Logout 3 cols, NO User Management) -->
                <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="6" Visibility="{Binding CanAccessUserManagement, Converter={StaticResource InverseBoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource MetroTileButtonStyle}" Background="#334155" Margin="0,0,6,0" Padding="14,10" Command="{Binding NavigateSystemSettingsCommand}">
                        <Grid>
                            <TextBlock Text="⚙️" FontSize="24" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.9"/>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="System Settings" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="School branding, display preferences &amp; database maintenance." FontSize="10" Foreground="#F1F5F9" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource MetroTileButtonStyle}" Background="#B91C1C" Margin="0,0,0,0" Padding="14,10" Command="{Binding LogoutCommand}">
                        <Grid>
                            <TextBlock Text="🚪" FontSize="24" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.9"/>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Exit / Log Out" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Close application or switch user." FontSize="10" Foreground="#FEE2E2" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </Grid>
            </Grid>
        </Grid>

        <!-- 3. FOOTER STATUS BAR (Dark Mode Kiosk Status Bar) -->
        <Border Grid.Row="2" CornerRadius="0" Margin="0,4,0,0" Padding="14,6" BorderThickness="0,1,0,0" BorderBrush="#1E3A8A">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#D9060E1A" Offset="0.0"/>
                    <GradientStop Color="#B30F172A" Offset="0.5"/>
                    <GradientStop Color="#801E293B" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="● Offline (SQLite)" FontSize="11" FontWeight="Bold" Foreground="#10B981" Margin="0,0,14,0"/>
                    <TextBlock Text="•  Smart School Incident Management System  •  Ctrl + Shift + P: Commands  •  Ctrl + K: Search  •  Ctrl + L: Lock" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding CurrentDate}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
