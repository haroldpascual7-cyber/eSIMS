<UserControl x:Class="SmartSchoolIncidentManagementSystem.Views.DisciplinaryActionsHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100"
             Background="{DynamicResource AppBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="⚖️" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Disciplinary Actions &amp; Case Interventions" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Manage authorized sanctions, suspension orders, probation monitoring, restorative plans, and parent notices." FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                </StackPanel>

                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource InfoBgBrush}" BorderBrush="{DynamicResource InfoBrush}" BorderThickness="1" CornerRadius="20" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🟢 " FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="SECTION: DISCIPLINE &amp; CASE MANAGEMENT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource InfoBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 2. KPI / Quick Stats Summary Bar -->
            <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,22">
                <!-- Stat 1: Active Sanctions -->
                <Border Style="{DynamicResource CardBorderStyle}" Margin="4" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="ACTIVE SANCTIONS &amp; WARNINGS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Text="{Binding ActiveSanctionsCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Stat 2: Restorative Plans -->
                <Border Style="{DynamicResource CardBorderStyle}" Margin="4" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="RESTORATIVE SERVICE PLANS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                        <TextBlock Text="{Binding RestorativePlansCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Stat 3: Active Suspensions -->
                <Border Style="{DynamicResource CardBorderStyle}" Margin="4" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="ACTIVE SUSPENSION ORDERS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/>
                        <TextBlock Text="{Binding ActiveSuspensionsCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Stat 4: Parent Summons -->
                <Border Style="{DynamicResource CardBorderStyle}" Margin="4" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="PARENT SUMMON &amp; NOTICES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                        <TextBlock Text="{Binding ParentNoticesCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource CardBorderStyle}" Margin="4" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="ACTIVE PROBATION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource InfoBrush}"/>
                        <TextBlock Text="{Binding ActiveProbationsCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource InfoBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- 3. 4-Card Operational Grid Hub -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="OPERATIONAL DISCIPLINE MODULES" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="4,0,0,12"/>

                <UniformGrid Grid.Row="1" Columns="3">

                    <!-- CARD 1: Consequence & Sanction Tracking -->
                    <Border Style="{DynamicResource CardBorderStyle}" Margin="4" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Width="44" Height="44" CornerRadius="8" Background="{DynamicResource InfoBgBrush}" Margin="0,0,0,14" HorizontalAlignment="Left">
                                <TextBlock Text="📋" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Grid.Row="1" Text="Consequence &amp; Sanctions" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="2" Text="Record verbal warnings, written reprimands, repeat offender sanctions, and official disciplinary penalty logs." FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,16"/>

                            <Button Grid.Row="3" Content="Open Sanctions Tracker →"
                                    Style="{DynamicResource PrimaryButtonStyle}"
                                    Command="{Binding OpenConsequenceTrackingCommand}"
                                    HorizontalAlignment="Stretch"
                                    Height="38"/>
                        </Grid>
                    </Border>

                    <!-- CARD 2: Restorative Interventions & Service Hours -->
                    <Border Style="{DynamicResource CardBorderStyle}" Margin="4" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Width="44" Height="44" CornerRadius="8" Background="{DynamicResource SuccessBgBrush}" Margin="0,0,0,14" HorizontalAlignment="Left">
                                <TextBlock Text="🤝" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Grid.Row="1" Text="Restorative &amp; Service Hours" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="2" Text="Track community service schedules, school beautification hours, behavioral agreements, and counselor referrals." FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,16"/>

                            <Button Grid.Row="3" Content="Open Restorative Plans →"
                                    Style="{DynamicResource PrimaryButtonStyle}"
                                    Command="{Binding OpenRestorativeInterventionsCommand}"
                                    HorizontalAlignment="Stretch"
                                    Height="38"/>
                        </Grid>
                    </Border>

                    <!-- CARD 3: Parent Summon & Notice to Explain -->
                    <Border Style="{DynamicResource CardBorderStyle}" Margin="4" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Width="44" Height="44" CornerRadius="8" Background="{DynamicResource WarningBgBrush}" Margin="0,0,0,14" HorizontalAlignment="Left">
                                <TextBlock Text="📜" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Grid.Row="1" Text="Parent Summon &amp; Notices" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="2" Text="Generate formal parental summons, scheduled hearing appointments, and official notice to explain letters." FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,16"/>

                            <Button Grid.Row="3" Content="Open Letter Generator →"
                                    Style="{DynamicResource PrimaryButtonStyle}"
                                    Command="{Binding OpenParentSummonsCommand}"
                                    HorizontalAlignment="Stretch"
                                    Height="38"/>
                        </Grid>
                    </Border>

                    <!-- CARD 4: Suspension Calendar & Orders -->
                    <Border Style="{DynamicResource CardBorderStyle}" Margin="4" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Width="44" Height="44" CornerRadius="8" Background="{DynamicResource DangerBgBrush}" Margin="0,0,0,14" HorizontalAlignment="Left">
                                <TextBlock Text="📅" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Grid.Row="1" Text="Suspension Calendar &amp; Orders" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="2" Text="Monitor active in-school and out-of-school suspension orders, compliance durations, and re-admission clearances." FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,16"/>

                            <Button Grid.Row="3" Content="Open Suspension Calendar →"
                                    Style="{DynamicResource PrimaryButtonStyle}"
                                    Command="{Binding OpenSuspensionCalendarCommand}"
                                    HorizontalAlignment="Stretch"
                                    Height="38"/>
                        </Grid>
                    </Border>

                    <!-- CARD 5: Probation & Behavior Monitoring -->
                    <Border Style="{DynamicResource CardBorderStyle}" Margin="4" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Width="44" Height="44" CornerRadius="8" Background="{DynamicResource InfoBgBrush}" Margin="0,0,0,14" HorizontalAlignment="Left">
                                <TextBlock Text="P" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource InfoBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Row="1" Text="Probation &amp; Monitoring" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="2" Text="Assign responsible staff, document behavior conditions, record progress, and formally extend or complete monitoring." FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,16"/>
                            <Button Grid.Row="3" Content="Open Probation Tracking"
                                    Style="{DynamicResource PrimaryButtonStyle}"
                                    Command="{Binding OpenProbationTrackingCommand}"
                                    HorizontalAlignment="Stretch" Height="38"/>
                        </Grid>
                    </Border>

                </UniformGrid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
