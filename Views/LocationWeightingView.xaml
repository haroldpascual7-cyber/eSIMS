<UserControl x:Class="SmartSchoolIncidentManagementSystem.Views.LocationWeightingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1150">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="32,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 1. Header & Navigation Back Button -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="← Back to Rules Hub" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding BackToRulesHubCommand}" Margin="0,0,14,0" Padding="12,6"/>
                            <TextBlock Text="Campus Location Weighting &amp; Supervision Rules" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Set elevated supervision factors and risk multipliers for unmonitored campus areas." FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="+ Add Campus Location" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding OpenAddModalCommand}"/>
                    </StackPanel>
                </Grid>

                <!-- Status Notification Banner -->
                <Border Grid.Row="1" Background="{DynamicResource InfoBgBrush}" BorderBrush="{DynamicResource InfoBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,16">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource InfoBrush}" FontWeight="Medium"/>
                </Border>

                <!-- 2. Top KPI Summary Cards -->
                <Grid Grid.Row="2" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{DynamicResource CardBorderStyle}" Margin="0,0,12,0" Padding="16,14">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="TOTAL CAMPUS ZONES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding TotalCampusZonesCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{DynamicResource CardBorderStyle}" Margin="0,0,12,0" Padding="16,14">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="BLIND SPOT ZONES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding BlindSpotZonesCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{DynamicResource CardBorderStyle}" Margin="0,0,12,0" Padding="16,14">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="HIGH-RISK MULTIPLIERS (>1.5x)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding HighRiskMultipliersCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Style="{DynamicResource CardBorderStyle}" Padding="16,14">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="ACTIVE CCTV MONITORED" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding ActiveCctvAreasCount}" FontSize="24" FontWeight="Bold" Foreground="#10B981" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 3. Control Toolbar -->
                <Border Grid.Row="3" Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,16" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.8*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Search Campus Zone / Building" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                            <TextBox Style="{DynamicResource ModernTextBoxStyle}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="Area Category" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                            <ComboBox Style="{DynamicResource ModernComboBoxStyle}" ItemsSource="{Binding CategoryFilterOptions}" SelectedItem="{Binding SelectedCategoryFilter}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Supervision Level" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                            <ComboBox Style="{DynamicResource ModernComboBoxStyle}" ItemsSource="{Binding SupervisionFilterOptions}" SelectedItem="{Binding SelectedSupervisionFilter}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 4. Location Weight Rules DataGrid -->
                <Border Grid.Row="4" Style="{DynamicResource CardBorderStyle}" Padding="0">
                    <DataGrid ItemsSource="{Binding LocationRules}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionMode="Single" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                              Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="{DynamicResource TableRowAltBrush}"
                              Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="0" HeadersVisibility="Column"
                              CanUserResizeRows="False" RowDetailsVisibilityMode="Collapsed" RowHeight="50">

                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="8,10"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <Style TargetType="TextBlock" x:Key="CellTextStyle">
                                <Setter Property="Padding" Value="6,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="12"/>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E0F2FE"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#BAE6FD"/>
                                        <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                        <Setter Property="BorderBrush" Value="#0EA5E9"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Code" Binding="{Binding LocationCode}" MinWidth="85" Width="85" ElementStyle="{StaticResource CellTextStyle}"/>
                            <DataGridTextColumn Header="Zone / Room &amp; Building" Binding="{Binding LocationNameAndBuilding}" MinWidth="180" Width="1.4*" ElementStyle="{StaticResource CellTextStyle}"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" MinWidth="120" Width="1.1*" ElementStyle="{StaticResource CellTextStyle}"/>

                            <!-- Supervision Tier Badge -->
                            <DataGridTemplateColumn Header="Supervision Tier" MinWidth="140" Width="1.3*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SupervisionLevel}" Value="High Constant Supervision">
                                                            <Setter Property="Background" Value="#D1FAE5"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SupervisionLevel}" Value="Unmonitored Blind Spot">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding SupervisionLevel}" FontSize="11" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#92400E"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SupervisionLevel}" Value="High Constant Supervision">
                                                                <Setter Property="Foreground" Value="#065F46"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SupervisionLevel}" Value="Unmonitored Blind Spot">
                                                                <Setter Property="Foreground" Value="#991B1B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- CCTV Coverage -->
                            <DataGridTemplateColumn Header="CCTV" MinWidth="80" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#D1FAE5"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasCCTV}" Value="False">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Yes 📹"/>
                                                        <Setter Property="Foreground" Value="#065F46"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasCCTV}" Value="False">
                                                                <Setter Property="Text" Value="No ✕"/>
                                                                <Setter Property="Foreground" Value="#991B1B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Risk Multiplier -->
                            <DataGridTextColumn Header="Risk Multiplier" Binding="{Binding MultiplierText}" MinWidth="110" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="6,0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#2563EB"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Restricted Badge -->
                            <DataGridTemplateColumn Header="Restricted" MinWidth="95" Width="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#F3F4F6"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRestricted}" Value="True">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Public"/>
                                                        <Setter Property="Foreground" Value="#6B7280"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRestricted}" Value="True">
                                                                <Setter Property="Text" Value="Restricted 🚫"/>
                                                                <Setter Property="Foreground" Value="#991B1B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Actions -->
                            <DataGridTemplateColumn Header="Actions" MinWidth="130" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Edit" Style="{DynamicResource SecondaryButtonStyle}" Padding="6,3" FontSize="11" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.OpenEditModalCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Delete" Style="{DynamicResource SecondaryButtonStyle}" Padding="6,3" FontSize="11" Foreground="{DynamicResource DangerBrush}"
                                                    Command="{Binding DataContext.DeleteRuleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- 5. MODAL POP-UP DIALOG ("+ Add / Edit Location Rule") -->
        <Grid Background="#80000000">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsModalOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Style="{DynamicResource CardBorderStyle}" Width="500" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" CornerRadius="12">
                <StackPanel Orientation="Vertical">
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="Configure Campus Location Risk Rule" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <Button Content="✕" Width="28" Height="28" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding CloseModalCommand}"/>
                    </Grid>

                    <Border Background="{DynamicResource DangerBgBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ModalErrorMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ModalErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="12" FontWeight="Medium"/>
                    </Border>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Location / Zone Name *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                            <TextBox Style="{DynamicResource ModernTextBoxStyle}" Text="{Binding ModalLocationName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Building / Wing" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                            <TextBox Style="{DynamicResource ModernTextBoxStyle}" Text="{Binding ModalBuilding, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Area Category *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                            <ComboBox Style="{DynamicResource ModernComboBoxStyle}" ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding ModalCategory}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Supervision Level *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                            <ComboBox Style="{DynamicResource ModernComboBoxStyle}" ItemsSource="{Binding SupervisionLevelOptions}" SelectedItem="{Binding ModalSupervisionLevel}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Risk Multiplier (1.0x - 2.5x) *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                            <TextBox Style="{DynamicResource ModernTextBoxStyle}" Text="{Binding ModalRiskMultiplier, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,4">
                            <CheckBox Content="Active CCTV Coverage Present" IsChecked="{Binding ModalHasCCTV}" FontSize="12"/>
                        </StackPanel>
                    </Grid>

                    <CheckBox Content="Restricted Area / Off-Limits to Students" IsChecked="{Binding ModalIsRestricted}" Margin="0,4" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}"/>
                    <CheckBox Content="Location Rule Active Status" IsChecked="{Binding ModalIsActive}" Margin="0,4,0,16" FontSize="12"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding CloseModalCommand}" Margin="0,0,10,0" Padding="14,6"/>
                        <Button Content="Save Location Rule" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding SaveRuleCommand}" Padding="14,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
