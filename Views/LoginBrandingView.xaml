<UserControl x:Class="SmartSchoolIncidentManagementSystem.Views.LoginBrandingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <!-- DYNAMIC INSTITUTIONAL BRANDING (CONFIGURED VIA BRANDING & MAINTENANCE) -->
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" MaxWidth="460">
            
            <!-- 1. Large Official School Seal / Login Logo (Top) -->
            <Border Width="165" Height="165" 
                    HorizontalAlignment="Center" 
                    Margin="0,0,0,22"
                    CornerRadius="82.5">
                <Image Source="{Binding LoginLogoSource}"
                       Width="155" Height="155"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                    <Image.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.30" BlurRadius="12" ShadowDepth="3"/>
                    </Image.Effect>
                </Image>
            </Border>

            <!-- 2. Institution Name & Details (Dynamic from Settings) -->
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="{Binding SchoolName}"
                           FontSize="24"
                           FontWeight="ExtraBold"
                           Foreground="{DynamicResource LoginBrandingTextBrush}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.55" BlurRadius="6" ShadowDepth="1.5" Direction="270"/>
                    </TextBlock.Effect>
                </TextBlock>
                
                <TextBlock Text="{Binding SchoolAddress}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource LoginBrandingSubtextBrush}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,6,0,0">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.45" BlurRadius="4" ShadowDepth="1" Direction="270"/>
                    </TextBlock.Effect>
                </TextBlock>

                <!-- Subtle Decorative Divider with Glowing Accent -->
                <Grid Width="220" HorizontalAlignment="Center" Margin="0,18,0,18">
                    <Border Height="1" Background="{DynamicResource LoginBrandingDividerBrush}" Opacity="0.8"/>
                    <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                </Grid>

                <!-- System Title & Acronym -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                    <TextBlock Text="{Binding SystemAcronym}" FontSize="19" FontWeight="ExtraBold" Foreground="{DynamicResource AccentBrush}">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.45" BlurRadius="4" ShadowDepth="1" Direction="270"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="{Binding SystemTitle, StringFormat=' • {0}'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource LoginBrandingTextBrush}" VerticalAlignment="Center" Margin="6,0,0,0">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.45" BlurRadius="4" ShadowDepth="1" Direction="270"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>

                <!-- Motto / Tagline -->
                <TextBlock Text="{Binding Tagline}"
                           FontSize="12"
                           FontWeight="Medium"
                           Foreground="{DynamicResource LoginBrandingMutedBrush}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.45" BlurRadius="4" ShadowDepth="1" Direction="270"/>
                    </TextBlock.Effect>
                </TextBlock>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
