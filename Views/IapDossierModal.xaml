<UserControl x:Class="SmartSchoolIncidentManagementSystem.Views.IapDossierModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#70000000">
        <Border Width="720" MaxHeight="720" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" CornerRadius="12" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect><DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="20" ShadowDepth="4"/></Border.Effect>
            <Grid DataContext="{Binding DossierPlan}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Modal Header -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Individual Action Plan Dossier — " FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="{Binding Id}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                    </StackPanel>
                    <Button Content="✕" Command="{Binding DataContext.CloseDossierCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" FontSize="16" Foreground="{DynamicResource MutedTextBrush}" Cursor="Hand"/>
                </Grid>

                <!-- Student Info Top Bar -->
                <Border Grid.Row="1" Background="{DynamicResource TableHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21" Background="{DynamicResource TableRowAltBrush}" Margin="0,0,12,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="👤" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding StudentName}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding StudentId}" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding GradeSection}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Border Background="{DynamicResource WarningBgBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right" Margin="0,0,0,4">
                                <TextBlock Text="{Binding RiskTier}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                            </Border>
                            <TextBlock Text="{Binding FocusArea}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Tab Control -->
                <TabControl Grid.Row="2" Margin="0,0,0,16" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource CardBackgroundBrush}">
                    <!-- TAB 1: Milestones & Roadmap -->
                    <TabItem Header="🎯 Milestones &amp; Roadmap">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Step-by-step intervention milestones and completion progress:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10"/>

                                <!-- Milestones List -->
                                <ItemsControl ItemsSource="{Binding Milestones}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource TableHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding DueDate, StringFormat='Due: {0}'}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Add Milestone Form -->
                                <Border Background="{DynamicResource TableHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0" Text="{Binding DataContext.NewMilestoneTitle, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}" Margin="0,0,8,0"/>
                                        <DatePicker Grid.Column="1" SelectedDate="{Binding DataContext.NewMilestoneDueDate, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Height="32" Margin="0,0,8,0"/>
                                        <Button Grid.Column="2" Content="+ Add Milestone" Command="{Binding DataContext.AddMilestoneCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Style="{DynamicResource PrimaryButtonStyle}" Height="32" Padding="10,0"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- TAB 2: Counselor Case Notes -->
                    <TabItem Header="📝 Counselor Case Notes">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                            <StackPanel>
                                <!-- Log Note Form -->
                                <Border Background="{DynamicResource TableHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Log Session Note / Behavioral Update:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding DataContext.NewNoteContent, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="50" Margin="0,0,0,8"/>
                                        <Button Content="+ Save Session Note" Command="{Binding DataContext.AddNoteCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Style="{DynamicResource PrimaryButtonStyle}" HorizontalAlignment="Right" Height="30" Padding="12,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Case Notes Timeline -->
                                <ItemsControl ItemsSource="{Binding Notes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding Author}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                                                        <TextBlock Text="{Binding NoteDate}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Content}" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- TAB 3: Attachments & Files -->
                    <TabItem Header="📎 Attachments &amp; Files">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                            <StackPanel>
                                <Button Content="+ Attach Document" Command="{Binding DataContext.AttachDocumentCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Style="{DynamicResource SecondaryButtonStyle}" HorizontalAlignment="Left" Height="32" Padding="12,0" Margin="0,0,0,12"/>

                                <ItemsControl ItemsSource="{Binding Attachments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource TableHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                                <Grid>
                                                    <TextBlock Text="{Binding FileName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding UploadDate}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>

                <!-- Footer Buttons -->
                <Grid Grid.Row="3">
                    <Button Content="🖨️ Export Plan PDF" Command="{Binding DataContext.ExportPlanPdfCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Style="{DynamicResource SecondaryButtonStyle}" HorizontalAlignment="Left" Height="36" Padding="12,0"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Close" Command="{Binding DataContext.CloseDossierCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,8,0" Width="90" Height="36"/>
                        <Button Content="Save &amp; Update Plan" Command="{Binding DataContext.SaveDossierPlanCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Style="{DynamicResource PrimaryButtonStyle}" Padding="16,0" Height="36"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>